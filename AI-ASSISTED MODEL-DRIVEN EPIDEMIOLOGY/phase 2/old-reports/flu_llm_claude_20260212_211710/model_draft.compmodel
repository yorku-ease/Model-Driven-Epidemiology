<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="0.0" type="CONSTANT" description="Transmission rate, the rate at which new infections take place given a contact" unit="per day"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Daily rate of transition from E1 to E2 and from E2 to I1, leading to average incubation period dL = 2/σ days" unit="per day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Daily rate of transition from I1 to I2 and from I2 to R, leading to average infectious period dI = 2/γ days" unit="per day"/>
  <parameters name="π" expression="0.0" type="CONSTANT" description="Proportion of the population who are initially susceptible" unit="dimensionless"/>
  <parameters name="λ0" expression="0.0" type="CONSTANT" description="Initial infection rate" unit="per day"/>
  <parameters name="ψ" expression="0.0" type="CONSTANT" description="Exponential growth rate (EGR) at which compartments E1, E2, I1, and I2 grow initially" unit="per day"/>
  <parameters name="pICU" expression="0.0" type="CONSTANT" description="Probability of ICU/HDU admission given infection" unit="dimensionless"/>
  <parameters name="μICU|E" expression="5.708" type="CONSTANT" description="Mean time from infection to ICU admission" unit="days"/>
  <parameters name="σ²ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission" unit="days squared"/>
  <parameters name="η" expression="0.0" type="CONSTANT" description="Over-dispersion parameter of the Negative Binomial observation model" unit="dimensionless"/>
  <parameters name="δt" expression="0.25" type="CONSTANT" description="Discrete time step length (quarter of a day)" unit="days"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible individuals at force of infection λ(t) = β * I(t)/N"/>
  </compartments>
  <compartments PrimaryName="Exposed First Stage" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Progression through first exposed sub-compartment at rate σ"/>
  </compartments>
  <compartments PrimaryName="Exposed Second Stage" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Progression from exposed to infectious at rate σ"/>
  </compartments>
  <compartments PrimaryName="Infectious First Stage" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.4" description="Progression through first infectious sub-compartment at rate γ"/>
  </compartments>
  <compartments PrimaryName="Infectious Second Stage" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
