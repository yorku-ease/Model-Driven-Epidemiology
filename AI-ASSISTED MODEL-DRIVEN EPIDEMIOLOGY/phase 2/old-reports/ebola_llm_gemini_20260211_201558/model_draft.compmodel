<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="α" expression="0.5" type="CONSTANT" description="disease death rate" unit="weeks⁻¹"/>
  <parameters name="γ" expression="0.5" type="CONSTANT" description="recovery rate" unit="weeks⁻¹"/>
  <parameters name="θ" expression="1" type="CONSTANT" description="safe burial rate" unit="weeks⁻¹"/>
  <parameters name="c_I" expression="variable" type="CONSTANT" description="contact rate with infectious individuals" unit="people weeks⁻¹"/>
  <parameters name="c_D" expression="variable" type="CONSTANT" description="contact rate with infectious dead bodies" unit="people weeks⁻¹"/>
  <parameters name="β" expression="0.75" type="CONSTANT" description="transmission probability" unit="dimensionless"/>
  <parameters name="ω" expression="1" type="CONSTANT" description="rate at which infected individuals becoming infectious" unit="weeks⁻¹"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Transmission from infectious living individuals to susceptible individuals."/>
  </compartments>
  <compartments PrimaryName="Non-symptomatic infected" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.2" description="Progression from non-symptomatic infected to infectious living."/>
  </compartments>
  <compartments PrimaryName="Infectious living" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Recovery of infectious living individuals."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.4" description="Disease-induced mortality of infectious living individuals."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Infectious deceased" population="0"/>
</compartmental:CompartmentalModel>
