<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="0.75" type="CONSTANT" description="Transmission probability." unit="-"/>
  <parameters name="cI" expression="variable" type="CONSTANT" description="Contact rate with infectious individuals." unit="people weeks^-1"/>
  <parameters name="cD" expression="variable" type="CONSTANT" description="Contact rate with infectious dead bodies." unit="people weeks^-1"/>
  <parameters name="ω" expression="1" type="CONSTANT" description="Rate at which infected individuals become symptomatic." unit="weeks^-1"/>
  <parameters name="α" expression="0.5" type="CONSTANT" description="Disease death rate." unit="weeks^-1"/>
  <parameters name="γ" expression="0.5" type="CONSTANT" description="Recovery rate." unit="weeks^-1"/>
  <parameters name="θ" expression="1" type="CONSTANT" description="Safe burial rate." unit="weeks^-1"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection through contact with infectious living or deceased individuals."/>
  </compartments>
  <compartments PrimaryName="Non-symptomatic Infected" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.2" description="Progression to symptomatic infectious state."/>
  </compartments>
  <compartments PrimaryName="Infectious Living" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.4" description="Recovery from the disease."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.3" description="Death from the disease."/>
  </compartments>
  <compartments PrimaryName="Infectious Deceased" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
