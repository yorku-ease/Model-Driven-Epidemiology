<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.1" description="Susceptible children receiving un-monitored vaccination."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Susceptible children receiving monitored vaccination."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRate="0.0" target="//@compartments.3" description="Transmission of infection to susceptible children from infectious individuals."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Maturation of susceptible children into susceptible adults."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRate="0.0" target="//@compartments.3" description="Transmission of infection to un-monitored vaccinated children due to incomplete immunity."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Un-monitored vaccinated children acquiring immunity."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Maturation of un-monitored vaccinated children into un-monitored vaccinated adults."/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Monitored vaccinated children acquiring immunity."/>
  </compartments>
  <compartments PrimaryName="Exposed Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Progression of exposed children to the infectious stage."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Maturation of exposed children into exposed adults."/>
  </compartments>
  <compartments PrimaryName="Infectious Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Recovery of infectious children, leading to immunity."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Maturation of infectious children into infectious adults."/>
  </compartments>
  <compartments PrimaryName="Immune Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Maturation of immune children into immune adults."/>
  </compartments>
  <compartments PrimaryName="Susceptible Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRate="0.0" target="//@compartments.9" description="Transmission of infection to susceptible adults from infectious individuals."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Susceptible adults receiving vaccination."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRate="0.0" target="//@compartments.9" description="Transmission of infection to un-monitored vaccinated adults due to incomplete immunity."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Un-monitored vaccinated adults acquiring immunity."/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Monitored vaccinated adults acquiring immunity."/>
  </compartments>
  <compartments PrimaryName="Exposed Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Progression of exposed adults to the infectious stage."/>
  </compartments>
  <compartments PrimaryName="Infectious Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Recovery of infectious adults, leading to immunity."/>
  </compartments>
  <compartments PrimaryName="Immune Adults" population="0"/>
</compartmental:CompartmentalModel>
