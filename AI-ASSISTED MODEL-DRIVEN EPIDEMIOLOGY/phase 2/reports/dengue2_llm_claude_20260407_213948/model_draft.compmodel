<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Per-exposure protection from vaccination for seronegative vaccinees" expression="0.321" type="CONSTANT" description="Probability of protection per exposure for vaccinees without prior DENV exposure" unit="dimensionless"/>
  <parameters name="Per-exposure protection from vaccination for seropositive vaccinees" expression="0.516" type="CONSTANT" description="Probability of protection per exposure for vaccinees with prior DENV exposure" unit="dimensionless"/>
  <parameters name="Average duration of protection for seronegative vaccinees" expression="426" type="CONSTANT" description="Average duration of vaccine-induced protection for seronegative vaccinees" unit="days"/>
  <parameters name="Average duration of protection for seropositive vaccinees" expression="258" type="CONSTANT" description="Average duration of vaccine-induced protection for seropositive vaccinees" unit="days"/>
  <parameters name="Probability of symptoms conditional on infection (primary)" expression="0.405" type="CONSTANT" description="Probability of symptomatic disease given a primary DENV infection" unit="dimensionless"/>
  <parameters name="Probability of symptoms conditional on infection (secondary)" expression="0.339" type="CONSTANT" description="Probability of symptomatic disease given a secondary DENV infection" unit="dimensionless"/>
  <parameters name="Probability of symptoms conditional on infection (post-secondary)" expression="0.09" type="CONSTANT" description="Probability of symptomatic disease given a post-secondary DENV infection" unit="dimensionless"/>
  <parameters name="Probability of hospitalization conditional on symptoms (primary)" expression="0.074" type="CONSTANT" description="Probability of hospitalization given symptomatic primary infection" unit="dimensionless"/>
  <parameters name="Probability of hospitalization conditional on symptoms (secondary)" expression="0.376" type="CONSTANT" description="Probability of hospitalization given symptomatic secondary infection" unit="dimensionless"/>
  <parameters name="Probability of hospitalization conditional on symptoms (post-secondary)" expression="0.101" type="CONSTANT" description="Probability of hospitalization given symptomatic post-secondary infection" unit="dimensionless"/>
  <parameters name="Probability of death conditional on symptomatic disease" expression="0.0078" type="CONSTANT" description="Proportion of symptomatic dengue cases that result in death" unit="dimensionless"/>
  <parameters name="PE9" expression="0.1-0.9" type="CONSTANT" description="Proportion of nine-year-olds with prior DENV exposure" unit="dimensionless"/>
  <parameters name="Sensitivity of serological screening" expression="0-1" type="CONSTANT" description="Probability that an individual with prior DENV exposure tests seropositive" unit="dimensionless"/>
  <parameters name="Specificity of serological screening" expression="0-1" type="CONSTANT" description="Probability that a DENV-naive individual tests seronegative" unit="dimensionless"/>
  <parameters name="Intervention coverage" expression="10-80" type="CONSTANT" description="Proportion of children undergoing serological screening" unit="percent"/>
  <parameters name="Discount rate" expression="3" type="CONSTANT" description="Annual discount rate applied to costs and DALYs" unit="percent per year"/>
  <parameters name="Cost of vaccination (three doses)" expression="69" type="CONSTANT" description="Cost of fully vaccinating a single person with three doses of CYD-TDV" unit="USD"/>
  <parameters name="Cost of serological screening" expression="10" type="CONSTANT" description="Estimated unit cost of serological screening per person" unit="USD"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Transmission from infectious mosquito to susceptible human during blood-feeding"/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Recovery from infection with life-long immunity to infecting serotype and temporary cross-immunity to other serotypes"/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.0" description="Waning of temporary cross-immunity, becoming susceptible to other DENV serotypes"/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRate="0.0" target="//@compartments.4" description="Transmission from infectious human to susceptible mosquito during blood-feeding"/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
