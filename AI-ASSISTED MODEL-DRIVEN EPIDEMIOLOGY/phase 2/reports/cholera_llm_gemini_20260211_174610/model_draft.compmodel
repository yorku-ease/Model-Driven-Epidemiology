<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="10^-5 to 1" type="CONSTANT" description="Rate of 'contact' with reservoir water, representing the maximum infection rate." unit="days-1"/>
  <parameters name="γ" expression="1/14 to 1/2.9" type="CONSTANT" description="Per capita recovery rate, the reciprocal of the duration of cholera infection." unit="days-1"/>
  <parameters name="δ" expression="1/41 to 1/3" type="CONSTANT" description="Decay rate of cholera in the water reservoir, the reciprocal of the cholera life span in water." unit="days-1"/>
  <parameters name="ξ" expression="0.01 to 10" type="CONSTANT" description="Rate of water contamination by infectious humans shedding V. cholerae." unit="cells * mL-1 * person-1 * day-1"/>
  <parameters name="κ" expression="10^5 to 10^6" type="CONSTANT" description="Concentration of cholera that yields a 50% chance of infection (half-saturation constant)." unit="cells/mL"/>
  <compartments PrimaryName="S" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Susceptible people are exposed to contaminated water and become infected."/>
  </compartments>
  <compartments PrimaryName="I" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Infectious people recover and become immune."/>
  </compartments>
  <compartments PrimaryName="R" population="0"/>
  <compartments PrimaryName="B" population="0"/>
</compartmental:CompartmentalModel>
