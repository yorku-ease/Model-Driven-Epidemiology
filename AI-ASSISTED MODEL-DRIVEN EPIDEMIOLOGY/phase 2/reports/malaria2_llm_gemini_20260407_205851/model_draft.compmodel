<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="L" expression="0.0" type="CONSTANT" description="Force of infection in the human population." unit="per time"/>
  <parameters name="w" expression="0.0" type="CONSTANT" description="Probability of developing clinical disease upon infection, dependent on the individual's level of anti-disease immunity." unit="dimensionless"/>
  <parameters name="fT" expression="0.0" type="CONSTANT" description="Fixed probability of being treated successfully for clinical disease." unit="dimensionless"/>
  <parameters name="rT" expression="0.0" type="CONSTANT" description="Rate at which successfully treated individuals clear infection and enter a period of prophylactic protection." unit="per time"/>
  <parameters name="rP" expression="0.0" type="CONSTANT" description="Rate at which individuals under prophylaxis return to being susceptible to new infection." unit="per time"/>
  <parameters name="rD" expression="0.0" type="CONSTANT" description="Rate at which individuals with untreated clinical disease clear disease and become patently asymptomatic." unit="per time"/>
  <parameters name="rA" expression="0.0" type="CONSTANT" description="Rate at which individuals with patent asymptomatic infection move to a sub-patent stage, dependent on anti-parasite immunity." unit="per time"/>
  <parameters name="rU" expression="0.0" type="CONSTANT" description="Rate at which sub-patent infection is cleared and individuals return to being fully susceptible." unit="per time"/>
  <parameters name="HBI" expression="0.0" type="CONSTANT" description="Human Blood Index, the proportion of mosquito blood meals taken from humans, which determines infectivity." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible humans by an infectious mosquito, leading to clinical disease with a probability (w) dependent on anti-disease immunity."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Infection of susceptible humans by an infectious mosquito, leading to asymptomatic patent infection with a probability (1-w) dependent on anti-disease immunity."/>
  </compartments>
  <compartments PrimaryName="Untreated Clinical Disease Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Successful treatment of clinical disease with a fixed probability (fT)."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Natural recovery from untreated clinical disease to become patently asymptomatic at rate rD."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Superinfection of an individual with untreated clinical disease, leading to a new clinical disease episode."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Patent Infection Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.5" description="Progression from patent to sub-patent asymptomatic infection at a rate (rA) that depends on anti-parasite immunity."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Superinfection of an individual with asymptomatic patent infection, leading to a new clinical disease episode."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Superinfection of an individual with asymptomatic patent infection, leading to a new asymptomatic patent infection."/>
  </compartments>
  <compartments PrimaryName="Treated Clinical Disease Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Clearing of infection following treatment, entering a period of prophylactic protection at rate rT."/>
  </compartments>
  <compartments PrimaryName="Prophylaxis Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Loss of prophylactic protection and return to susceptibility at rate rP."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Sub-patent Infection Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Clearing of sub-patent infection and return to full susceptibility at rate rU."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Superinfection of an individual with asymptomatic sub-patent infection, leading to a new clinical disease episode."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Superinfection of an individual with asymptomatic sub-patent infection, leading to a new asymptomatic patent infection."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.7" contactRateParameter="//@parameters.0" target="//@compartments.7" description="Infection of a susceptible mosquito from biting an infectious human (from states T, D, A, or U)."/>
  </compartments>
  <compartments PrimaryName="Latent Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.8" description="Progression of a mosquito from the latent to the infectious state after an extrinsic incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
