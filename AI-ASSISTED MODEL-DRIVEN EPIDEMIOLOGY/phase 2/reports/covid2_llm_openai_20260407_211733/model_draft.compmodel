<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="c" expression="daily contact rate" type="CONSTANT" description="Average number of daily contacts used in transmission." unit="contacts per person per day"/>
  <parameters name="r" expression="inverse of average infectious period" type="CONSTANT" description="Rate of recovery/removal from the infectious state." unit="per day"/>
  <parameters name="epsilon" expression="inverse of average incubation period" type="CONSTANT" description="Rate of progression from exposed to infectious." unit="per day"/>
  <parameters name="R0" expression="2.2" type="CONSTANT" description="Basic reproduction number used to calculate the daily contact rate." unit="dimensionless"/>
  <parameters name="average infectious period" expression="5.8" type="CONSTANT" description="Average time spent infectious, used to derive r." unit="days"/>
  <parameters name="average time spent exposed but not infectious" expression="5.2" type="CONSTANT" description="Average incubation period, used to derive epsilon." unit="days"/>
  <parameters name="time from onset to first medical visit and isolation" expression="5.8" type="CONSTANT" description="Used as a proxy for average infectious period under improved case identification and isolation." unit="days"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection/transmission from infectious individuals to susceptible individuals within a city, proportional to contact rate and the fraction infectious."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression from exposed to infectious at rate epsilon."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Recovery or removal from the infectious state at rate r, representing self-isolation/effective removal and recovery."/>
  </compartments>
  <compartments PrimaryName="Recovered/Removed" population="0"/>
</compartmental:CompartmentalModel>
