<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="βb" expression="0.05 - 0.12 (general); 0.071 (Rio); 0.09 (town)" type="CONSTANT" description="Number of infectious bites delivered per vector per day." unit="per day"/>
  <parameters name="α_H" expression="1/(2-4) (general); 1/3 (simulation)" type="CONSTANT" description="Inverse of the incubation time in humans." unit="per day"/>
  <parameters name="γ" expression="1/(5-7) (general); 1/7 (simulation)" type="CONSTANT" description="Recovery rate of humans." unit="per day"/>
  <parameters name="λ" expression="0.00005" type="CONSTANT" description="Human population growth rate." unit="per day"/>
  <parameters name="K_H" expression="30,000,000 (Rio); 120,000 (town)" type="CONSTANT" description="Carrying capacity for the human population." unit="people"/>
  <parameters name="M" expression="100,000 (Rio); 80,000 (town)" type="CONSTANT" description="Number of alternative hosts for mosquito bites." unit="hosts"/>
  <parameters name="e" expression="80" type="CONSTANT" description="Number of eggs laid per female mosquito per unit time." unit="per day"/>
  <parameters name="τ1" expression="1/3" type="CONSTANT" description="Reciprocal of the egg development time (hatching rate)." unit="per day"/>
  <parameters name="μ1" expression="0.05" type="CONSTANT" description="Mortality rate of mosquito eggs." unit="per day"/>
  <parameters name="τ2" expression="1/9" type="CONSTANT" description="Reciprocal of the larval development time (maturation rate)." unit="per day"/>
  <parameters name="μ2" expression="0.025" type="CONSTANT" description="Natural mortality rate of mosquito larvae." unit="per day"/>
  <parameters name="τ3" expression="1/3" type="CONSTANT" description="Reciprocal of the pupal development time (emergence rate)." unit="per day"/>
  <parameters name="μ3" expression="0.0025" type="CONSTANT" description="Mortality rate of mosquito pupae." unit="per day"/>
  <parameters name="K_V" expression="100,000,000 (Rio); 5,000,000 (town)" type="CONSTANT" description="Carrying capacity for mosquito larvae." unit="larvae"/>
  <parameters name="κ" expression="1" type="CONSTANT" description="Mortality rate of larvae caused by limited carrying capacity." unit="per day"/>
  <parameters name="q" expression="0.68" type="CONSTANT" description="Percentage of females among adult vectors." unit="dimensionless"/>
  <parameters name="α_V" expression="1/(8-12) (general); 1/10 (simulation)" type="CONSTANT" description="Inverse of the incubation time in vectors." unit="per day"/>
  <parameters name="μ_V" expression="0.05" type="CONSTANT" description="Mortality rate of adult vectors." unit="per day"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.5" target="//@compartments.1" description="Transmission of Zika virus from infectious mosquitoes to susceptible humans through bites."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.2" description="Progression of exposed humans to the infectious stage after the incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.3" description="Recovery of infectious humans."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Vector Eggs" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.5" description="Hatching of mosquito eggs into larvae."/>
  </compartments>
  <compartments PrimaryName="Vector Larvae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.6" description="Maturation of mosquito larvae into pupae."/>
  </compartments>
  <compartments PrimaryName="Vector Pupae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.7" description="Emergence of adult female mosquitoes from the pupal stage."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.5" target="//@compartments.8" description="Transmission of Zika virus from infectious humans to susceptible mosquitoes through bites."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.9" description="Progression of exposed mosquitoes to the infectious stage after the incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
