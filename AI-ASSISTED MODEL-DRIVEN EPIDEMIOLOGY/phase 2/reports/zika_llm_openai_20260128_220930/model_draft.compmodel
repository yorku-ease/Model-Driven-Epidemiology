<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Reference" expression="1." type="CONSTANT"/>
  <parameters name="β" expression="0.05 - 0.12" type="CONSTANT" description="Number of infectious bites delivered per vector per day" unit="bites per vector per day"/>
  <parameters name="βb" expression="8 - 12" type="CONSTANT" description="Incubation time in vector" unit="days"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.1" description="Progression from susceptible to exposed in humans"/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Progression from exposed to infectious in humans"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Recovery of infectious humans"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.1" target="//@compartments.2" description="Infectious mosquitoes transmitting the virus to humans"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
