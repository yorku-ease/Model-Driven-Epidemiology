<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="N" expression="53679750 (2012/13), 54091200 (2013/14), 54551450 (2014/15)" type="CONSTANT" description="Total population size for each season analyzed." unit="people"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="The constant transmission rate. The model is re-parametrized in terms of other parameters (psi, lambda_0, pi) and beta is not directly inferred." unit="1/day"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of becoming infectious (transition rate through E1 and E2). Assumed known. Corresponds to a mean incubation period d_L = 2/sigma days." unit="1/day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery (transition rate through I1 and I2). Assumed known. Corresponds to a mean infectious period d_I = 2/gamma days." unit="1/day"/>
  <parameters name="π" expression="0.0" type="CONSTANT" description="The proportion of the population who is initially susceptible. Inferred parameter." unit="dimensionless"/>
  <parameters name="λ_0" expression="0.0" type="CONSTANT" description="The initial infection rate. Inferred parameter." unit="1/day"/>
  <parameters name="ψ" expression="0.0" type="CONSTANT" description="The exponential growth rate (EGR) at the start of the epidemic. Inferred parameter." unit="1/day"/>
  <parameters name="p_ICU" expression="0.0" type="CONSTANT" description="Probability of ICU admission given infection. Inferred parameter." unit="dimensionless"/>
  <parameters name="η" expression="0.0" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial observational model. Inferred parameter." unit="dimensionless"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission. Assumed known from previous studies." unit="days^2"/>
  <parameters name="R_0" expression="0.0" type="CONSTANT" description="Basic reproduction number, the average number of successful transmissions per infectious person in a fully susceptible population. A derived quantity." unit="dimensionless"/>
  <parameters name="R_n" expression="0.0" type="CONSTANT" description="Effective reproduction number, the average number of successful transmissions per infectious person in a partially susceptible population. A derived quantity." unit="dimensionless"/>
  <compartments PrimaryName="S" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible individuals. The force of infection is lambda(t) = beta * (I1(t) + I2(t)) / N."/>
  </compartments>
  <compartments PrimaryName="E1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression of exposed individuals from the first to the second stage at rate sigma."/>
  </compartments>
  <compartments PrimaryName="E2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Transition of exposed individuals to the infectious state at rate sigma."/>
  </compartments>
  <compartments PrimaryName="I1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Progression of infectious individuals from the first to the second stage at rate gamma."/>
  </compartments>
  <compartments PrimaryName="I2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Removal of infectious individuals to the removed compartment at rate gamma."/>
  </compartments>
  <compartments PrimaryName="R" population="0"/>
</compartmental:CompartmentalModel>
