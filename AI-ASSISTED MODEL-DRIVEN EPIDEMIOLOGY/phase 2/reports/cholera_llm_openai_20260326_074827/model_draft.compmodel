<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="beta" expression="10^-5 to 1" type="CONSTANT" description="Rate of contact with reservoir water." unit="days^-1"/>
  <parameters name="gamma" expression="1/2.9 to 1/14" type="CONSTANT" description="Per capita recovery rate; reciprocal of duration of cholera infection." unit="days^-1"/>
  <parameters name="delta" expression="1/3 to 1/41" type="CONSTANT" description="Cholera life span in the water reservoir; bacterial removal/decay rate." unit="days^-1"/>
  <parameters name="xi" expression="0.01 to 10" type="CONSTANT" description="Rate of water contamination by infectious people shedding Vibrio cholerae into the water reservoir." unit="cells mL^-1 person^-1 day^-1"/>
  <parameters name="kappa" expression="10^5 to 10^6" type="CONSTANT" description="Concentration of Vibrio cholerae that yields 50% chance of infection." unit="cells/mL"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Susceptible people become infected through exposure to contaminated water."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Infectious people recover and become immune."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Infectious people contaminate the water supply by shedding bacteria."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Bacteria in Water Reservoir" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.3" description="Bacteria decay/removal in the water reservoir."/>
  </compartments>
</compartmental:CompartmentalModel>
