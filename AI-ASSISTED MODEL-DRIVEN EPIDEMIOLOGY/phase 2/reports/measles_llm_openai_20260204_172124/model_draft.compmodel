<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="range" expression="10e14" type="CONSTANT"/>
  <parameters name="β_C" expression="0.00188" type="CONSTANT" description="Transmission rate in children"/>
  <parameters name="β_A" expression="1.00e-5" type="CONSTANT" description="Transmission rate in adults"/>
  <parameters name="γ" expression="0.5" type="CONSTANT" description="Recovery rate from the disease" unit="per week"/>
  <parameters name="δ" expression="0.7" type="CONSTANT" description="Incubation rate for measles" unit="per week"/>
  <parameters name="μ" expression="1/(72*52)" type="CONSTANT" description="Natural death rate" unit="per week"/>
  <parameters name="ε" expression="0.2" type="CONSTANT" description="Vaccine effectiveness"/>
  <parameters name="x_U" expression="0.0087" type="CONSTANT" description="Un-monitored vaccination rate"/>
  <parameters name="x_M" expression="4.777e-6" type="CONSTANT" description="Monitored vaccination rate"/>
  <parameters name="h_U" expression="3e-6" type="CONSTANT" description="Rate of being immune from un-monitored vaccination"/>
  <parameters name="h_M" expression="0.0167" type="CONSTANT" description="Rate of being immune from monitored vaccination"/>
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.4" target="//@compartments.3" description="Susceptible children become exposed due to contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.4" target="//@compartments.3" description="Un-monitored vaccinated children become exposed due to contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0"/>
  <compartments PrimaryName="Exposed Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Exposed children progress to become infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.5" description="Infectious children recover and become immune."/>
  </compartments>
  <compartments PrimaryName="Immune Children" population="0"/>
  <compartments PrimaryName="Susceptible Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.4" target="//@compartments.9" description="Susceptible adults become exposed due to contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.4" target="//@compartments.9" description="Un-monitored vaccinated adults become exposed due to contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Vaccinated Adults" population="0"/>
  <compartments PrimaryName="Exposed Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.10" description="Exposed adults progress to become infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.11" description="Infectious adults recover and become immune."/>
  </compartments>
  <compartments PrimaryName="Immune Adults" population="0"/>
</compartmental:CompartmentalModel>
