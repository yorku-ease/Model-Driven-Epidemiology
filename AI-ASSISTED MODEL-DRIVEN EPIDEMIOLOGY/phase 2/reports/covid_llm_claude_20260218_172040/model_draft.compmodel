<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="R0" expression="2.3" type="CONSTANT" description="Basic reproduction number: average number of secondary infections from a primary infection in a susceptible population" unit="dimensionless"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Infection of susceptible individuals through contact with infectious individuals"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRate="0.0" target="//@compartments.2" description="Infection of susceptible individuals who are then quarantined via contact tracing"/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.3" description="Progression from latent period to presymptomatic infectious stage"/>
  </compartments>
  <compartments PrimaryName="Exposed Quarantined" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Progression from quarantined exposed to presymptomatic infectious isolated stage"/>
  </compartments>
  <compartments PrimaryName="Infectious Presymptomatic" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Progression to mild/moderate symptomatic infection"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Progression to severe symptomatic infection"/>
  </compartments>
  <compartments PrimaryName="Infectious Presymptomatic Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Progression to mild/moderate symptoms while isolated"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Progression to severe symptoms while isolated"/>
  </compartments>
  <compartments PrimaryName="Infectious Mild to Moderate" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Testing and isolation of mild/moderate cases"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of mild/moderate cases"/>
  </compartments>
  <compartments PrimaryName="Infectious Mild to Moderate Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of isolated mild/moderate cases"/>
  </compartments>
  <compartments PrimaryName="Infectious Severe" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Testing and isolation of severe cases"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospital admission for severe non-ICU cases"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospital admission for severe cases requiring ICU"/>
  </compartments>
  <compartments PrimaryName="Infectious Severe Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospital admission for isolated severe non-ICU cases"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospital admission for isolated severe cases requiring ICU"/>
  </compartments>
  <compartments PrimaryName="Admitted to Hospital" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery after hospital stay (non-ICU)"/>
  </compartments>
  <compartments PrimaryName="Admitted to Hospital Pre-ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Transfer from hospital to ICU"/>
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Transfer from ICU to post-ICU hospital care"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.14" description="Death in ICU"/>
  </compartments>
  <compartments PrimaryName="Admitted to Hospital Post-ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery after post-ICU hospital stay"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
</compartmental:CompartmentalModel>
