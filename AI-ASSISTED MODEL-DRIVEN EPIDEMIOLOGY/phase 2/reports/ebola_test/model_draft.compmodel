<?xml version="1.0" ?>
<seir:SEIRModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:seir="http://example.com/seirmodel" xmi:version="2.0">
  <parameters>
    <parameters name="µ" expression="0" type="CONSTANT"/>
    <parameters name="γ" expression="0" type="CONSTANT"/>
    <parameters name="β" expression="." type="CONSTANT"/>
    <parameters name="α" expression="0" type="CONSTANT"/>
    <parameters name="ωα" expression="0." type="CONSTANT"/>
    <parameters name="n" expression="0" type="CONSTANT"/>
    <parameters name="whenR0" expression="1" type="CONSTANT"/>
    <parameters name="ThehorizontallineindicatedthethresholdR0" expression="1." type="CONSTANT"/>
    <parameters name="lieunderneathR0" expression="1." type="CONSTANT"/>
    <parameters name="valueslieunderneaththethresholdR" expression="1" type="CONSTANT"/>
    <parameters name="valuesarenowfoundbelowthethresholdR" expression="1." type="CONSTANT"/>
    <parameters name="underneathR0" expression="1." type="CONSTANT"/>
    <parameters name="ofthevalueslieunderneathR0" expression="1." type="CONSTANT"/>
  </parameters>
  <compartments>
    <compartments PrimaryName="Susceptible" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Susceptible individuals become infected through contact with infected individuals or corpses."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Non-symptomatic Infected" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.0"/>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.2" description="Non-symptomatic infected individuals become infectious and symptomatic."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Infectious" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.4" description="Infectious individuals recover from the disease."/>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.3" description="Infectious individuals may die from the disease and become infectious deceased."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Infectious Deceased" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:ContactFlow" contactCompartment="//@compartments.0" contactRate="0.0" target="//@compartments.0" description="Infectious deceased bodies can infect susceptible individuals."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Recovered" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.3" description="Recovered individuals can die at the background death rate."/>
      </outgoingFlows>
    </compartments>
  </compartments>
  <groups>
    <groups name="age">
      <values/>
    </groups>
    <groups name="gender">
      <values/>
    </groups>
  </groups>
</seir:SEIRModel>
