<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="0.2" type="CONSTANT"/>
  <parameters name="w" expression="3" type="CONSTANT"/>
  <parameters name="eid" expression="2" type="CONSTANT"/>
  <parameters name="δt" expression="0.25" type="CONSTANT" description="The length of discrete time intervals in the SEIR model." unit="day"/>
  <parameters name="dL" expression="2" type="CONSTANT" description="The average incubation period." unit="days"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="The daily rate of transition from infectious to removed compartments." unit="day^-1"/>
  <parameters name="dI" expression="3.45" type="CONSTANT" description="The average infectious period." unit="days"/>
  <parameters name="λ(t)" expression="0.0" type="CONSTANT" description="The time-varying rate at which a person becomes infected."/>
  <parameters name="β" expression="0 to 1.25" type="CONSTANT" description="The constant transmission rate, representing the rate at which new infections occur given a contact."/>
  <parameters name="ψ" expression="Unif(0,0.39)" type="CONSTANT" description="The Exponential Growth Rate (EGR) at the start of the epidemic."/>
  <parameters name="π" expression="Unif(0,1)" type="CONSTANT" description="The proportion of the population who is initially susceptible."/>
  <parameters name="λ0" expression="Unif(0,0.000241)" type="CONSTANT" description="The initial infection rate at time t=0."/>
  <parameters name="R0" expression="1 to 4" type="CONSTANT" description="The basic reproduction number, the average number of successful transmissions per infectious person in a fully susceptible population."/>
  <parameters name="Rn" expression="0.0" type="CONSTANT" description="The effective reproduction number, the average number of successful transmissions per infectious person in a partially susceptible population."/>
  <parameters name="p_ICU" expression="Unif(0,1)" type="CONSTANT" description="The proportion of infected people who are admitted to ICU/HDU."/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="The variance of the Gamma-distributed waiting period from infection to ICU admission." unit="days^2"/>
  <parameters name="η" expression="Unif(1,100)" type="CONSTANT" description="The dispersion parameter for the Negative Binomial distribution of weekly ICU/HDU admissions."/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.0" target="//@compartments.4" description="Susceptible individuals become infected and move to the first exposed compartment."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.2"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.3"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Individuals progress from the first to the second exposed sub-compartment."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Exposed individuals become infectious and enter the first infectious sub-compartment."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.2" description="Individuals progress from the first to the second infectious sub-compartment."/>
  </compartments>
</compartmental:CompartmentalModel>
