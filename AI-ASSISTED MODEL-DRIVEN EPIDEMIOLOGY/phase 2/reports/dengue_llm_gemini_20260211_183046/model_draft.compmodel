<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="250" type="CONSTANT" description="The constant influx rate of the human hosts."/>
  <parameters name="μ_h" expression="0.005" type="CONSTANT" description="The natural death rate of the human hosts."/>
  <parameters name="μ_v" expression="0.65" type="CONSTANT" description="The natural death rate of the mosquitoes."/>
  <parameters name="γ_1(a)" expression="0.5" type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts."/>
  <parameters name="γ_2(a)" expression="0.5" type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts."/>
  <parameters name="β_v(a)" expression="18" type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes."/>
  <parameters name="β_h(a)" expression="8" type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts."/>
  <parameters name="ρ" expression="0.5" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts."/>
  <parameters name="σ" expression="0.007" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts."/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible humans become exposed through bites by infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.7" target="//@compartments.2" description="A fraction ρ of exposed individuals progress to the symptomatic infectious class at an age-dependent rate k(a)."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.7" target="//@compartments.3" description="A fraction 1-ρ of exposed individuals progress to the asymptomatic infectious class at an age-dependent rate k(a)."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.4" description="Symptomatic infectious individuals recover at an age-specific rate γ_1(a)."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Asymptomatic individuals are reinfected through mosquito bites and become symptomatic infectious."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Asymptomatic infectious individuals recover at an age-specific rate γ_2(a)."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Susceptible mosquitoes become infected through biting asymptomatic or symptomatically infectious human hosts."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
