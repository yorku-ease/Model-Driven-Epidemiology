<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Birth rate" expression="0.029" type="CONSTANT" description="Per-capita birth rate." unit="/yr"/>
  <parameters name="Background mortality rate" expression="0.018" type="CONSTANT" description="Background mortality rate." unit="/yr"/>
  <parameters name="Transmission parameter" expression="0.767" type="CONSTANT" description="Initial value of the transmission parameter." unit="/yr"/>
  <parameters name="Transmission parameter location" expression="0.055" type="CONSTANT" description="Location parameter for transmission parameter distribution." unit="dimensionless"/>
  <parameters name="Transmission parameter shape" expression="0.996" type="CONSTANT" description="Shape parameter for transmission parameter distribution." unit="dimensionless"/>
  <parameters name="Relative transmission on ART" expression="0.010" type="CONSTANT" description="Transmission relative to untreated infection while on ART." unit="dimensionless"/>
  <parameters name="Progression untreated" expression="0.303" type="CONSTANT" description="Disease progression rate for untreated infected individuals." unit="/yr"/>
  <parameters name="Progression treated" expression="0.165" type="CONSTANT" description="Disease progression rate for treated infected individuals." unit="/yr"/>
  <parameters name="Intervention timing" expression="2011" type="CONSTANT" description="Year when intervention rollout begins." unit="yr"/>
  <parameters name="Intervention rate" expression="1.00" type="CONSTANT" description="Rate of intervention rollout." unit="/yr"/>
  <parameters name="Intervention maximum" expression="0.90" type="CONSTANT" description="Maximum coverage of intervention." unit="dimensionless"/>
  <parameters name="Testing rate" expression="1.00" type="CONSTANT" description="Rate of HIV testing." unit="/yr"/>
  <parameters name="Testing refusal" expression="0.08" type="CONSTANT" description="Proportion refusing testing." unit="dimensionless"/>
  <parameters name="Drop-out rate" expression="0.015" type="CONSTANT" description="Rate of dropout from treatment." unit="/yr"/>
  <parameters name="CD4 on/off" expression="Off" type="CONSTANT" description="Whether CD4-based treatment initiation is enabled." unit="indicator"/>
  <parameters name="Failure rate" expression="0.10" type="CONSTANT" description="Treatment failure rate." unit="/yr"/>
  <parameters name="Reduction in transmission" expression="0.40" type="CONSTANT" description="Other intervention effect reducing transmission." unit="dimensionless"/>
  <parameters name="Acute phase duration" expression="2" type="CONSTANT" description="Duration of acute phase." unit="months"/>
  <parameters name="Acute phase infectivity" expression="4.50" type="CONSTANT" description="Infectivity during acute phase." unit="number/year"/>
  <parameters name="Chronic phase infectivity" expression="0.45" type="CONSTANT" description="Infectivity during chronic phase." unit="number/year"/>
  <parameters name="Final phase infectivity" expression="2.25" type="CONSTANT" description="Infectivity during final phase." unit="number/year"/>
  <parameters name="Final phase duration" expression="0.15" type="CONSTANT" description="Duration of final phase as a proportion of expected life." unit="proportion of expected life"/>
  <parameters name="Concurrency number" expression="4" type="CONSTANT" description="Number of concurrent partnerships." unit="number"/>
  <parameters name="Partnership duration" expression="6" type="CONSTANT" description="Mean duration of a partnership." unit="months"/>
  <parameters name="Start ART CD4" expression="0" type="CONSTANT" description="CD4 threshold for starting ART in the table as presented." unit="/micro-litre"/>
  <parameters name="Monte Carlo repeats" expression="10000" type="CONSTANT" description="Number of Monte Carlo simulation repeats." unit="number"/>
  <compartments PrimaryName="Susceptible" population="0"/>
  <compartments PrimaryName="Infectious" population="0"/>
  <compartments PrimaryName="Treated" population="0"/>
</compartmental:CompartmentalModel>
