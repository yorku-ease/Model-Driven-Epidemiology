<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Latent period" expression="2.5" type="CONSTANT" description="Time from exposure to onset of infectiousness." unit="days"/>
  <parameters name="Presymptomatic infectious period" expression="1" type="CONSTANT" description="Duration of infectiousness before symptom onset." unit="days"/>
  <parameters name="Infectious period (mild to moderate)" expression="6" type="CONSTANT" description="Symptomatic infectious period for mild-to-moderate cases." unit="days"/>
  <parameters name="Infectious period (severe)" expression="6" type="CONSTANT" description="Symptomatic infectious period for severe cases." unit="days"/>
  <parameters name="Basic reproduction number" expression="2.3" type="CONSTANT" description="Average number of secondary infections from a primary infection."/>
  <parameters name="Time in quarantine" expression="14" type="CONSTANT" description="Duration of quarantine for exposed cases." unit="days"/>
  <parameters name="Relative risk of transmission for cases in isolation" expression="0.1" type="CONSTANT" description="Reduced transmission for isolated cases."/>
  <parameters name="Average length of stay in hospital for cases not requiring ICU care" expression="10" type="CONSTANT" description="Duration of hospital stay for non-ICU cases." unit="days"/>
  <parameters name="Average length of stay in hospital before ICU admission" expression="3" type="CONSTANT" description="Duration of hospital stay before ICU admission." unit="days"/>
  <parameters name="Average length of stay in ICU" expression="21" type="CONSTANT" description="Duration of ICU stay." unit="days"/>
  <parameters name="Average length of stay in hospital after ICU" expression="21" type="CONSTANT" description="Duration of hospital stay after ICU." unit="days"/>
  <parameters name="Probability of severe infection" expression="Varies by age and comorbidity" type="CONSTANT" description="Probability of severe infection requiring hospital admission."/>
  <parameters name="Probability severe case requires admission to ICU" expression="0.26" type="CONSTANT" description="Probability that a severe case requires ICU admission."/>
  <parameters name="Probability of death in cases admitted to ICU" expression="Varies by age and comorbidity" type="CONSTANT" description="Probability of death for ICU cases."/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Susceptible individuals become exposed through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.3" description="Exposed individuals become presymptomatic infectious."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Exposed individuals are quarantined."/>
  </compartments>
  <compartments PrimaryName="Exposed (quarantined)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.4" description="Quarantined exposed individuals become presymptomatic infectious and isolated."/>
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.5" description="Presymptomatic infectious individuals develop mild to moderate symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.6" description="Isolated presymptomatic infectious individuals develop mild to moderate symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.7" description="Mild to moderate infectious individuals develop severe symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.8" description="Isolated mild to moderate infectious individuals develop severe symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (severe)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.9" description="Severe infectious individuals are admitted to hospital."/>
  </compartments>
  <compartments PrimaryName="Infectious (severe, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.9" description="Isolated severe infectious individuals are admitted to hospital."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital (pre-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospitalized individuals are moved to ICU."/>
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="ICU patients are moved to regular hospital care after ICU."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.13" description="ICU patients die from the infection."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital (post-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Post-ICU individuals recover."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
</compartmental:CompartmentalModel>
