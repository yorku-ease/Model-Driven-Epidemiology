<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="10^-5 to 1" type="CONSTANT" description="Rate of 'contact' with reservoir water, representing the maximum infection rate from less-infectious bacteria." unit="days-1"/>
  <parameters name="γ" expression="1/14 to 1/2.9" type="CONSTANT" description="Per capita recovery rate from cholera infection, reciprocal of the duration of infection (2.9 to 14 days)." unit="days-1"/>
  <parameters name="δ" expression="1/41 to 1/3" type="CONSTANT" description="Removal rate of cholera bacteria from the water reservoir, reciprocal of the cholera life span in water (3 to 41 days)." unit="days-1"/>
  <parameters name="ξ" expression="0.01 to 10" type="CONSTANT" description="Rate of water contamination by an infectious person." unit="cells * mL-1 * person-1 * day-1"/>
  <parameters name="κ" expression="10^5 to 10^6" type="CONSTANT" description="Concentration of cholera that yields a 50% chance of infection (half-saturation constant)." unit="cells/mL"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible individuals who become asymptomatic carriers, through exposure to contaminated water."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Infection of susceptible individuals who develop symptomatic cholera, through exposure to contaminated water."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Successful vaccination of susceptible individuals, conferring immunity."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Recovery of asymptomatic individuals, who then become immune."/>
  </compartments>
  <compartments PrimaryName="Symptomatic" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Recovery of symptomatic individuals, who then become immune."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning of immunity acquired from natural infection, returning individuals to the susceptible population."/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.0" description="Waning of vaccine-induced immunity, returning individuals to the susceptible population."/>
  </compartments>
  <compartments PrimaryName="Hyperinfectious Bacteria" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Transition of bacteria from the hyperinfectious state to the less infectious state."/>
  </compartments>
  <compartments PrimaryName="Less Infectious Bacteria" population="0"/>
</compartmental:CompartmentalModel>
