<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Reference" expression="1." type="CONSTANT"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="Transmission rate from mosquito bites"/>
  <parameters name="α_H" expression="0.0" type="CONSTANT" description="Inverse incubation time of ZIKV for human"/>
  <parameters name="γ" expression="0.0" type="CONSTANT" description="Recovery rate of an infectious individual"/>
  <parameters name="λ" expression="0.0" type="CONSTANT" description="Human population growth rate"/>
  <parameters name="μ_V" expression="0.0" type="CONSTANT" description="Mortality rate of adult vectors"/>
  <parameters name="τ_i" expression="0.0" type="CONSTANT" description="Reciprocal of the development time of vectors in stage i"/>
  <parameters name="μ_i" expression="0.0" type="CONSTANT" description="Mortality rate of vectors in stage i"/>
  <parameters name="κ" expression="0.0" type="CONSTANT" description="Mortality rate of larvae caused by limited carrying capacity"/>
  <parameters name="e_V" expression="80" type="CONSTANT" description="Number of eggs laid per female mosquito per unit time" unit="per day"/>
  <parameters name="1/γ" expression="3" type="CONSTANT" description="Egg development time" unit="days"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Susceptible humans become exposed due to bites from infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Exposed humans progress to the infectious stage."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.3" description="Infectious humans recover from the infection."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRateParameter="//@parameters.1" target="//@compartments.5" description="Susceptible mosquitoes become exposed after biting infectious humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.6" description="Exposed mosquitoes progress to the infectious stage."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
