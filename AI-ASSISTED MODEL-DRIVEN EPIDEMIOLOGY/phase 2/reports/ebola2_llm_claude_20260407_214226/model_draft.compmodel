<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="0.532" type="CONSTANT" description="Transmission rate in the community before intervention" unit="per week"/>
  <parameters name="θ" expression="0.328" type="CONSTANT" description="Transmission rate in hospitals before intervention" unit="per week"/>
  <parameters name="φ" expression="2.104" type="CONSTANT" description="Transmission rate at funerals before intervention" unit="per week"/>
  <parameters name="1/η" expression="4.8" type="CONSTANT" description="Mean time from symptoms onset to hospitalization" unit="days"/>
  <parameters name="1/b" expression="5.4" type="CONSTANT" description="Mean time from death to burial" unit="days"/>
  <parameters name="1/γ" expression="10.4" type="CONSTANT" description="Mean duration of the infection" unit="days"/>
  <parameters name="1/α" expression="10" type="CONSTANT" description="Mean duration of the incubation period" unit="days"/>
  <parameters name="1/γH" expression="4.6" type="CONSTANT" description="Average permanence in the hospital" unit="days"/>
  <parameters name="δ" expression="0.73" type="CONSTANT" description="Case fatality ratio in the community" unit="dimensionless"/>
  <parameters name="δH" expression="0.61" type="CONSTANT" description="Case fatality ratio in hospitals" unit="dimensionless"/>
  <parameters name="κ" expression="0.0025" type="CONSTANT" description="Hospital leaving rate" unit="per week"/>
  <parameters name="β̃" expression="0.505" type="CONSTANT" description="Transmission rate in the community after intervention" unit="per week"/>
  <parameters name="θ̃" expression="0.095" type="CONSTANT" description="Transmission rate in hospitals after intervention" unit="per week"/>
  <parameters name="φ̃" expression="1.115" type="CONSTANT" description="Transmission rate at funerals after intervention" unit="per week"/>
  <parameters name="1/η̃" expression="4.1" type="CONSTANT" description="Mean time from symptoms onset to hospitalization after intervention" unit="days"/>
  <parameters name="1/b̃" expression="4.9" type="CONSTANT" description="Mean time from death to burial after intervention" unit="days"/>
  <parameters name="R0" expression="1.44" type="CONSTANT" description="Basic reproduction number" unit="dimensionless"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection due to contact with infective patients in the community (rate β), hospitalized patients (rate θ), or dead patients at funerals (rate φ)"/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression from latent phase to infectious state after incubation period (rate α)"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Hospitalization of infectious individuals (rate η)"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.5" description="Recovery of infectious individuals in the community (rate (1-δ)γ)"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.4" description="Death of infectious individuals in the community (rate δγ)"/>
  </compartments>
  <compartments PrimaryName="Hospitalized" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.5" description="Recovery of hospitalized patients (rate (1-δH)γH)"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.4" description="Death of hospitalized patients (rate δH·γH)"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.10" target="//@compartments.2" description="Patients abandoning healthcare facilities and returning to community (rate κ)"/>
  </compartments>
  <compartments PrimaryName="Dead" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.6" description="Burial of dead patients (rate b)"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Buried" population="0"/>
</compartmental:CompartmentalModel>
