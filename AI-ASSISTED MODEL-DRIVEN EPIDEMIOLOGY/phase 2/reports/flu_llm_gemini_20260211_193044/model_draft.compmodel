<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="π" expression="Inferred, prior Unif(0,1)" type="CONSTANT" description="Susceptibility; the proportion of the population who is initially susceptible." unit="dimensionless"/>
  <parameters name="λ_0" expression="Inferred, prior Unif(0,0.000241)" type="CONSTANT" description="Initial infection rate at time t=0." unit="1/day"/>
  <parameters name="ψ" expression="Inferred, prior Unif(0,0.39)" type="CONSTANT" description="Exponential growth rate of the epidemic at its start." unit="1/day"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of becoming infectious; the daily rate of transition through exposed compartments (E1-&gt;E2 and E2-&gt;I1)." unit="1/day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery; the daily rate of transition through infectious compartments (I1-&gt;I2 and I2-&gt;R)." unit="1/day"/>
  <parameters name="N" expression="53,679,750 (for 2012/13 season)" type="CONSTANT" description="Total population size." unit="persons"/>
  <parameters name="p_ICU" expression="Inferred, prior Unif(0,1)" type="CONSTANT" description="Probability of ICU admission given infection (observational model parameter)." unit="dimensionless"/>
  <parameters name="η" expression="Inferred, prior Unif(1,100)" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial observation model." unit="dimensionless"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission (observational model parameter)." unit="days^2"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.5" target="//@compartments.1" description="Infection of susceptible individuals at a rate λ(t), which is proportional to the number of infectious people I(t) = I1(t) + I2(t) and the transmission rate β."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.2" description="Progression from the first to the second exposed stage at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.3" description="Progression from the exposed state to the first infectious stage at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Progression from the first to the second infectious stage at a daily rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
