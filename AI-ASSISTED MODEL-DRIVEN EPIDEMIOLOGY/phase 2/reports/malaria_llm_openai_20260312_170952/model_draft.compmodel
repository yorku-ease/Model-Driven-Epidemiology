<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Human Population Birth Rate" expression="0.012" type="CONSTANT" description="Rate at which new humans are born." unit="per day"/>
  <parameters name="Vaccination Rate" expression="0.60-0.90" type="CONSTANT" description="Proportion of newborns that are vaccinated."/>
  <parameters name="Human Population Natural Death Rate" expression="0.0002" type="CONSTANT" description="Natural death rate of humans." unit="per day"/>
  <parameters name="Mosquito Population Natural Death Rate" expression="0.1" type="CONSTANT" description="Natural death rate of mosquitoes." unit="per day"/>
  <parameters name="Rate of Vaccine Immunity Loss" expression="0.1-0.2" type="CONSTANT" description="Rate at which vaccinated humans lose immunity." unit="per day"/>
  <parameters name="Rate of Vaccine Efficacy" expression="0.3-0.5" type="CONSTANT" description="Efficacy of the vaccine in preventing infection."/>
  <parameters name="Progression Rate from Exposed to Infectious (Vector)" expression="0.05" type="CONSTANT" description="Rate at which vector-exposed humans become infectious." unit="per day"/>
  <parameters name="Progression Rate from Exposed to Infectious (Non-Vector)" expression="0.05" type="CONSTANT" description="Rate at which non-vector exposed humans become infectious." unit="per day"/>
  <parameters name="Progression Rate from Infected to Treated" expression="0.10" type="CONSTANT" description="Rate at which infectious humans receive treatment." unit="per day"/>
  <parameters name="Progression Rate from Treated to Recovered" expression="0.05" type="CONSTANT" description="Rate at which treated humans recover." unit="per day"/>
  <parameters name="Rate of Immunity Loss" expression="0.01" type="CONSTANT" description="Rate at which recovered humans lose immunity." unit="per day"/>
  <parameters name="Malaria Disease Death Rate" expression="0.002" type="CONSTANT" description="Death rate due to malaria." unit="per day"/>
  <parameters name="Effective Contact Rate of Susceptible Humans with Infected Mosquitoes" expression="0.005-0.02" type="CONSTANT" description="Rate of contact between susceptible humans and infected mosquitoes." unit="per day"/>
  <parameters name="Effective Contact Rate of Vaccinated Humans with Infected Mosquitoes" expression="0.001-0.005" type="CONSTANT" description="Rate of contact between vaccinated humans and infected mosquitoes." unit="per day"/>
  <parameters name="Effective Contact Rate of Susceptible Humans with Infected Humans (Non-Vector)" expression="0.001-0.003" type="CONSTANT" description="Rate of contact between susceptible humans and infected humans through non-vector pathways." unit="per day"/>
  <parameters name="Effective Contact Rate of Vaccinated Humans with Infected Humans (Non-Vector)" expression="0.0005-0.002" type="CONSTANT" description="Rate of contact between vaccinated humans and infected humans through non-vector pathways." unit="per day"/>
  <parameters name="Effective Contact Rate of Susceptible Mosquitoes with Infected Humans" expression="0.01-0.05" type="CONSTANT" description="Rate of contact between susceptible mosquitoes and infected humans." unit="per mosquito"/>
  <parameters name="Mosquito Population Birth Rate" expression="0.02" type="CONSTANT" description="Rate at which new mosquitoes are born." unit="per day"/>
  <parameters name="Mosquitoes Population Progression Rate from Exposed to Infectious" expression="0.10" type="CONSTANT" description="Rate at which exposed mosquitoes become infectious." unit="per day"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Humans become exposed through contact with infectious mosquitoes."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Humans become exposed through non-vector means such as blood transfusions."/>
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Vaccinated humans become exposed through contact with infectious mosquitoes."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Vaccinated humans become exposed through non-vector means."/>
  </compartments>
  <compartments PrimaryName="Vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.4" description="Exposed humans progress to become infectious."/>
  </compartments>
  <compartments PrimaryName="Non-Vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.4" description="Non-vector exposed humans progress to become infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.12" target="//@compartments.5" description="Infectious humans receive treatment."/>
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.6" description="Treated humans recover from malaria."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.0" description="Recovered humans lose immunity and become susceptible again."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.6" target="//@compartments.8" description="Mosquitoes become exposed through contact with infectious humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.9" description="Exposed mosquitoes progress to become infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
