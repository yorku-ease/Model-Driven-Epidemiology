<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of progression from Exposed 1 to Exposed 2." unit="per day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery from Infectious 2." unit="per day"/>
  <parameters name="β" expression="varies" type="CONSTANT" description="Transmission rate per contact." unit="per contact"/>
  <parameters name="μ_ICU|E" expression="5.708" type="CONSTANT" description="Mean time from infection to ICU admission." unit="days"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission." unit="days^2"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Infection of susceptible individuals."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Progression from first to second stage of incubation."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Progression from incubation to first stage of infection."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Progression from first to second stage of infection."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
