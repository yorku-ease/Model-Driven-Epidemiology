<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="C" expression="333" type="CONSTANT" description="Constant recruitment in susceptible classes" unit="Individuals/year"/>
  <parameters name="h" expression="0.48" type="CONSTANT" description="Proportion of men" unit="Nondimensional"/>
  <parameters name="c" expression="0.92" type="CONSTANT" description="Proportion of heterosexual men" unit="Nondimensional"/>
  <parameters name="p" expression="0.90" type="CONSTANT" description="Proportion of initially treated individuals" unit="Nondimensional"/>
  <parameters name="l" expression="0.0129" type="CONSTANT" description="Natural mortality rate" unit="1/year"/>
  <parameters name="d" expression="0.3333" type="CONSTANT" description="AIDS development rate in treated individuals" unit="1/year"/>
  <parameters name="a" expression="0.3333" type="CONSTANT" description="Departure rate from infected compartments" unit="1/year"/>
  <parameters name="b" expression="0.02" type="CONSTANT" description="Probability of sexual transmission for susceptible women" unit="Nondimensional"/>
  <compartments PrimaryName="Susceptible Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection through homosexual contact"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.6" description="Transition to treatment"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.7" description="Progression to AIDS without treatment"/>
  </compartments>
  <compartments PrimaryName="Susceptible Women" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Infection through heterosexual contact with infected men"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Women" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.6" description="Transition to treatment"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.7" description="Progression to AIDS without treatment"/>
  </compartments>
  <compartments PrimaryName="Susceptible Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRateParameter="//@parameters.0" target="//@compartments.5" description="Infection through heterosexual contact with infected women"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.6" description="Transition to treatment"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.7" description="Progression to AIDS without treatment"/>
  </compartments>
  <compartments PrimaryName="Treated with Antiretrovirals" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.7" description="Progression to AIDS despite treatment"/>
  </compartments>
  <compartments PrimaryName="People Living with AIDS" population="0"/>
</compartmental:CompartmentalModel>
