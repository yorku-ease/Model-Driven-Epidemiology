<?xml version="1.0" ?>
<seir:SEIRModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:seir="http://example.com/seirmodel" xmi:version="2.0">
  <parameters>
    <parameters name="β" expression="." type="CONSTANT"/>
    <parameters name="α" expression="0." type="CONSTANT"/>
    <parameters name="n" expression="0" type="CONSTANT"/>
    <parameters name="γ" expression="0.5" type="CONSTANT" description="recovery rate" unit="weeks^-1"/>
    <parameters name="μ" expression="0.02" type="CONSTANT" description="background death rate" unit="years^-1"/>
    <parameters name="Λ" expression="1000" type="CONSTANT" description="birth rate" unit="people years^-1"/>
    <parameters name="θ" expression="1" type="CONSTANT" description="safe burial rate" unit="weeks^-1"/>
    <parameters name="c_I" expression="0.0" type="CONSTANT" description="contact rate with infectious individuals" unit="people weeks^-1"/>
    <parameters name="c_D" expression="0.0" type="CONSTANT" description="contact rate with infectious dead bodies" unit="people weeks^-1"/>
    <parameters name="ω" expression="1" type="CONSTANT" description="rate at which infected individuals become infectious" unit="weeks^-1"/>
  </parameters>
  <compartments>
    <compartments PrimaryName="Susceptible" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Susceptible individuals become infected through contact with infected individuals or corpses."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Non-symptomatic Infected" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rate="0.0" target="//@compartments.0"/>
        <outgoingFlows xsi:type="seir:RateFlow" rateParameter="//@parameters.2" target="//@compartments.2" description="Non-symptomatic infected individuals become infectious and symptomatic."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Infectious" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Infectious individuals recover from the disease."/>
        <outgoingFlows xsi:type="seir:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Infectious individuals may die from the disease and become infectious deceased."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Infectious Deceased" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:ContactFlow" contactCompartment="//@compartments.0" contactRateParameter="//@parameters.2" target="//@compartments.0" description="Infectious dead bodies infect susceptible individuals through contact."/>
      </outgoingFlows>
    </compartments>
    <compartments PrimaryName="Recovered" population="0">
      <outgoingFlows>
        <outgoingFlows xsi:type="seir:RateFlow" rateParameter="//@parameters.2" target="//@compartments.3" description="Recovered individuals die at the background death rate."/>
      </outgoingFlows>
    </compartments>
  </compartments>
</seir:SEIRModel>
