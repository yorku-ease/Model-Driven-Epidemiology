<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="A" expression="1000" type="CONSTANT" description="Recruitment rate of human" unit="human / (65*12 months)"/>
  <parameters name="β" expression="[0.01, 5]" type="CONSTANT" description="Probability of successful infection rate" unit="1 / (year * human)"/>
  <parameters name="ε" expression="[0, 1]" type="CONSTANT" description="Correction parameter for reinfection term" unit="dimensionless"/>
  <parameters name="u" expression="[0, 1]" type="CONSTANT" description="Rate of vaccination" unit="1 / day"/>
  <parameters name="θ" expression="[0.067, 0.1]" type="CONSTANT" description="Vaccine wane rate" unit="1 / day"/>
  <parameters name="γ" expression="[0.5, 2]" type="CONSTANT" description="Recovery rate" unit="1 / year"/>
  <parameters name="δ" expression="[0.003, 0.02]" type="CONSTANT" description="Drop out rate due to waning immunity" unit="1 / day"/>
  <parameters name="μ" expression="1 / (65*12)" type="CONSTANT" description="Natural death rate" unit="1 / month"/>
  <compartments PrimaryName="S" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Infection of susceptible individuals through direct contact with infected individuals at a rate β."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible individuals at a constant rate u."/>
  </compartments>
  <compartments PrimaryName="V" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning of vaccine protection, moving individuals from vaccinated back to susceptible at a constant rate θ."/>
  </compartments>
  <compartments PrimaryName="I" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Recovery of infected individuals at a constant rate γ."/>
  </compartments>
  <compartments PrimaryName="R" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Transition from the recovered to the susceptible compartment due to waning immunity at a constant rate δ."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Re-infection of recovered individuals by infected individuals at a rate εβ."/>
  </compartments>
</compartmental:CompartmentalModel>
