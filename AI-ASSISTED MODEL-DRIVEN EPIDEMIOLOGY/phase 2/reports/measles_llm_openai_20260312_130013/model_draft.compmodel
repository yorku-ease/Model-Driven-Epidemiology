<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Recruitment rate" expression="L" type="CONSTANT" description="Rate of recruitment into the children group." unit="per week"/>
  <parameters name="Un-monitored Vaccination rate" expression="xU" type="CONSTANT" description="Rate of unmonitored vaccination for children." unit="per week"/>
  <parameters name="Monitored Vaccination rate" expression="xM" type="CONSTANT" description="Rate of monitored vaccination for children." unit="per week"/>
  <parameters name="Adult Vaccination rate" expression="xA" type="CONSTANT" description="Rate of vaccination for adults." unit="per week"/>
  <parameters name="Transmission rate in children" expression="bC" type="CONSTANT" description="Transmission rate of measles among children." unit="per week"/>
  <parameters name="Transmission rate in adults" expression="bA" type="CONSTANT" description="Transmission rate of measles among adults." unit="per week"/>
  <parameters name="Natural death rate" expression="m" type="CONSTANT" description="Natural death rate of the population." unit="per week"/>
  <parameters name="Rate of immunity after recovery" expression="g" type="CONSTANT" description="Rate at which individuals become immune after recovery." unit="per week"/>
  <parameters name="Maturation rate" expression="j" type="CONSTANT" description="Rate at which children mature into adults." unit="per week"/>
  <parameters name="Vaccine effectiveness" expression="1-e" type="CONSTANT" description="Effectiveness of the vaccination." unit="dimensionless"/>
  <parameters name="Rate of immunity in unmonitored vaccinated adults" expression="hA" type="CONSTANT" description="Rate at which unmonitored vaccinated adults become immune." unit="per week"/>
  <parameters name="Rate of immunity in unmonitored vaccinated children" expression="hU" type="CONSTANT" description="Rate at which unmonitored vaccinated children become immune." unit="per week"/>
  <parameters name="Rate of immunity in monitored vaccinated children" expression="hM" type="CONSTANT" description="Rate at which monitored vaccinated children become immune." unit="per week"/>
  <parameters name="Incubation period" expression="d" type="CONSTANT" description="Rate of progression from exposed to infectious." unit="per week"/>
  <parameters name="Disease-induced death rate" expression="d" type="CONSTANT" description="Death rate due to measles infection." unit="per week"/>
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.1" description="Children receiving unmonitored vaccination."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Children receiving monitored vaccination."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.4" target="//@compartments.3" description="Susceptible children becoming exposed through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0"/>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0"/>
  <compartments PrimaryName="Exposed Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.4" description="Exposed children becoming infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.7" target="//@compartments.5" description="Infectious children recovering and becoming immune."/>
  </compartments>
  <compartments PrimaryName="Immune Children" population="0"/>
  <compartments PrimaryName="Susceptible Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Adults receiving unmonitored vaccination."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Adults receiving vaccination."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.4" target="//@compartments.9" description="Susceptible adults becoming exposed through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Adults" population="0"/>
  <compartments PrimaryName="Vaccinated Adults" population="0"/>
  <compartments PrimaryName="Exposed Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.10" description="Exposed adults becoming infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.7" target="//@compartments.11" description="Infectious adults recovering and becoming immune."/>
  </compartments>
  <compartments PrimaryName="Immune Adults" population="0"/>
</compartmental:CompartmentalModel>
