<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="b" expression="0.3 to 0.5" type="CONSTANT" description="Average biting rate per unit time of a female mosquito." unit="1/day"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="Percentage of bites that transmit ZIKV." unit="dimensionless"/>
  <parameters name="α_H" expression="1/3" type="CONSTANT" description="Inverse of incubation time in humans (3 days)." unit="1/day"/>
  <parameters name="γ" expression="1/7" type="CONSTANT" description="Inverse of recovery time in humans (7 days)." unit="1/day"/>
  <parameters name="λ_H" expression="0.00005" type="CONSTANT" description="Human population growth rate." unit="1/day"/>
  <parameters name="K_H" expression="30,000,000 or 120,000" type="CONSTANT" description="Carrying capacity for human population." unit="people"/>
  <parameters name="M" expression="100,000 or 80,000" type="CONSTANT" description="Number of alternative hosts for mosquito bites." unit="hosts"/>
  <parameters name="e" expression="80" type="CONSTANT" description="Number of eggs laid per female mosquito per unit time." unit="eggs/mosquito/day"/>
  <parameters name="τ_1" expression="1/3" type="CONSTANT" description="Inverse of egg development time (3 days)." unit="1/day"/>
  <parameters name="μ_1" expression="0.05" type="CONSTANT" description="Egg mortality rate." unit="1/day"/>
  <parameters name="τ_2" expression="1/9" type="CONSTANT" description="Inverse of larval development time (9 days)." unit="1/day"/>
  <parameters name="μ_2" expression="0.025" type="CONSTANT" description="Larval mortality rate." unit="1/day"/>
  <parameters name="τ_3" expression="1/3" type="CONSTANT" description="Inverse of pupal development time (3 days)." unit="1/day"/>
  <parameters name="μ_3" expression="0.0025" type="CONSTANT" description="Pupal mortality rate." unit="1/day"/>
  <parameters name="K_V" expression="100,000,000 or 5,000,000" type="CONSTANT" description="Carrying capacity for larvae." unit="larvae"/>
  <parameters name="κ" expression="1" type="CONSTANT" description="Mortality rate of larvae caused by limited carrying capacity." unit="1/(larva*day)"/>
  <parameters name="q" expression="0.68" type="CONSTANT" description="Percentage of females among adult vectors." unit="dimensionless"/>
  <parameters name="α_V" expression="1/10" type="CONSTANT" description="Inverse of incubation time in vectors (10 days)." unit="1/day"/>
  <parameters name="μ_V" expression="0.05" type="CONSTANT" description="Mortality rate of adult vectors." unit="1/day"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Transmission of Zika virus from infectious mosquitoes to susceptible humans through bites."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression of exposed humans to the infectious state after the incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Recovery of infectious humans, who then become immune."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Vector Eggs" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.5" description="Maturation of mosquito eggs into the larval stage."/>
  </compartments>
  <compartments PrimaryName="Vector Larvae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.6" description="Maturation of mosquito larvae into the pupal stage."/>
  </compartments>
  <compartments PrimaryName="Vector Pupae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Emergence of adult female mosquitoes from the pupal stage, all of whom are initially susceptible."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Egg laying by susceptible adult female mosquitoes."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.0" target="//@compartments.8" description="Transmission of Zika virus from infectious humans to susceptible mosquitoes through bites."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Egg laying by exposed adult female mosquitoes."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.9" description="Progression of exposed mosquitoes to the infectious state after the extrinsic incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Egg laying by infectious adult female mosquitoes."/>
  </compartments>
</compartmental:CompartmentalModel>
