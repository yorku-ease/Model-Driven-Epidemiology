<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="constant" type="CONSTANT" description="The constant influx rate of the human hosts." unit="individuals/time"/>
  <parameters name="k(a)" expression="variable" type="CONSTANT" description="The age-specific latent period of the human hosts." unit="1/time"/>
  <parameters name="μh" expression="variable" type="CONSTANT" description="The natural death rate of the human hosts." unit="1/time"/>
  <parameters name="μv" expression="variable" type="CONSTANT" description="The natural death rate of the mosquitoes." unit="1/time"/>
  <parameters name="γ1(a)" expression="variable" type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts." unit="1/time"/>
  <parameters name="γ2(a)" expression="variable" type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts." unit="1/time"/>
  <parameters name="βv(a)" expression="variable" type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes." unit="1/time"/>
  <parameters name="βh(a)" expression="variable" type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts." unit="1/time"/>
  <parameters name="ρ" expression="variable" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts." unit="dimensionless"/>
  <parameters name="σ" expression="variable" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Humans become exposed through bites by infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="A fraction of exposed humans become asymptomatic infectious."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="A fraction of exposed humans become symptomatic infectious."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Asymptomatic infectious humans recover."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Symptomatic infectious humans recover."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Mosquitoes become infectious through biting infectious humans."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
