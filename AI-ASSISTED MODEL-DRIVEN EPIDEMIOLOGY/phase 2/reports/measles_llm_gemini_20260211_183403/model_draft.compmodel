<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="range" expression="10e14" type="CONSTANT"/>
  <parameters name="x_U" expression="0.0" type="CONSTANT" description="Un-monitored children Vaccination rate"/>
  <parameters name="x_M" expression="0.0" type="CONSTANT" description="Monitored children Vaccination rate"/>
  <parameters name="x_A" expression="0.0" type="CONSTANT" description="Adult Vaccination rate"/>
  <parameters name="b_C" expression="0.0" type="CONSTANT" description="Transmission rate on the children"/>
  <parameters name="b_A" expression="0.0" type="CONSTANT" description="Transmission rate on the adults"/>
  <parameters name="h_A" expression="0.0" type="CONSTANT" description="Rate of being immune of Un-monitored vaccinated adults"/>
  <parameters name="h_U" expression="0.0" type="CONSTANT" description="Rate of being immune of Un-monitored vaccinated children"/>
  <parameters name="h_M" expression="0.0" type="CONSTANT" description="Rate of being immune of Monitored vaccinated children"/>
  <compartments PrimaryName="I" population="0"/>
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Vaccination of susceptible children into the un-monitored program at rate x_U."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.3" description="Vaccination of susceptible children into the monitored program at rate x_M."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0"/>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0"/>
</compartmental:CompartmentalModel>
