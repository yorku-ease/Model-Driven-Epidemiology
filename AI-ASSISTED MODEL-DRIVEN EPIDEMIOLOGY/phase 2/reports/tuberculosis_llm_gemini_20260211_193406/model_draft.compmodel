<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="A" expression="1000" type="CONSTANT" description="Recruitment rate of human." unit="human"/>
  <parameters name="β" expression="[0.01, 5]" type="CONSTANT" description="Probability of successful infection rate." unit="1/(year*human)"/>
  <parameters name="ε" expression="[0,1]" type="CONSTANT" description="Correction parameter for reinfection term." unit="dimensionless"/>
  <parameters name="u" expression="[0,1]" type="CONSTANT" description="Rate of vaccination." unit="1/day"/>
  <parameters name="θ" expression="[0.067, 0.1]" type="CONSTANT" description="Vaccine wane rate." unit="1/day"/>
  <parameters name="γ" expression="[0.5,2]" type="CONSTANT" description="Recovery rate." unit="1/year"/>
  <parameters name="δ" expression="[0.003, 0.02]" type="CONSTANT" description="Drop out rate due to waning immunity." unit="1/day"/>
  <parameters name="μ" expression="1/(65*12 month)" type="CONSTANT" description="Natural death rate." unit="1/month"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible individuals with rate u."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Infection of susceptible individuals through contact with infectious individuals, with transmission rate β."/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Loss of vaccine-induced immunity (waning) with rate θ."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Recovery of infectious individuals with rate γ."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Reinfection of recovered individuals through contact with infectious individuals, with modified transmission rate εβ."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Loss of natural immunity (waning) leading back to susceptibility with rate δ."/>
  </compartments>
</compartmental:CompartmentalModel>
