<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="A" expression="1000" type="CONSTANT" description="Recruitment rate of human population." unit="human"/>
  <parameters name="β" expression="0.01 to 5" type="CONSTANT" description="Probability of successful infection rate." unit="year^-1"/>
  <parameters name="ε" expression="0 to 1" type="CONSTANT" description="Correction parameter for reinfection." unit="dimensionless"/>
  <parameters name="u" expression="0 to 1" type="CONSTANT" description="Rate of vaccination." unit="year^-1"/>
  <parameters name="θ" expression="0.067 to 0.1" type="CONSTANT" description="Vaccine wane rate." unit="year^-1"/>
  <parameters name="γ" expression="0.5 to 2" type="CONSTANT" description="Recovery rate." unit="year^-1"/>
  <parameters name="δ" expression="0.003 to 0.02" type="CONSTANT" description="Drop out rate due to waning immunity." unit="year^-1"/>
  <parameters name="μ" expression="0.003 to 0.02" type="CONSTANT" description="Natural death rate." unit="year^-1"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Movement of individuals from susceptible to vaccinated due to vaccination."/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Movement of individuals from vaccinated back to susceptible due to waning immunity."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0"/>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Movement of individuals from recovered back to susceptible due to waning immunity."/>
  </compartments>
</compartmental:CompartmentalModel>
