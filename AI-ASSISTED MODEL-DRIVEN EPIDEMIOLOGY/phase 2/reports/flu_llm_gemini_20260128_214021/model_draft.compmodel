<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="0.2" type="CONSTANT"/>
  <parameters name="w" expression="3" type="CONSTANT"/>
  <parameters name="eid" expression="2" type="CONSTANT"/>
  <parameters name="δt" expression="0.25" type="CONSTANT" description="Length of discrete time intervals for the SEIR model." unit="day"/>
  <parameters name="dL" expression="2/σ" type="CONSTANT" description="Average incubation period, derived from the rate of becoming infectious σ." unit="days"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery, representing the daily rate of transition through infectious compartments." unit="1/day"/>
  <parameters name="dI" expression="2/γ" type="CONSTANT" description="Average infectious period, derived from the recovery rate γ." unit="days"/>
  <parameters name="λ(t)" expression="0.0" type="CONSTANT" description="Time-varying rate at which a person becomes infected." unit="1/day"/>
  <parameters name="β" expression="0 to 1.25" type="CONSTANT" description="The constant transmission rate, defined as the rate at which new infections take place given a contact."/>
  <parameters name="ψ" expression="Unif(0,0.39)" type="CONSTANT" description="Exponential Growth Rate (EGR), an unknown parameter with a uniform prior distribution."/>
  <parameters name="π" expression="Unif(0,1)" type="CONSTANT" description="The proportion of the population who is initially susceptible, an unknown parameter with a uniform prior distribution."/>
  <parameters name="λ0" expression="Unif(0,0.000241)" type="CONSTANT" description="The initial infection rate, an unknown parameter with a uniform prior distribution." unit="1/day"/>
  <parameters name="Itot0" expression="1 to 10,000" type="CONSTANT" description="The initial total number of infectious people, assumed to be within a specified range." unit="people"/>
  <parameters name="R0" expression="1 to 4" type="CONSTANT" description="The basic reproduction number, the average number of successful transmissions per infectious person in a fully susceptible population."/>
  <parameters name="Rn" expression="0.0" type="CONSTANT" description="The effective reproduction number, the average number of successful transmissions per infectious person in a partially susceptible population."/>
  <parameters name="pICU" expression="Unif(0,1)" type="CONSTANT" description="Probability of ICU admission given infection, an unknown parameter with a uniform prior distribution."/>
  <parameters name="σ²ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission, a known parameter." unit="days^2"/>
  <parameters name="η" expression="Unif(1,100)" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial distribution of weekly ICU admissions, an unknown parameter with a uniform prior."/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.3" target="//@compartments.4" description="Susceptible individuals become infected and move to the first exposed compartment."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.2"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.3"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Exposed 1" population="0"/>
  <compartments PrimaryName="Exposed 2" population="0"/>
  <compartments PrimaryName="Infectious 1" population="0"/>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="ICU" population="0"/>
</compartmental:CompartmentalModel>
