<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="R" expression="2" type="CONSTANT"/>
  <parameters name="R0" expression="0.0" type="CONSTANT" description="The basic reproduction number, defined as the number of individuals that an infected individual can infect when introduced into a completely susceptible population."/>
  <parameters name="λ" expression="0.0" type="CONSTANT" description="The force of infection. The rate of cholera transmission is a product of the force of infection and the size of the susceptible population."/>
  <parameters name="β" expression="10-5 to 1" type="CONSTANT" description="The rate of “contact” between the susceptible population with contaminated water." unit="days-1"/>
  <parameters name="κ" expression="10^5 to 10^6" type="CONSTANT" description="The concentration of V. cholerae at which the infection rate is 50% of the maximum infection rate." unit="cells/mL"/>
  <parameters name="γ" expression="0.0" type="CONSTANT" description="The per capita recovery rate, which is the reciprocal of the duration of infection."/>
  <parameters name="1/γ" expression="2.9 to 14" type="CONSTANT" description="Duration of cholera infection." unit="days"/>
  <parameters name="1/δ" expression="3 to 41" type="CONSTANT" description="Cholera life span in water reservoir." unit="days"/>
  <parameters name="δ" expression="0.0" type="CONSTANT" description="The decay rate of cholera in the water reservoir, which is the reciprocal of the cholera life span."/>
  <parameters name="ξ" expression="0.01 to 10" type="CONSTANT" description="The rate of water contamination by infectious people shedding V. cholerae into the water reservoir." unit="cells * mL-1 * person-1 * day-1"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible people become infected through exposure to contaminated water."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Infectious people recover from the disease and become immune."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Infectious people shed bacteria, contaminating the water supply."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Bacteria in reservoir" population="0"/>
  <compartments PrimaryName="Treated" population="0"/>
  <compartments PrimaryName="Vaccinated" population="0"/>
  <compartments PrimaryName="Health-educated" population="0"/>
  <compartments PrimaryName="Quarantined" population="0"/>
  <compartments PrimaryName="Asymptomatic" population="0"/>
  <compartments PrimaryName="Hyperinfectious Bacteria" population="0"/>
</compartmental:CompartmentalModel>
