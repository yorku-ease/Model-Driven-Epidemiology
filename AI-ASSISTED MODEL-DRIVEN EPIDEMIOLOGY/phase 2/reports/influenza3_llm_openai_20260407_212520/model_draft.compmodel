<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="k" expression="1/1.9" type="CONSTANT" description="Rate of progression from latent to infectious state; mean latent period 1.9 days." unit="day^-1"/>
  <parameters name="a_i" expression="a_i=(p_Hi/(1-p_Hi))c_1" type="CONSTANT" description="Age-specific hospitalization rate for age group i." unit="day^-1"/>
  <parameters name="p_Hi" expression="Figure 2, Figure S2" type="CONSTANT" description="Fraction of clinical cases hospitalized for age group i." unit="probability"/>
  <parameters name="c_1" expression="1/1.5" type="CONSTANT" description="Recovery rate for infectious class; mean infectious period 1.5 days." unit="day^-1"/>
  <parameters name="c_2" expression="1/1.5" type="CONSTANT" description="Recovery rate for hospitalized class; mean hospitalized period 1.5 days." unit="day^-1"/>
  <parameters name="d_i" expression="d_i=(CFP_i/(1-CFP_i))c_2" type="CONSTANT" description="Influenza mortality rate for age group i." unit="day^-1"/>
  <parameters name="CFP_i" expression="Figure 2, Figure S3" type="CONSTANT" description="Case fatality proportion for age group i." unit="probability"/>
  <parameters name="lambda_i" expression="lambda_i=\sum_j b_ij I_j/N(t) + H_j/N(t)" type="CONSTANT" description="Age-specific force of infection acting on age group i." unit="day^-1"/>
  <parameters name="b_ij" expression="q c_ij" type="CONSTANT" description="Transmission rate between age groups i and j." unit="day^-1"/>
  <parameters name="q" expression="calibrated to R_0" type="CONSTANT" description="Transmission probability per contact." unit="probability per contact"/>
  <parameters name="c_ij" expression="Table S1" type="CONSTANT" description="Age-specific contact rates between age groups i and j." unit="contacts per week"/>
  <parameters name="n(t)" expression="0 for t&lt;t*" type="CONSTANT" description="Vaccination rate; vaccination begins t* days after epidemic onset." unit="day^-1"/>
  <parameters name="t*" expression="25 or 37" type="CONSTANT" description="Vaccination start time in the adaptive strategy scenarios." unit="day"/>
  <parameters name="e_i" expression="77.5% for individuals &lt;65 y; 35% for seniors &gt;65 y" type="CONSTANT" description="Age-specific vaccine efficacy." unit="probability"/>
  <parameters name="g_i" expression="1/10" type="CONSTANT" description="Rate at which effectively vaccinated individuals become protected; mean 10 days." unit="day^-1"/>
  <parameters name="R_0" expression="1.4-1.8 (Mexico 2009 scenario); 1.8 (historical scenarios)" type="CONSTANT" description="Basic reproduction number used in scenario analyses." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.11" target="//@compartments.1" description="Vaccination of susceptible individuals at rate e_i n(t)."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.11" target="//@compartments.2" description="Vaccination failure among susceptible individuals at rate (1-e_i) n(t)."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.1" target="//@compartments.4" description="Infection of susceptible individuals by the age-specific force of infection lambda_i."/>
  </compartments>
  <compartments PrimaryName="Effectively Vaccinated but Not Yet Protected" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.3" description="Development of vaccine-induced protection at rate g_i."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.0" target="//@compartments.4" description="Breakthrough infection of vaccinated but not yet protected individuals by lambda_i."/>
  </compartments>
  <compartments PrimaryName="Ineffectively Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.1" target="//@compartments.4" description="Infection of ineffectively vaccinated individuals by lambda_i."/>
  </compartments>
  <compartments PrimaryName="Protected by Vaccination" population="0"/>
  <compartments PrimaryName="Latent" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Progression from latent to infectious at rate k."/>
  </compartments>
  <compartments PrimaryName="Symptomatic and Infectious in the Community" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.6" description="Hospitalization at age-specific rate a_i."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.7" description="Recovery from infectious state at rate c_1."/>
  </compartments>
  <compartments PrimaryName="Hospitalized" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.7" description="Recovery from hospitalization at rate c_2."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.8" description="Influenza mortality among hospitalized individuals at age-specific rate d_i."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
</compartmental:CompartmentalModel>
