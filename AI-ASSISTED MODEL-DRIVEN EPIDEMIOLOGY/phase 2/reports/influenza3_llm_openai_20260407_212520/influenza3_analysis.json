    "parameters": [
      {
        "index": 0,
        "name": "k",
        "type": "CONSTANT",
        "expression": "1/1.9",
        "description": "Rate of progression from latent to infectious state; mean latent period 1.9 days.",
        "unit": "day^-1"
      },
      {
        "index": 1,
        "name": "a_i",
        "type": "CONSTANT",
        "expression": "a_i=(p_Hi/(1-p_Hi))c_1",
        "description": "Age-specific hospitalization rate for age group i.",
        "unit": "day^-1"
      },
      {
        "index": 2,
        "name": "p_Hi",
        "type": "CONSTANT",
        "expression": "Figure 2, Figure S2",
        "description": "Fraction of clinical cases hospitalized for age group i.",
        "unit": "probability"
      },
      {
        "index": 3,
        "name": "c_1",
        "type": "CONSTANT",
        "expression": "1/1.5",
        "description": "Recovery rate for infectious class; mean infectious period 1.5 days.",
        "unit": "day^-1"
      },
      {
        "index": 4,
        "name": "c_2",
        "type": "CONSTANT",
        "expression": "1/1.5",
        "description": "Recovery rate for hospitalized class; mean hospitalized period 1.5 days.",
        "unit": "day^-1"
      },
      {
        "index": 5,
        "name": "d_i",
        "type": "CONSTANT",
        "expression": "d_i=(CFP_i/(1-CFP_i))c_2",
        "description": "Influenza mortality rate for age group i.",
        "unit": "day^-1"
      },
      {
        "index": 6,
        "name": "CFP_i",
        "type": "CONSTANT",
        "expression": "Figure 2, Figure S3",
        "description": "Case fatality proportion for age group i.",
        "unit": "probability"
      },
      {
        "index": 7,
        "name": "lambda_i",
        "type": "CONSTANT",
        "expression": "lambda_i=\\sum_j b_ij I_j/N(t) + H_j/N(t)",
        "description": "Age-specific force of infection acting on age group i.",
        "unit": "day^-1"
      },
      {
        "index": 8,
        "name": "b_ij",
        "type": "CONSTANT",
        "expression": "q c_ij",
        "description": "Transmission rate between age groups i and j.",
        "unit": "day^-1"
      },
      {
        "index": 9,
        "name": "q",
        "type": "CONSTANT",
        "expression": "calibrated to R_0",
        "description": "Transmission probability per contact.",
        "unit": "probability per contact"
      },
      {
        "index": 10,
        "name": "c_ij",
        "type": "CONSTANT",
        "expression": "Table S1",
        "description": "Age-specific contact rates between age groups i and j.",
        "unit": "contacts per week"
      },
      {
        "index": 11,
        "name": "n(t)",
        "type": "CONSTANT",
        "expression": "0 for t<t*",
        "description": "Vaccination rate; vaccination begins t* days after epidemic onset.",
        "unit": "day^-1"
      },
      {
        "index": 12,
        "name": "t*",
        "type": "CONSTANT",
        "expression": "25 or 37",
        "description": "Vaccination start time in the adaptive strategy scenarios.",
        "unit": "day"
      },
      {
        "index": 13,
        "name": "e_i",
        "type": "CONSTANT",
        "expression": "77.5% for individuals <65 y; 35% for seniors >65 y",
        "description": "Age-specific vaccine efficacy.",
        "unit": "probability"
      },
      {
        "index": 14,
        "name": "g_i",
        "type": "CONSTANT",
        "expression": "1/10",
        "description": "Rate at which effectively vaccinated individuals become protected; mean 10 days.",
        "unit": "day^-1"
      },
      {
        "index": 15,
        "name": "R_0",
        "type": "CONSTANT",
        "expression": "1.4-1.8 (Mexico 2009 scenario); 1.8 (historical scenarios)",
        "description": "Basic reproduction number used in scenario analyses.",
        "unit": "dimensionless"
      }
    ],
