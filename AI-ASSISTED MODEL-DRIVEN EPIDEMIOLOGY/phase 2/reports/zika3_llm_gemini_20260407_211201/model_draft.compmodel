<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="1/αV" expression="Gamma(μ = 10.5, σ = 0.5)" type="CONSTANT" description="Extrinsic incubation period in mosquitoes." unit="days"/>
  <parameters name="1/αH" expression="Gamma(μ = 5.9, σ = 0.5)" type="CONSTANT" description="Intrinsic incubation period in humans." unit="days"/>
  <parameters name="1/γ" expression="Gamma(μ = 5, σ = 0.5)" type="CONSTANT" description="Human infectious period." unit="days"/>
  <parameters name="1/δ" expression="Gamma(μ = 7.8, σ = 0.5)" type="CONSTANT" description="Mosquito lifespan. The rate δ is also the mosquito birth rate." unit="days"/>
  <parameters name="βH" expression="U(0, 1)" type="CONSTANT" description="Vector-to-human transmission rate." unit="days^-1"/>
  <parameters name="βV" expression="U(0, 1)" type="CONSTANT" description="Human-to-vector transmission rate." unit="days^-1"/>
  <parameters name="N" expression="0.0" type="CONSTANT" description="Human population size." unit="individuals"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.6" target="//@compartments.1" description="Infection of susceptible humans by infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.2" description="Progression of humans from latent to infectious state."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.3" description="Recovery of infectious humans."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRateParameter="//@parameters.6" target="//@compartments.5" description="Infection of susceptible mosquitoes by infectious humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.6" description="Progression of mosquitoes from latent to infectious state."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
