<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="0.2" type="CONSTANT"/>
  <parameters name="w" expression="3" type="CONSTANT"/>
  <parameters name="eid" expression="2" type="CONSTANT"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="Transmission rate, the rate at which new infections take place given a contact"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery"/>
  <parameters name="π" expression="0.0" type="CONSTANT" description="Susceptibility, proportion of the population who is initially susceptible"/>
  <parameters name="λ" expression="0.0" type="CONSTANT" description="Initial infection rate"/>
  <parameters name="ψ" expression="0.0" type="CONSTANT" description="Exponential growth rate, the rate at which the compartments E, I grow"/>
  <parameters name="η" expression="0.0" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial distribution"/>
  <parameters name="p_ICU" expression="0.0" type="CONSTANT" description="Probability of ICU admission given infection"/>
  <parameters name="σ2_ICU_E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.1" target="//@compartments.1" description="Susceptible individuals become exposed through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.3"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="A proportion of infectious individuals are admitted to ICU."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="ICU" population="0"/>
</compartmental:CompartmentalModel>
