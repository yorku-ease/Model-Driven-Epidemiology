<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="R0" expression="1.4 to 2.0" type="CONSTANT" description="Basic reproduction number explored for pandemic influenza; moderate scenario 1.7 and high scenario 2.0." unit="dimensionless"/>
  <parameters name="Generation time" expression="2.6" type="CONSTANT" description="Assumed generation time for the pandemic influenza simulations." unit="days"/>
  <parameters name="Clinical fraction" expression="50%" type="CONSTANT" description="Assumed proportion of infected individuals ill enough to be classified as clinical cases." unit="proportion"/>
  <parameters name="Household transmission proportion" expression="30%" type="CONSTANT" description="Estimated proportion of transmission occurring within households in the United States model." unit="proportion"/>
  <parameters name="Non-household transmission proportion" expression="70%" type="CONSTANT" description="Estimated proportion of transmission occurring outside the household in the United States model." unit="proportion"/>
  <parameters name="Community transmission proportion" expression="33% of non-household transmission" type="CONSTANT" description="Assumed share of non-household transmission occurring in the general community." unit="proportion"/>
  <parameters name="School/workplace transmission proportion" expression="37% of non-household transmission" type="CONSTANT" description="Assumed share of non-household transmission occurring in schools and workplaces." unit="proportion"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Infection/transmission from susceptible to infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.2" description="Recovery/removal from the infectious state."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
