<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="[0.01, 5]" type="CONSTANT" description="Probability of successful infection rate." unit="1/(year*human)"/>
  <parameters name="θ" expression="[0.067, 0.1]" type="CONSTANT" description="Vaccine wane rate." unit="1/day"/>
  <parameters name="γ" expression="[0.5, 2]" type="CONSTANT" description="Recovery rate." unit="1/year"/>
  <parameters name="δ" expression="[0.003, 0.02]" type="CONSTANT" description="Dropout rate due to waning immunity." unit="1/day"/>
  <parameters name="μ" expression="1 / (65*12)" type="CONSTANT" description="Natural death rate." unit="1/month"/>
  <parameters name="a2" expression="0.0" type="CONSTANT" description="Coefficient for the quadratic term (x3^2) in the polynomial for the endemic equilibrium."/>
  <parameters name="a1" expression="0.0" type="CONSTANT" description="Coefficient for the linear term (x3) in the polynomial for the endemic equilibrium."/>
  <parameters name="a0" expression="0.0" type="CONSTANT" description="Constant term in the polynomial for the endemic equilibrium."/>
  <parameters name="c2" expression="0.0" type="CONSTANT" description="Coefficient for the quadratic term (x3^2) in the endemic equilibrium polynomial, expressed as a function of the reproduction number ℛc."/>
  <parameters name="c1" expression="0.0" type="CONSTANT" description="Coefficient for the linear term (x3) in the endemic equilibrium polynomial, expressed as a function of the reproduction number ℛc."/>
  <parameters name="c0" expression="0.0" type="CONSTANT" description="Constant term in the endemic equilibrium polynomial, expressed as a function of the reproduction number ℛc."/>
  <compartments PrimaryName="Numerical experiments, and finally, in Section 5, we provide
incorporatingagestructure,vaccination,andtreatmentdynamicswas ourconcludingremarks" population="0"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Vaccination of susceptible individuals."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Primary infection of susceptible individuals through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.1" description="Loss of vaccine-induced immunity, making vaccinated individuals susceptible again."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.4" description="Recovery of infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Reinfection of recovered individuals through contact with infectious individuals."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.1" description="Waning of natural immunity, making recovered individuals susceptible again."/>
  </compartments>
</compartmental:CompartmentalModel>
