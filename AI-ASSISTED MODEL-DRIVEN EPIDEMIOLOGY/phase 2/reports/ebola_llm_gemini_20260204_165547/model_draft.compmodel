<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="." type="CONSTANT"/>
  <parameters name="α" expression="0." type="CONSTANT"/>
  <parameters name="n" expression="0" type="CONSTANT"/>
  <parameters name="γ" expression="0.5" type="CONSTANT" description="recovery rate" unit="weeks⁻¹"/>
  <parameters name="θ" expression="1" type="CONSTANT" description="safe burial rate" unit="weeks⁻¹"/>
  <parameters name="cI" expression="variable" type="CONSTANT" description="contact rate with infectious individuals" unit="people weeks⁻¹"/>
  <parameters name="cD" expression="variable" type="CONSTANT" description="contact rate with infectious dead bodies" unit="people weeks⁻¹"/>
  <parameters name="ω" expression="1" type="CONSTANT" description="rate at which infected individuals becoming infectious" unit="weeks⁻¹"/>
  <parameters name="R0" expression="0.0" type="CONSTANT" description="The reproduction number or eradication threshold, representing the average number of susceptible people that one infected individual will infect."/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Susceptible individuals become infected through contact with infectious living individuals or infectious deceased individuals and move to the non-symptomatic exposed compartment."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.0"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.2" description="Non-symptomatic infected individuals progress to become symptomatic and infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Symptomatic infectious individuals recover from the disease and gain immunity."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Symptomatic infectious individuals die from the disease and become infectious deceased."/>
  </compartments>
  <compartments PrimaryName="Infectious Deceased" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
