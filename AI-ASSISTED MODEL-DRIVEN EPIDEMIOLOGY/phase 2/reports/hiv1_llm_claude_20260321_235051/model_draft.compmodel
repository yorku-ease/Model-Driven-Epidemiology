<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="C" expression="333" type="CONSTANT" description="Constant recruitment in susceptible population" unit="individuals/year"/>
  <parameters name="h" expression="0.48" type="CONSTANT" description="Proportion of men in the population" unit="nondimensional"/>
  <parameters name="c" expression="0.92" type="CONSTANT" description="Proportion of heterosexual men among men" unit="nondimensional"/>
  <parameters name="p" expression="0.90" type="CONSTANT" description="Proportion of initially treated individuals" unit="nondimensional"/>
  <parameters name="mu" expression="0.0129" type="CONSTANT" description="Natural mortality rate" unit="1/year"/>
  <parameters name="delta_upper" expression="0.3333" type="CONSTANT" description="AIDS-related induced mortality rate" unit="1/year"/>
  <parameters name="delta_lower" expression="0.018" type="CONSTANT" description="AIDS development rate in treated individuals due to ART resistance or treatment failure" unit="1/year"/>
  <parameters name="alpha" expression="0.3333" type="CONSTANT" description="Departure rate from all compartments of infected individuals" unit="1/year"/>
  <parameters name="beta_s" expression="0.02" type="CONSTANT" description="Probability of heterosexual sexual transmission" unit="nondimensional"/>
  <parameters name="beta_h" expression="0.44" type="CONSTANT" description="Probability of homosexual sexual transmission" unit="nondimensional"/>
  <parameters name="beta_hw" expression="0.018" type="CONSTANT" description="Probability of sexual transmission between homosexual men and women" unit="nondimensional"/>
  <parameters name="beta_hm" expression="0.25" type="CONSTANT" description="Probability of sexual transmission between homosexual men and heterosexual men" unit="nondimensional"/>
  <parameters name="c_s" expression="4" type="CONSTANT" description="Rate of heterosexual sexual partners" unit="1/year"/>
  <parameters name="c_h" expression="7" type="CONSTANT" description="Rate of homosexual sexual partners" unit="1/year"/>
  <parameters name="c_hw" expression="2" type="CONSTANT" description="Rate of sexual partners between homosexual men and women" unit="1/year"/>
  <parameters name="c_hm" expression="1" type="CONSTANT" description="Rate of sexual partners between homosexual men and heterosexual men" unit="1/year"/>
  <compartments PrimaryName="Susceptible Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible homosexual men through homosexual contact and bisexual contact"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Infected homosexual men enrolling in antiretroviral therapy"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Progression from untreated infected homosexual men to AIDS"/>
  </compartments>
  <compartments PrimaryName="Susceptible Women" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Infection of susceptible women through heterosexual contact with infected heterosexual men or sexual contact with infected homosexual men"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Women" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Infected women enrolling in antiretroviral therapy"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Progression from untreated infected women to AIDS"/>
  </compartments>
  <compartments PrimaryName="Susceptible Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRateParameter="//@parameters.0" target="//@compartments.5" description="Infection of susceptible heterosexual men through heterosexual contact with infected women or contact with infected homosexual men"/>
  </compartments>
  <compartments PrimaryName="Untreated Infected Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Infected heterosexual men enrolling in antiretroviral therapy"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Progression from untreated infected heterosexual men to AIDS"/>
  </compartments>
  <compartments PrimaryName="Treated with Antiretrovirals" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="AIDS development in treated individuals due to ART resistance or treatment failure, at rate delta"/>
  </compartments>
  <compartments PrimaryName="People Living with AIDS" population="0"/>
</compartmental:CompartmentalModel>
