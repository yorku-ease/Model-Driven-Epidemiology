<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Reference" expression="1." type="CONSTANT"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="The percentage of bites that transmit ZIKV."/>
  <parameters name="αH" expression="0.0" type="CONSTANT" description="The inverse incubation time of ZIKV for human."/>
  <parameters name="γ" expression="0.0" type="CONSTANT" description="The recovery rate of an infectious individual."/>
  <parameters name="λ" expression="0.0" type="CONSTANT" description="The human population growth rate."/>
  <parameters name="αV" expression="0.0" type="CONSTANT" description="The inverse incubation time of ZIKV in vectors."/>
  <parameters name="τi" expression="0.0" type="CONSTANT" description="The reciprocal of the development time of vectors in stage i, where i ∈ {1, 2, 3} for egg, larvae, and pupae."/>
  <parameters name="μi" expression="0.0" type="CONSTANT" description="The mortality rate of vectors in stage i, where i ∈ {1, 2, 3} for egg, larvae, and pupae."/>
  <parameters name="μV" expression="0.0" type="CONSTANT" description="The mortality rate of adult vectors."/>
  <parameters name="KV" expression="0.0" type="CONSTANT" description="Carrying capacity for larvae population."/>
  <parameters name="κ" expression="0.0" type="CONSTANT" description="Mortality rate of larvae caused by limited carrying capacity."/>
  <parameters name="βb" expression="0.05 - 0.12" type="CONSTANT" description="Number of infectious bites delivered per vector per day." unit="per day"/>
  <parameters name="1/αH" expression="2 - 4" type="CONSTANT" description="Incubation time in human." unit="days"/>
  <compartments PrimaryName="Susceptible Human" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.1" target="//@compartments.1" description="Susceptible humans become exposed to the Zika virus through bites from infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.2" description="Exposed humans progress to the infectious stage after the incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.3" description="Infectious humans recover from the Zika virus infection."/>
  </compartments>
  <compartments PrimaryName="Recovered Human" population="0"/>
  <compartments PrimaryName="Eggs" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.5" description="Mosquito eggs develop and hatch into the larval stage."/>
  </compartments>
  <compartments PrimaryName="Larvae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Mosquito larvae mature and transition into the pupal stage."/>
  </compartments>
  <compartments PrimaryName="Pupae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.7" description="Mosquito pupae emerge as susceptible adult female mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Susceptible female adult vector" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.1" target="//@compartments.8" description="Susceptible female mosquitoes become exposed to the Zika virus by biting infectious humans."/>
  </compartments>
  <compartments PrimaryName="Exposed female adult vector" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.9" description="Exposed female mosquitoes become infectious after the virus incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious female adult vector" population="0"/>
</compartmental:CompartmentalModel>
