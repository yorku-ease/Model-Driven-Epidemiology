<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="0.2" type="CONSTANT"/>
  <parameters name="w" expression="3" type="CONSTANT"/>
  <parameters name="eid" expression="2" type="CONSTANT"/>
  <parameters name="π" expression="Unif(0,1)" type="CONSTANT" description="The proportion of the population who is initially susceptible."/>
  <parameters name="λ_0" expression="Unif(0,0.000241)" type="CONSTANT" description="The initial infection rate at the start of the epidemic."/>
  <parameters name="ψ" expression="Unif(0,0.39)" type="CONSTANT" description="The Exponential Growth Rate (EGR) at the start of the epidemic."/>
  <parameters name="η" expression="Unif(1,100)" type="CONSTANT" description="The over-dispersion parameter for the Negative Binomial observation model."/>
  <parameters name="p_ICU" expression="Unif(0,1)" type="CONSTANT" description="The probability of being admitted to ICU given infection."/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="The daily rate of recovery (transition from Infectious to Removed)." unit="day^-1"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="The variance of the time from infection to ICU admission." unit="days^2"/>
  <parameters name="δt" expression="0.25" type="CONSTANT" description="The length of the discrete time step used in the model." unit="day"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="The constant transmission rate, representing the rate at which new infections take place given a contact."/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.10" target="//@compartments.4" description="Susceptible individuals become exposed to the virus at rate λ(t)."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.2"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.3"/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Exposed individuals transition from the first to the second exposed sub-compartment at rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Exposed individuals in the second sub-compartment become infectious at rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.7" description="Infectious individuals transition from the first to the second infectious sub-compartment at rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.3" description="Infectious individuals in the second sub-compartment recover at rate γ."/>
  </compartments>
</compartmental:CompartmentalModel>
