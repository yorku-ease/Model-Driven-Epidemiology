<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="1e-5 to 1" type="CONSTANT" description="Rate of 'contact' with reservoir water." unit="per day"/>
  <parameters name="γ" expression="1/14 to 1/2.9" type="CONSTANT" description="Per capita recovery rate, the reciprocal of the duration of cholera infection (2.9 to 14 days)." unit="per day"/>
  <parameters name="δ" expression="1/41 to 1/3" type="CONSTANT" description="Cholera decay rate in the water reservoir, the reciprocal of the cholera life span in water (3 to 41 days)." unit="per day"/>
  <parameters name="ξ" expression="0.01 to 10" type="CONSTANT" description="Rate of water contamination by humans." unit="cells * mL-1 * person-1 * day-1"/>
  <parameters name="κ" expression="1e5 to 1e6" type="CONSTANT" description="Concentration of cholera that yields a 50% chance of infection." unit="cells/mL"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible people are exposed to contaminated water and become infected."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Infectious people recover and become immune."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Infectious people contaminate the water supply by shedding bacteria."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Bacteria in Water" population="0"/>
</compartmental:CompartmentalModel>
