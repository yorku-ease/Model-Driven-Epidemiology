<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="π" expression="Estimated (Unif(0,1) prior)" type="CONSTANT" description="Initial proportion of the population who is susceptible." unit="dimensionless"/>
  <parameters name="λ0" expression="Estimated (Unif(0, 0.000241) prior)" type="CONSTANT" description="Initial infection rate at time t=0." unit="1/day"/>
  <parameters name="ψ" expression="Estimated (Unif(0, 0.39) prior)" type="CONSTANT" description="Exponential growth rate of the epidemic at its start." unit="1/day"/>
  <parameters name="β" expression="Inferred from other parameters" type="CONSTANT" description="Constant transmission rate at which new infections take place given a contact." unit="1/day"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Daily rate of transition through exposed compartments (E1 to E2, and E2 to I1), leading to an average incubation period of 2/σ days." unit="1/day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Daily rate of transition through infectious compartments (I1 to I2, and I2 to R), leading to an average infectious period of 2/γ days." unit="1/day"/>
  <parameters name="p_ICU" expression="Estimated (Unif(0,1) prior)" type="CONSTANT" description="Probability of ICU admission given infection." unit="dimensionless"/>
  <parameters name="η" expression="Estimated (Unif(1, 100) prior)" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial observation model of ICU admissions." unit="dimensionless"/>
  <parameters name="µ_ICU|E" expression="5.708" type="CONSTANT" description="Mean time from infection to ICU admission." unit="days"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission." unit="days^2"/>
  <parameters name="N" expression="Season-dependent" type="CONSTANT" description="Total population size. N_2012/13 = 53,679,750; N_2013/14 = 54,091,200; N_2014/15 = 54,551,450." unit="persons"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.3" target="//@compartments.1" description="Infection of susceptible individuals at a rate λ(t), where λ(t) = β * (I1(t) + I2(t)) / N."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.2" description="Progression from the first to the second exposed stage at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.3" description="Progression from the second exposed stage to the first infectious stage at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.4" description="Progression from the first to the second infectious stage at a daily rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
