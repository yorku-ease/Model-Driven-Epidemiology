<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="π" expression="Inferred" type="CONSTANT" description="Susceptibility; the proportion of the population who is initially susceptible." unit="dimensionless"/>
  <parameters name="λ0" expression="Inferred" type="CONSTANT" description="Initial infection rate." unit="day^-1"/>
  <parameters name="ψ" expression="Inferred" type="CONSTANT" description="Exponential growth rate of the epidemic." unit="day^-1"/>
  <parameters name="η" expression="Inferred" type="CONSTANT" description="Over-dispersion parameter for the Negative Binomial observation model." unit="dimensionless"/>
  <parameters name="p_ICU" expression="Inferred" type="CONSTANT" description="Probability of ICU admission given infection." unit="dimensionless"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of becoming infectious (progression through exposed stages)." unit="day^-1"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery (progression through infectious stages)." unit="day^-1"/>
  <parameters name="µ_ICU|E" expression="5.708" type="CONSTANT" description="Mean time from infection to ICU admission." unit="days"/>
  <parameters name="σ^2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission." unit="days^2"/>
  <parameters name="N_2012/13" expression="53679750" type="CONSTANT" description="Population size for the 2012/13 season." unit="persons"/>
  <parameters name="N_2013/14" expression="54091200" type="CONSTANT" description="Population size for the 2013/14 season." unit="persons"/>
  <parameters name="N_2014/15" expression="54551450" type="CONSTANT" description="Population size for the 2014/15 season." unit="persons"/>
  <parameters name="β" expression="Inferred" type="CONSTANT" description="The constant transmission rate at which new infections take place given a contact." unit="day^-1"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.12" target="//@compartments.1" description="Infection of susceptible individuals at a rate λ(t), proportional to the number of infectious people I(t) = I1(t) + I2(t) and the transmission rate β."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.2" description="Progression from the first to the second exposed stage at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.5" target="//@compartments.3" description="Progression from the exposed state to the infectious state at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.4" description="Progression from the first to the second infectious stage at a daily rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
