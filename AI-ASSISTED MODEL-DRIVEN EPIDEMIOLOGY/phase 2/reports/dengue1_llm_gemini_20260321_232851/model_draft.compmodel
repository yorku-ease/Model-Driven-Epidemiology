<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="..." type="CONSTANT" description="The constant influx rate of the human hosts." unit="..."/>
  <parameters name="k(a)" expression="..." type="CONSTANT" description="The age-specific rate of progression from the exposed class for human hosts (inverse of latent period)." unit="..."/>
  <parameters name="μ_h" expression="..." type="CONSTANT" description="The natural death rate of the human hosts." unit="..."/>
  <parameters name="μ_v" expression="..." type="CONSTANT" description="The natural death rate of the mosquitoes." unit="..."/>
  <parameters name="γ_1(a)" expression="..." type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts." unit="..."/>
  <parameters name="γ_2(a)" expression="..." type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts." unit="..."/>
  <parameters name="β_v(a)" expression="..." type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes." unit="..."/>
  <parameters name="β_h(a)" expression="..." type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts." unit="..."/>
  <parameters name="ρ" expression="..." type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts." unit="..."/>
  <parameters name="σ" expression="..." type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts." unit="..."/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible humans through bites by infectious mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression from exposed to symptomatic infectious state with probability ρ."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Progression from exposed to asymptomatic infectious state with probability 1-ρ."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Recovery of symptomatic infectious humans."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Recovery of asymptomatic infectious humans."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Reinfection of asymptomatic individuals through mosquito bites, causing them to become symptomatic infectious."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Infection of susceptible mosquitoes through biting symptomatic or asymptomatic infectious humans."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
