<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Latent period" expression="2.5" type="CONSTANT" description="Time from exposure to onset of infectiousness." unit="days"/>
  <parameters name="Presymptomatic infectious period" expression="1" type="CONSTANT" description="Duration of infectiousness before symptom onset." unit="day"/>
  <parameters name="Infectious period (mild to moderate)" expression="6" type="CONSTANT" description="Symptomatic infectious period for mild-to-moderate cases (in absence of isolation)." unit="days"/>
  <parameters name="Infectious period (severe)" expression="6" type="CONSTANT" description="Symptomatic infectious period for severe cases; assumed equal to time to hospital admission." unit="days"/>
  <parameters name="Basic reproduction number" expression="2.3" type="CONSTANT" description="Average number of secondary infections derived from a primary infection in a susceptible population." unit="dimensionless"/>
  <parameters name="Time in quarantine" expression="14" type="CONSTANT" description="Duration of quarantine for exposed cases." unit="days"/>
  <parameters name="Relative risk of transmission for cases in isolation" expression="0.1" type="CONSTANT" description="Transmission reduction for isolated cases relative to unrecognized cases." unit="dimensionless"/>
  <parameters name="Average length of stay in hospital for cases not requiring ICU care" expression="10" type="CONSTANT" description="Duration of stay for hospitalized cases not requiring ICU." unit="days"/>
  <parameters name="Average length of stay in hospital before ICU admission" expression="3" type="CONSTANT" description="Duration of stay in hospital for severe cases before they are admitted to the ICU." unit="days"/>
  <parameters name="Average length of stay in ICU" expression="21" type="CONSTANT" description="Duration of stay for cases in the ICU." unit="days"/>
  <parameters name="Average length of stay in hospital after ICU" expression="21" type="CONSTANT" description="Duration of stay in hospital for cases after being discharged from the ICU." unit="days"/>
  <parameters name="Probability of severe infection" expression="Varies by age and comorbidity (e.g., 0.01 for &lt;15 with no comorbidities, 0.76 for &gt;=70 with comorbidities)" type="CONSTANT" description="Probability that an infection is severe, requiring hospital admission." unit="dimensionless"/>
  <parameters name="Probability severe case requires admission to ICU" expression="0.26" type="CONSTANT" description="Probability that a severe case requires admission to the ICU." unit="dimensionless"/>
  <parameters name="Probability of death in cases admitted to ICU" expression="Varies by age and comorbidity (e.g., 0 for &lt;15, 1 for &gt;=70 with comorbidities)" type="CONSTANT" description="Probability of death for cases admitted to the ICU." unit="dimensionless"/>
  <parameters name="Proportion of nonquarantined cases tested and isolated (Base Case)" expression="Varies by age: 10% (&lt;15), 40% (15-49), 70% (&gt;=50)" type="CONSTANT" description="Proportion of symptomatic, non-quarantined individuals who are tested and moved to an isolated compartment (Base Case)." unit="percent"/>
  <parameters name="Proportion of exposed cases quarantined (Base Case)" expression="10" type="CONSTANT" description="Proportion of exposed cases who are identified and enter quarantine before becoming infectious (Base Case)." unit="percent"/>
  <parameters name="Reduction in contacts with physical distancing (Base Case)" expression="0" type="CONSTANT" description="Reduction in contact rates due to physical distancing measures (Base Case)." unit="percent"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.6" target="//@compartments.1" description="Infection of susceptible individuals through contact with individuals in any of the infectious compartments."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Quarantine of exposed individuals identified via contact tracing."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Progression from the latent period to the presymptomatic infectious stage."/>
  </compartments>
  <compartments PrimaryName="Exposed (quarantined)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Progression from the quarantined latent period to the isolated presymptomatic infectious stage."/>
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Onset of mild to moderate symptoms."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Onset of severe symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Onset of mild to moderate symptoms in an isolated individual."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Onset of severe symptoms in an isolated individual."/>
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Isolation of individuals with mild to moderate symptoms following testing."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.13" description="Recovery of individuals with mild to moderate infection."/>
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.13" description="Recovery of isolated individuals with mild to moderate infection."/>
  </compartments>
  <compartments PrimaryName="Infectious (severe)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Isolation of individuals with severe symptoms following testing."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospitalization of severe cases."/>
  </compartments>
  <compartments PrimaryName="Infectious (severe, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospitalization of isolated severe cases that will require ICU care."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of hospitalized cases that did not require ICU care."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital (pre-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Admission to the ICU from a hospital ward."/>
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Discharge from the ICU to a hospital ward for continued care."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.14" description="Death of cases in the ICU."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital (post-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery after being discharged from the ICU and receiving post-ICU hospital care."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
</compartmental:CompartmentalModel>
