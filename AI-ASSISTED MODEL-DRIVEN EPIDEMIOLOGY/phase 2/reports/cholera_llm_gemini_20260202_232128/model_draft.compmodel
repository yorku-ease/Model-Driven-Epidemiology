<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="R" expression="2" type="CONSTANT"/>
  <parameters name="etal" expression="5" type="CONSTANT"/>
  <parameters name="β" expression="10-5 to 1" type="CONSTANT" description="Rate of 'contact' with reservoir water." unit="days-1"/>
  <parameters name="1/γ" expression="2.9 to 14" type="CONSTANT" description="Duration of cholera infection." unit="days"/>
  <parameters name="γ" expression="0.0" type="CONSTANT" description="The per capita recovery rate from cholera infection."/>
  <parameters name="1/δ" expression="3 to 41" type="CONSTANT" description="Cholera life span in water reservoir." unit="days"/>
  <parameters name="δ" expression="0.0" type="CONSTANT" description="The removal or decay rate of cholera bacteria from the water reservoir."/>
  <parameters name="ξ" expression="0.01 to 10" type="CONSTANT" description="Rate of water contamination by humans, i.e., the rate of increase in V. cholerae concentration in the water reservoir." unit="cells * mL-1 * person-1 * day-1"/>
  <parameters name="κ" expression="10^5 to 10^6" type="CONSTANT" description="The concentration of V. cholerae that yields a 50% chance of infection." unit="cells/mL"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible individuals become infected and infectious after being exposed to contaminated water."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Susceptible individuals are vaccinated and transferred directly to the recovered/immune compartment."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Susceptible individuals receive a vaccine and move to a separate vaccinated compartment."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.0" target="//@compartments.8" description="Susceptible individuals become infected but do not show symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Infectious individuals recover from cholera and become immune."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Infectious individuals shed bacteria, which contaminates the water supply."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Infected patients receive treatment and are moved to a distinct treated compartment."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Immunity from a previous infection wanes, and individuals become susceptible again."/>
  </compartments>
  <compartments PrimaryName="Bacterial Concentration" population="0"/>
  <compartments PrimaryName="Treated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Patients who have received treatment recover from the infection."/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Immunity conferred by a vaccine wanes over time, and individuals become susceptible again."/>
  </compartments>
  <compartments PrimaryName="Health Educated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Health-educated individuals who are exposed to cholera are moved to a quarantine compartment."/>
  </compartments>
  <compartments PrimaryName="Quarantined" population="0"/>
  <compartments PrimaryName="Asymptomatic Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Asymptomatically infectious individuals recover from the infection, typically at a faster rate than symptomatic individuals."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Asymptomatic individuals shed bacteria into the water supply, contributing to contamination."/>
  </compartments>
</compartmental:CompartmentalModel>
