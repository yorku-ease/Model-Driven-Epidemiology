<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="Not specified" type="CONSTANT" description="The constant influx rate of the human hosts." unit="individuals/time"/>
  <parameters name="μ_h" expression="Not specified" type="CONSTANT" description="The natural death rate of the human hosts." unit="1/time"/>
  <parameters name="μ_v" expression="Not specified" type="CONSTANT" description="The natural death rate of the mosquitoes." unit="1/time"/>
  <parameters name="γ_1(a)" expression="Not specified" type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts." unit="1/time"/>
  <parameters name="γ_2(a)" expression="Not specified" type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts." unit="1/time"/>
  <parameters name="β_v(a)" expression="Not specified" type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes." unit="1/time"/>
  <parameters name="β_h(a)" expression="Not specified" type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts." unit="1/time"/>
  <parameters name="ρ" expression="Not specified" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts." unit="dimensionless"/>
  <parameters name="σ" expression="Not specified" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts." unit="dimensionless"/>
  <compartments PrimaryName="S_h" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible humans become exposed through bites by infectious mosquitoes, governed by the age-dependent transmission rate β_h(a)."/>
  </compartments>
  <compartments PrimaryName="E_h" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="A fraction ρ of exposed individuals become symptomatic infectious at an age-dependent rate k(a)."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="A fraction (1-ρ) of exposed individuals become asymptomatic infectious at an age-dependent rate k(a)."/>
  </compartments>
  <compartments PrimaryName="I_h" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.4" description="Symptomatic infectious individuals recover at an age-specific rate γ_1(a)."/>
  </compartments>
  <compartments PrimaryName="A_h" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.0" target="//@compartments.2" description="Asymptomatic individuals are reinfected by infectious mosquitoes and become symptomatic infectious, governed by the transmission rate σβ_h(a)."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Asymptomatic infectious individuals recover at an age-specific rate γ_2(a)."/>
  </compartments>
  <compartments PrimaryName="R_h" population="0"/>
  <compartments PrimaryName="S_v" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Susceptible mosquitoes become infected by biting symptomatic or asymptomatic humans, governed by the age-dependent transmission rate β_v(a)."/>
  </compartments>
  <compartments PrimaryName="I_v" population="0"/>
</compartmental:CompartmentalModel>
