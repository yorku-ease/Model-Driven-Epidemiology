<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!-- Eight HIV/AIDS compartments from Espitia et al. [file:21]
       Sh, Ih, Sw, Iw, Sm, Im, T, A. -->

  <!-- Sh: Susceptible homosexual men -->
  <compartments PrimaryName="Susceptible homosexual men" SecondaryName="Sh" population="2446">
    <!-- Recruitment into Sh: C * h * (1 - c). [file:21] -->
    <incomingFlows xsi:type="compartmental:RateFlow"
      source="//@compartments.8"
      rateParameter="//@parameters.0"
      description="Recruitment into Sh: C*h*(1-c)."/>
    <!-- Infection of Sh via sexual contact with infected partners (force of infection from paper). [file:21] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.5"
      description="Sh→Ih via homosexual contacts (ch*bh term)."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.7"
      contactRateParameter="//@parameters.6"
      description="Sh→Ih via contacts with AIDS individuals (from force of infection)."/>
    <!-- Natural death from Sh at rate l. [file:21] -->
    <externalSinks name="Natural_death_Sh"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.0"/>
  </compartments>

  <!-- Ih: Untreated infected homosexual men -->
  <compartments PrimaryName="Untreated infected homosexual men" SecondaryName="Ih" population="79">
    <!-- Progression Ih→T at rate a * p (enrolment in ART). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.7"
      description="Ih→T (ART initiation among homosexual men)."/>
    <!-- Progression Ih→A at rate a * (1 - p) (develop AIDS without treatment). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.8"
      description="Ih→A (AIDS in untreated homosexual men)."/>
    <!-- Natural death Ih at rate l. [file:21] -->
    <externalSinks name="Natural_death_Ih"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.1"/>
  </compartments>

  <!-- Sw: Susceptible women -->
  <compartments PrimaryName="Susceptible women" SecondaryName="Sw" population="189994">
    <!-- Recruitment into Sw: C * (1 - h). [file:21] -->
    <incomingFlows xsi:type="compartmental:RateFlow"
      source="//@compartments.8"
      rateParameter="//@parameters.1"
      description="Recruitment into Sw: C*(1-h)."/>
    <!-- Sw→Iw via contacts with Ih and Im (transmission forces bhw, bs, chw, cs). [file:21] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.9"
      description="Sw→Iw via contacts with homosexual men (bhw * chw)."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.5"
      contactRateParameter="//@parameters.10"
      description="Sw→Iw via heterosexual contacts with infected men (bs * cs)."/>
    <!-- Natural death Sw at rate l. [file:21] -->
    <externalSinks name="Natural_death_Sw"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.2"/>
  </compartments>

  <!-- Iw: Untreated infected women -->
  <compartments PrimaryName="Untreated infected women" SecondaryName="Iw" population="6">
    <!-- Iw→T at rate a * p (ART initiation). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.7"
      description="Iw→T (ART initiation among women)."/>
    <!-- Iw→A at rate a * (1 - p) (AIDS without treatment). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.8"
      description="Iw→A (AIDS in untreated women)."/>
    <!-- Natural death Iw at rate l. [file:21] -->
    <externalSinks name="Natural_death_Iw"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.3"/>
  </compartments>

  <!-- Sm: Susceptible heterosexual men -->
  <compartments PrimaryName="Susceptible heterosexual men" SecondaryName="Sm" population="171173">
    <!-- Recruitment into Sm: C * h * c. [file:21] -->
    <incomingFlows xsi:type="compartmental:RateFlow"
      source="//@compartments.8"
      rateParameter="//@parameters.2"
      description="Recruitment into Sm: C*h*c."/>
    <!-- Sm→Im via contacts with Iw and Ih (forces bhm, bs, chm, cs). [file:21] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.5"
      contactCompartment="//@compartments.3"
      contactRateParameter="//@parameters.11"
      description="Sm→Im via contacts with infected women (bs * cs)."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.5"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.12"
      description="Sm→Im via contacts with homosexual men (bhm * chm)."/>
    <!-- Natural death Sm at rate l. [file:21] -->
    <externalSinks name="Natural_death_Sm"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.4"/>
  </compartments>

  <!-- Im: Untreated infected heterosexual men -->
  <compartments PrimaryName="Untreated infected heterosexual men" SecondaryName="Im" population="29">
    <!-- Im→T at rate a * p. [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.7"
      description="Im→T (ART initiation among heterosexual men)."/>
    <!-- Im→A at rate a * (1 - p). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.8"
      description="Im→A (AIDS in untreated heterosexual men)."/>
    <!-- Natural death Im at rate l. [file:21] -->
    <externalSinks name="Natural_death_Im"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.5"/>
  </compartments>

  <!-- T: Treated with ART (no gender stratification, as in paper). [file:21] -->
  <compartments PrimaryName="Treated with ART" SecondaryName="T" population="107">
    <!-- Inflow from all untreated infected classes (Ih, Iw, Im) handled by their outgoing flows. [file:21] -->
    <!-- T→A at rate δ (AIDS development under ART failure). [file:21] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.4"
      description="T→A due to ART failure/resistance (δ)."/>
    <!-- Natural death T at rate l. [file:21] -->
    <externalSinks name="Natural_death_T"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.6"/>
  </compartments>

  <!-- A: People living with AIDS (treated or untreated). [file:21] -->
  <compartments PrimaryName="People living with AIDS" SecondaryName="A" population="47">
    <!-- Inflow from Ih, Iw, Im, and T handled by their outgoing flows. [file:21] -->
    <!-- AIDS-induced death at rate d (disease mortality). [file:21] -->
    <externalSinks name="AIDS_death"
      rateParameter="//@parameters.13"
      sourceCompartment="//@compartments.7"/>
    <!-- Natural death A at rate l. [file:21] -->
    <externalSinks name="Natural_death_A"
      rateParameter="//@parameters.3"
      sourceCompartment="//@compartments.7"/>
  </compartments>

  <!-- Dummy compartment used only as a conceptual source for recruitment flows (not a real state). -->
  <compartments PrimaryName="RecruitmentSource" SecondaryName="SRC" population="0"/>

  <!-- Parameters mapped from paper (Table 3 and Section 3.1). [file:21] -->
  <!-- C: overall recruitment; h: proportion men; c: proportion heterosexual men. [file:21] -->
  <parameters name="C_h_1_minus_c" expression="333*0.48*(1-0.92)" description="Recruitment: C*h*(1-c) into Sh" unit="people/time"/>      <!-- index 0 -->
  <parameters name="C_1_minus_h" expression="333*(1-0.48)" description="Recruitment: C*(1-h) into Sw" unit="people/time"/>            <!-- index 1 -->
  <parameters name="C_h_c" expression="333*0.48*0.92" description="Recruitment: C*h*c into Sm" unit="people/time"/>                   <!-- index 2 -->

  <!-- l: natural mortality rate. [file:21] -->
  <parameters name="l" expression="0.0129" description="Natural death rate" unit="1/time"/>                                            <!-- index 3 -->

  <!-- δ: AIDS development in treated (paper’s d for ART failure). [file:21] -->
  <parameters name="delta" expression="0.018" description="AIDS development rate for treated individuals" unit="1/time"/>             <!-- index 4 -->

  <!-- Transmission/contact parameters used in forces of infection. [file:21] -->
  <parameters name="ch_bh" expression="7*0.44" description="Homosexual contact term ch*bh" unit="1/time"/>                             <!-- index 5 -->
  <parameters name="A_contact_term" expression="0.0" description="Contact term with AIDS individuals (as in model’s force of infection)" unit="1/time"/> <!-- 6 -->

  <!-- a*p and a*(1-p) for ART enrolment vs direct AIDS progression (a=0.3333, p=0.90). [file:21] -->
  <parameters name="a_p" expression="0.3333*0.90" description="Rate a*p: progression from untreated infected to T" unit="1/time"/>     <!-- 7 -->
  <parameters name="a_1_minus_p" expression="0.3333*(1-0.90)" description="Rate a*(1-p): progression from untreated infected to A" unit="1/time"/> <!-- 8 -->

  <!-- Sw infection terms: bhw*chw, bs*cs. [file:21] -->
  <parameters name="chw_bhw" expression="2*0.018" description="Contact term chw*bhw for Sw infection via Ih" unit="1/time"/>          <!-- 9 -->
  <parameters name="cs_bs" expression="4*0.02" description="Contact term cs*bs for Sw infection via Im" unit="1/time"/>               <!-- 10 -->

  <!-- Sm infection terms: cs*bs via Iw, chm*bhm via Ih. [file:21] -->
  <parameters name="cs_bs_Sm" expression="4*0.02" description="Contact term cs*bs for Sm infection via Iw" unit="1/time"/>            <!-- 11 -->
  <parameters name="chm_bhm" expression="1*0.25" description="Contact term chm*bhm for Sm infection via Ih" unit="1/time"/>           <!-- 12 -->

  <!-- AIDS-induced death d (1/3 year^-1). [file:21] -->
  <parameters name="d_AIDS" expression="0.3333" description="AIDS-induced death rate d" unit="1/time"/>                               <!-- 13 -->

</compartmental:CompartmentalModel>
