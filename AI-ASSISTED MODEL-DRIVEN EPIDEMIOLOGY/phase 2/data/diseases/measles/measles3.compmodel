<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Babad et al. (1995)
    Predicting the impact of measles vaccination in England and Wales: model validation and analysis of policy options

    This .compmodel is based directly on the paper's compartment diagram in Figure 1
    and the model description in the Methods section.

    The paper explicitly defines the following compartments:
      M  = maternal immunity
      X  = susceptible
      Xv = vaccine failure (vaccinated but not effectively protected)
      H  = latent / pre-patent
      Y  = infectious
      Z  = immune

    Core paper-aligned transitions preserved:
      Births -> M
      M -> X                       loss of passive immunity
      X -> H                       infection
      X -> Z                       effective vaccination
      X -> Xv                      vaccine failure after vaccination
      Xv -> H                      infection of vaccine failures
      H -> Y                       progression from latent to infectious
      Y -> Z                       recovery and long-lasting immunity

    Important note:
      the published model is a realistic age-structured cohort model with school-term
      seasonality, WAIFW mixing matrices, and explicit vaccination schedules by age.
      This file encodes the core compartment structure from Figure 1 for one representative
      age stratum in the same XML/XMI .compmodel style as your other files.
  -->

  <!-- 0 -->
  <compartments PrimaryName="MaternalImmunity" population="80">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.1"
      rateParameter="//@parameters.0"
      description="Loss of passive maternal antibody protection; corresponds to M -> X in the paper"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Susceptible" population="9200">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.4"
      contactRateParameter="//@parameters.1"
      description="Measles infection of susceptible individuals; corresponds to X -> H in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.2"
      description="Effective vaccination of susceptible individuals with long-lasting protection; corresponds to p*vaccination into Z in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.3"
      description="Vaccine failure among vaccinated susceptibles; corresponds to (1-p)*vaccination into Xv in the paper"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="VaccineFailure" population="200">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.4"
      contactRateParameter="//@parameters.4"
      description="Infection of vaccine-failure individuals who remain unprotected against wild virus; corresponds to Xv -> H in the paper"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="Latent" population="15">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.5"
      description="Progression from latent/pre-patent infection to infectious measles; corresponds to H -> Y in the paper"/>
  </compartments>

  <!-- 4 -->
  <compartments PrimaryName="Infectious" population="10">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.6"
      description="Recovery from infectious measles and acquisition of lasting immunity; corresponds to Y -> Z in the paper"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="Immune" population="495"/>

  <!-- Parameters -->
  <parameters name="MaternalImmunityLossRate" expression="4.0"
    description="Rate of loss of passive immunity; Table 1 gives mean maternal protection of about 3 months, corresponding to rate 4.0 per year"/>
  <parameters name="SusceptibleInfectionRate" expression="0.52"
    description="Representative force of infection for one age stratum in the realistic age-structured measles model; the paper uses age-specific forces of infection and WAIFW mixing"/>
  <parameters name="EffectiveVaccinationRate" expression="0.18"
    description="Effective vaccination flow from susceptible to immune, reflecting baseline high coverage and vaccine efficacy in the paper"/>
  <parameters name="VaccineFailureRate" expression="0.02"
    description="Vaccination flow from susceptible to vaccine-failure class, reflecting imperfect vaccine efficacy in the paper"/>
  <parameters name="VaccineFailureInfectionRate" expression="0.40"
    description="Force of infection for vaccine-failure individuals exposed to wild virus; these individuals follow the same infection course as susceptibles once infected"/>
  <parameters name="LatentProgressionRate" expression="52.14"
    description="Rate of progression from latent to infectious; Table 1 gives average latent period of 7 days, corresponding to 52.14 per year"/>
  <parameters name="RecoveryRate" expression="52.14"
    description="Rate of recovery from infectious measles; Table 1 gives average infectious period of 7 days, corresponding to 52.14 per year"/>

</compartmental:CompartmentalModel>
