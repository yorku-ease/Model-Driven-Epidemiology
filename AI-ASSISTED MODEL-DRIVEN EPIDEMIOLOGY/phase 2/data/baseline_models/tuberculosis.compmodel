<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!-- TB model in the paper has 4 compartments: S, V, I, R with vaccination, vaccine waning,
       recovery, reinfection of recovered (reduced by correction α in [0,1]), immunity waning R→S,
       recruitment Λ into S, and natural death μ in all compartments. [file:21] -->

  <compartments PrimaryName="Susceptible">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="compartments.2"
      contactCompartment="compartments.2"
      contactRateParameter="parameters.2"
      description="Primary infection: S→I through contact with I at rate π (incidence term uses S and I)"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="compartments.1"
      rateParameter="parameters.3"
      description="Vaccination: S→V at rate θ"/>
  </compartments>

  <compartments PrimaryName="Vaccinated">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="compartments.0"
      rateParameter="parameters.4"
      description="Vaccine waning: V→S at rate δ (finite duration of vaccine protection)"/>
  </compartments>

  <compartments PrimaryName="Infected">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="compartments.3"
      rateParameter="parameters.5"
      description="Recovery/treatment: I→R at rate γ"/>
  </compartments>

  <compartments PrimaryName="Recovered">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="compartments.2"
      contactCompartment="compartments.2"
      contactRateParameter="parameters.8"
      description="Reinfection: R→I through contact with I at reduced rate α·π (α is correction in [0,1])"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="compartments.0"
      rateParameter="parameters.0"
      description="Waning natural immunity: R→S at rate η (temporary immunity)"/>
  </compartments>

  <!-- Recruitment and natural death -->
  <externalSources name="Recruitment (births)" rateParameter="parameters.7" targetCompartment="compartments.0"/>

  <externalSinks name="Natural death S" rateParameter="parameters.1" sourceCompartment="compartments.0"/>
  <externalSinks name="Natural death V" rateParameter="parameters.1" sourceCompartment="compartments.1"/>
  <externalSinks name="Natural death I" rateParameter="parameters.1" sourceCompartment="compartments.2"/>
  <externalSinks name="Natural death R" rateParameter="parameters.1" sourceCompartment="compartments.3"/>

  <!-- Parameters (units aligned to paper description: most are rates; α is dimensionless). [file:21] -->
  <parameters name="η" expression="0.027" description="Immunity waning rate (R→S)" unit="1/day"/>
  <parameters name="μ" expression="0.000051" description="Natural death rate" unit="1/day"/>
  <parameters name="π" expression="0.0059" description="Infection rate/probability of successful infection (S→I term)" unit="1/day"/>
  <parameters name="θ" expression="0.085" description="Vaccination rate (S→V)" unit="1/day"/>
  <parameters name="δ" expression="0.00274" description="Vaccine waning rate (V→S)" unit="1/day"/>
  <parameters name="γ" expression="0.041" description="Recovery rate (I→R)" unit="1/day"/>
  <parameters name="α" expression="1" description="Reinfection correction parameter (range: 0 to 1)" unit="dimensionless"/>
  <parameters name="Λ" expression="98.7" description="Recruitment rate into susceptible" unit="1/day"/>

  <parameters name="α*π" type="EXPRESSION" expression="α * π"
    description="Reinfection rate multiplier (α in [0,1])" unit="1/day"/>

</compartmental:CompartmentalModel>

