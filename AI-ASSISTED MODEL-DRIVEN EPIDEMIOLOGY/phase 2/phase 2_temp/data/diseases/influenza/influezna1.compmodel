<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="54551450">

  <!-- Discrete-time deterministic SEIR-type model with E and I split into two stages:
       S, E1, E2, I1, I2, R (Removed), as described in the paper. -->
  <compartments PrimaryName="Susceptible" population="29370000">
    <!-- Force of infection λ(t) = β * I(t) / N (homogeneous mixing, proportional to infectious people). -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      contactRate="0.0"
      contactRateParameter="parameters.2"
      contactCompartment="compartments.3"
      target="compartments.1"
      description="Infection: S→E1 via contact with I1; λ(t)=β*I(t)/N under homogeneous mixing"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      contactRate="0.0"
      contactRateParameter="parameters.2"
      contactCompartment="compartments.4"
      target="compartments.1"
      description="Infection: S→E1 via contact with I2; λ(t)=β*I(t)/N under homogeneous mixing"/>
  </compartments>

  <compartments PrimaryName="Exposed" SecondaryName="E1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      rate="0.0"
      rateParameter="parameters.0"
      target="compartments.2"
      description="Progression: E1→E2 at daily rate σ"/>
  </compartments>

  <compartments PrimaryName="Exposed" SecondaryName="E2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      rate="0.0"
      rateParameter="parameters.0"
      target="compartments.3"
      description="Progression: E2→I1 at daily rate σ"/>
  </compartments>

  <compartments PrimaryName="Infectious" SecondaryName="I1" population="1515">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      rate="0.0"
      rateParameter="parameters.1"
      target="compartments.4"
      description="Progression: I1→I2 at daily rate γ"/>
  </compartments>

  <compartments PrimaryName="Infectious" SecondaryName="I2" population="1515">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      rate="0.0"
      rateParameter="parameters.1"
      target="compartments.5"
      description="Removal: I2→R at daily rate γ"/>
  </compartments>

  <compartments PrimaryName="Removed" population="25100935"/>

  <!-- Parameters exactly as defined in the paper's transmission model section. -->
  <parameters name="σ" expression="1"
    description="Daily transition rate E1→E2 and E2→I1 (two-stage latent period)"
    unit="1/day"/>
  <parameters name="γ" expression="0.5797"
    description="Daily transition rate I1→I2 and I2→R (two-stage infectious period)"
    unit="1/day"/>
  <parameters name="β" expression="1.24"
    description="Transmission rate in λ(t)=β*I(t)/N (homogeneous mixing)"
    unit="1/day"/>

</compartmental:CompartmentalModel>

