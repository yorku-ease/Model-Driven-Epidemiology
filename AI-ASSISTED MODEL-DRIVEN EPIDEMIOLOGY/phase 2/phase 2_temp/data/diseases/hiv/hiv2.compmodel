<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Eaton et al. (2012)
    HIV Treatment as Prevention

    Simplified compartmental structure derived from the paper:
    - S: Susceptible
    - I1: Early infection (high infectiousness)
    - I2: Chronic infection (CD4 > 350)
    - I3: Late infection (CD4 <= 350)
    - T: On ART (reduced transmission)
    - R: Removed (death)

    The paper emphasizes:
    - Stage-dependent infectiousness
    - ART reduces transmission significantly (>90%)
    - Progression across CD4 stages
  -->

  <!-- S -->
  <compartments PrimaryName="Susceptible" population="9900">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.0"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.1"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.3"
      contactRateParameter="//@parameters.2"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.4"
      contactRateParameter="//@parameters.3"/>
  </compartments>

  <!-- I1 -->
  <compartments PrimaryName="EarlyInfection" population="50">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.4"/>
  </compartments>

  <!-- I2 -->
  <compartments PrimaryName="ChronicInfection" population="30">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.5"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- I3 -->
  <compartments PrimaryName="LateInfection" population="10">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.7"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.8"/>
  </compartments>

  <!-- T -->
  <compartments PrimaryName="OnART" population="5">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.9"/>
  </compartments>

  <!-- R -->
  <compartments PrimaryName="Removed" population="0"/>

  <!-- Parameters -->
  <parameters name="BetaEarly" expression="0.8"/>
  <parameters name="BetaChronic" expression="0.3"/>
  <parameters name="BetaLate" expression="0.6"/>
  <parameters name="BetaART" expression="0.05"/>
  <parameters name="Progression1" expression="0.5"/>
  <parameters name="Progression2" expression="0.2"/>
  <parameters name="ARTStart1" expression="0.3"/>
  <parameters name="ARTStart2" expression="0.4"/>
  <parameters name="DeathLate" expression="0.2"/>
  <parameters name="DeathART" expression="0.05"/>

</compartmental:CompartmentalModel>
