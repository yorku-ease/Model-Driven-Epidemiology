<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="741000000">

  <!--
    Structural approximation of:
    Flaxman et al. (2020), "Estimating the effects of non-pharmaceutical interventions on COVID-19 in Europe".

    Important note:
      - The source paper is NOT a classical compartmental SEIR model.
      - It is a Bayesian semi-mechanistic latent infection model fitted to death data.
      - Rt changes as a piecewise-constant function when interventions occur.
      - Deaths are generated from latent infections through an infection-to-death distribution.
      - The paper does not explicitly track S, E, I, R compartments in the standard way.

    Therefore this .compmodel encodes the nearest valid compartmental abstraction:
      - Susceptible -> Infected via a contact flow using an effective Rt-driven transmission rate
      - Infected -> Removed for resolution / end of infectiousness
      - Infected -> Dead for fatal outcomes

    This preserves the paper's key epidemiological semantics:
      - time-varying transmission through interventions
      - latent infection burden
      - explicit deaths as observed outcome
      - intervention-specific reduction effects
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible" population="740999999">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.10"
      description="Approximate infection process driven by effective reproduction under interventions; paper models infections through Rt and generation-time renewal rather than explicit compartmental force of infection"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Infected" population="1">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.12"
      description="Resolution / removal from infectiousness; included as a compartmental approximation because the paper models infections implicitly rather than with explicit recovery transitions"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.13"
      description="Fatal progression from latent infections to observed deaths; approximates the paper's infection-to-death linkage"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="Removed" population="0"/>

  <!-- 3 -->
  <compartments PrimaryName="Dead" population="0"/>

  <!-- Parameters -->
  <parameters name="Population11Countries" expression="741000000"
    description="Approximate combined population of the 11 European countries analysed in the paper" unit="persons"/>

  <parameters name="InitialRt" expression="3.8"
    description="Average initial reproduction number estimated across the 11 countries before interventions" unit="dimensionless"/>

  <parameters name="GenerationIntervalDays" expression="6.5"
    description="Representative generation interval placeholder retained for semantic fidelity to the renewal-process model" unit="days"/>

  <parameters name="BaseTransmissionRate" type="EXPRESSION" expression="InitialRt / GenerationIntervalDays"
    description="Compartmental approximation of transmission intensity derived from initial Rt" unit="1/day"/>

  <parameters name="PublicEventsBanEffect" expression="1.0"
    description="Relative multiplier for public-events-ban effect on transmission; paper found non-lockdown intervention effects hard to identify separately" unit="dimensionless"/>

  <parameters name="SchoolClosureEffect" expression="1.0"
    description="Relative multiplier for school-closure effect on transmission" unit="dimensionless"/>

  <parameters name="SelfIsolationEffect" expression="1.0"
    description="Relative multiplier for case-based self-isolation effect on transmission" unit="dimensionless"/>

  <parameters name="SocialDistancingEffect" expression="1.0"
    description="Relative multiplier for encouraged social distancing effect on transmission" unit="dimensionless"/>

  <parameters name="LockdownEffect" expression="0.19"
    description="Approximate remaining transmission multiplier under lockdown, corresponding to about 81 percent reduction in Rt reported in the paper" unit="dimensionless"/>

  <parameters name="CombinedInterventionMultiplier" type="EXPRESSION"
    expression="PublicEventsBanEffect * SchoolClosureEffect * SelfIsolationEffect * SocialDistancingEffect * LockdownEffect"
    description="Combined multiplicative effect of interventions on transmission" unit="dimensionless"/>

  <parameters name="EffectiveTransmissionRate" type="EXPRESSION"
    expression="BaseTransmissionRate * CombinedInterventionMultiplier"
    description="Effective transmission rate after interventions in the compartmental approximation" unit="1/day"/>

  <parameters name="MeanOutcomeDelayDays" expression="18"
    description="Representative delay scale retained to approximate progression from infection to outcome in a simple compartmental form" unit="days"/>

  <parameters name="RemovalRate" type="EXPRESSION" expression="1 / MeanOutcomeDelayDays"
    description="Approximate non-fatal resolution rate from infected to removed" unit="1/day"/>

  <parameters name="DeathRate" expression="0.005"
    description="Small fatal transition rate used only to preserve explicit death outcome structure in this approximation; the paper infers deaths from convolution with infection-to-death distribution rather than direct compartmental death flow" unit="1/day"/>

</compartmental:CompartmentalModel>
