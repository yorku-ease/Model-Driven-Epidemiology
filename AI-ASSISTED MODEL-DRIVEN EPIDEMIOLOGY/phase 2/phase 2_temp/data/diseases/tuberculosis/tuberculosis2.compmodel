<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Dye et al. (1998)
    Prospects for worldwide tuberculosis control under the WHO DOTS strategy

    This .compmodel is based on the tuberculosis state structure described in the
    Methods section of the paper.

    The paper describes:
      - new infection leading to progressive primary disease
      - latent infection with later endogenous reactivation
      - exogenous reinfection of latently infected individuals
      - infectious and non-infectious tuberculosis
      - treatment under old and DOTS-like programmes
      - cure returning individuals to the latent infected class
      - treatment failure and self-cure retaining elevated future risk

    Because the article refers to a moderately complex age-structured discrete-time
    model and does not print the full appendix state diagram in the main text, this
    file encodes the closest faithful compartmental abstraction of the published
    structure for one representative age stratum.

    Compartments encoded here:
      S  = susceptible / never infected
      L  = latent infection
      I  = infectious tuberculosis
      N  = non-infectious tuberculosis
      T  = on treatment
      F  = treatment failure / post-failure infected
      C  = self-cured / post-disease latent with elevated relapse risk

    Core paper-aligned transitions preserved:
      S -> L            infection without immediate disease
      S -> I / N        progressive primary disease after new infection
      L -> I / N        endogenous reactivation
      L -> I / N        exogenous reinfection progressing to disease
      I / N -> T        case detection and treatment
      T -> L            cure after short-course chemotherapy
      T -> F            treatment failure / default / transfer-out
      I / N -> C        self-cure without treatment
      F -> I / N        relapse / redevelopment of tuberculosis
      C -> I / N        relapse after self-cure

    Important note:
      the published model is age-structured and coupled to an HIV model. This file
      captures the tuberculosis compartment logic itself, not the full age-HIV tensor product.
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible" population="9900">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.0"
      description="New infection leading to latent tuberculosis infection"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.2"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.1"
      description="Progressive primary disease after new infection leading to infectious tuberculosis"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.2"
      description="Progressive primary disease after new infection leading to non-infectious tuberculosis"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="LatentInfection" population="70">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.3"
      description="Endogenous reactivation from latent infection to infectious tuberculosis"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.4"
      description="Endogenous reactivation from latent infection to non-infectious tuberculosis"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.2"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.5"
      description="Exogenous reinfection of latently infected individuals leading to infectious tuberculosis"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.3"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.6"
      description="Exogenous reinfection of latently infected individuals leading to non-infectious tuberculosis"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="InfectiousTuberculosis" population="15">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.7"
      description="Case detection and start of treatment for infectious tuberculosis; this is the main DOTS lever in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.8"
      description="Self-cure from infectious tuberculosis; paper notes spontaneous resolution can occur without treatment"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="NonInfectiousTuberculosis" population="10">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.9"
      description="Case detection and treatment of non-infectious tuberculosis; the paper states a region-specific fraction of non-infectious cases are detected"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.10"
      description="Self-cure from non-infectious tuberculosis"/>
  </compartments>

  <!-- 4 -->
  <compartments PrimaryName="OnTreatment" population="5">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.1"
      rateParameter="//@parameters.11"
      description="Successful cure after treatment; paper states cured patients remain infected and return to the latent class"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.12"
      description="Treatment failure/default/transfer-out; paper groups these as treatment failure with higher future risk of redevelopment"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="TreatmentFailureState" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.13"
      description="Relapse or redevelopment to infectious tuberculosis after treatment failure"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.14"
      description="Relapse or redevelopment to non-infectious tuberculosis after treatment failure"/>
  </compartments>

  <!-- 6 -->
  <compartments PrimaryName="SelfCuredState" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.15"
      description="Relapse after self-cure to infectious tuberculosis"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.16"
      description="Relapse after self-cure to non-infectious tuberculosis"/>
  </compartments>

  <!-- Parameters -->
  <parameters name="PrimaryInfectionToLatentRate" expression="0.18"
    description="New infection leading to latent class"/>
  <parameters name="PrimaryInfectionToInfectiousRate" expression="0.015"
    description="Progressive primary disease to infectious tuberculosis"/>
  <parameters name="PrimaryInfectionToNonInfectiousRate" expression="0.010"
    description="Progressive primary disease to non-infectious tuberculosis"/>
  <parameters name="LatentReactivationToInfectiousRate" expression="0.0025"
    description="Endogenous reactivation from latent infection to infectious disease"/>
  <parameters name="LatentReactivationToNonInfectiousRate" expression="0.0015"
    description="Endogenous reactivation from latent infection to non-infectious disease"/>
  <parameters name="ExogenousReinfectionToInfectiousRate" expression="0.006"
    description="Reinfection-driven progression from latent infection to infectious disease"/>
  <parameters name="ExogenousReinfectionToNonInfectiousRate" expression="0.004"
    description="Reinfection-driven progression from latent infection to non-infectious disease"/>
  <parameters name="InfectiousCaseDetectionRate" expression="0.70"
    description="Representative DOTS case-detection parameter for infectious cases based on WHO target discussed in the paper"/>
  <parameters name="InfectiousSelfCureRate" expression="0.03"
    description="Self-cure from infectious tuberculosis without treatment"/>
  <parameters name="NonInfectiousCaseDetectionRate" expression="0.42"
    description="Detection of non-infectious cases represented as a fraction of infectious case detection, reflecting the paper's region-specific relative detection of non-infectious cases"/>
  <parameters name="NonInfectiousSelfCureRate" expression="0.04"
    description="Self-cure from non-infectious tuberculosis without treatment"/>
  <parameters name="TreatmentCureRate" expression="0.85"
    description="Cure rate under DOTS-like short-course chemotherapy, matching the WHO target emphasized in the paper"/>
  <parameters name="TreatmentFailureRate" expression="0.15"
    description="Treatment failure / default / transfer-out complementing the DOTS cure target"/>
  <parameters name="FailureRelapseToInfectiousRate" expression="0.06"
    description="Redevelopment of infectious tuberculosis after treatment failure"/>
  <parameters name="FailureRelapseToNonInfectiousRate" expression="0.04"
    description="Redevelopment of non-infectious tuberculosis after treatment failure"/>
  <parameters name="SelfCureRelapseToInfectiousRate" expression="0.03"
    description="Relapse to infectious tuberculosis after self-cure"/>
  <parameters name="SelfCureRelapseToNonInfectiousRate" expression="0.02"
    description="Relapse to non-infectious tuberculosis after self-cure"/>

</compartmental:CompartmentalModel>
