<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Legrand et al. (2007)
    Understanding the dynamics of Ebola epidemics

    This model is built directly from Table 2 and the appendix equations in the paper.
    Compartments:
      S = susceptible
      E = exposed
      I = infectious in community
      H = hospitalized infectious
      F = dead but not yet buried / funeral stage
      R = removed

    Core transmission structure from the paper:
      S -> E from contact with I, H, and F
      E -> I
      I -> H
      I -> R
      I -> F
      H -> F
      H -> R
      F -> R

    This .compmodel preserves the full compartment structure of the paper.
  -->

  <!-- S -->
  <compartments PrimaryName="Susceptible" population="9990">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.0"
      description="Transmission in the community by infectious cases I; corresponds to beta_I S I / N in the paper"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.3"
      contactRateParameter="//@parameters.1"
      description="Transmission at hospital by hospitalized infectious cases H; corresponds to beta_H S H / N in the paper"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.4"
      contactRateParameter="//@parameters.2"
      description="Transmission during traditional burial by funeral-stage infectious cases F; corresponds to beta_F S F / N in the paper"/>
  </compartments>

  <!-- E -->
  <compartments PrimaryName="Exposed" population="5">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.3"
      description="End of incubation: exposed individuals become infectious in the community"/>
  </compartments>

  <!-- I -->
  <compartments PrimaryName="InfectiousCommunity" population="5">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.4"
      description="Hospitalization of infectious community cases; paper transition I -> H"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.5"
      description="Recovery/removal of non-hospitalized infectious survivors; paper transition I -> R"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.6"
      description="Death of infectious community cases before hospitalization; paper transition I -> F"/>
  </compartments>

  <!-- H -->
  <compartments PrimaryName="Hospitalized" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.7"
      description="Death of hospitalized cases; paper transition H -> F"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.8"
      description="Recovery/removal of hospitalized survivors; paper transition H -> R"/>
  </compartments>

  <!-- F -->
  <compartments PrimaryName="FuneralInfectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.9"
      description="Burial/removal after funeral-stage infectious period; paper transition F -> R"/>
  </compartments>

  <!-- R -->
  <compartments PrimaryName="Removed" population="0"/>

  <!-- Parameters -->
  <parameters name="BetaCommunity" expression="0.588"
    description="Transmission coefficient in the community, based on fitted DRC 1995 estimate reported in Table 4 of the paper" unit="week^-1"/>
  <parameters name="BetaHospital" expression="0.794"
    description="Transmission coefficient at hospital, based on fitted DRC 1995 estimate reported in Table 4 of the paper" unit="week^-1"/>
  <parameters name="BetaFuneral" expression="7.653"
    description="Transmission coefficient during traditional burial, based on fitted DRC 1995 estimate reported in Table 4 of the paper" unit="week^-1"/>
  <parameters name="IncubationRate" expression="1/1.0"
    description="Approximate exposed-to-infectious progression in weekly time units; corresponds to alpha in the paper after unit conversion" unit="week^-1"/>
  <parameters name="HospitalizationRate" expression="0.95"
    description="Aggregate I to H transition approximation from c_h * h_1 in weekly units"/>
  <parameters name="CommunityRecoveryRate" expression="0.20"
    description="Aggregate recovery/removal rate for non-hospitalized infectious survivors in weekly units"/>
  <parameters name="CommunityDeathRate" expression="0.60"
    description="Aggregate death-to-funeral transition rate for community infectious cases in weekly units"/>
  <parameters name="HospitalDeathRate" expression="1.20"
    description="Aggregate death transition rate from H to F in weekly units"/>
  <parameters name="HospitalRecoveryRate" expression="0.25"
    description="Aggregate recovery/removal rate from H to R in weekly units"/>
  <parameters name="BurialRate" expression="3.5"
    description="Funeral-to-removal transition rate in weekly units, corresponding to about 2 days from death to burial" unit="week^-1"/>

</compartmental:CompartmentalModel>
