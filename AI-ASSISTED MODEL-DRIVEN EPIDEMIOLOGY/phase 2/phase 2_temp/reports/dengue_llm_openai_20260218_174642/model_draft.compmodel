<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="constant" type="CONSTANT" description="The constant influx rate of the human hosts." unit="individuals per time"/>
  <parameters name="μ_h" expression="0.005" type="CONSTANT" description="The natural death rate of the human hosts." unit="1/time"/>
  <parameters name="μ_v" expression="0.65" type="CONSTANT" description="The natural death rate of the mosquitoes." unit="1/time"/>
  <parameters name="γ_1(a)" expression="age-specific" type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts." unit="1/time"/>
  <parameters name="γ_2(a)" expression="age-specific" type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts." unit="1/time"/>
  <parameters name="β_v(a)" expression="age-specific" type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes." unit="1/time"/>
  <parameters name="β_h(a)" expression="age-specific" type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts." unit="1/time"/>
  <parameters name="ρ" expression="0.5" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts." unit="dimensionless"/>
  <parameters name="σ" expression="0.007" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Transmission of dengue from infectious mosquitoes to susceptible humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.2" description="Progression from exposed to asymptomatic infectious state."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.3" description="Progression from exposed to symptomatic infectious state."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.4" description="Recovery of asymptomatic infectious humans."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.4" description="Recovery of symptomatic infectious humans."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Transmission of dengue from infectious humans to susceptible mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
