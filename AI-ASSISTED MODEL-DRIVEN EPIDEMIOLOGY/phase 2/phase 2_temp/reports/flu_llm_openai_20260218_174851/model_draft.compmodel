<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="β" expression="varies" type="CONSTANT" description="Transmission rate, the rate at which new infections occur given contact." unit="per day"/>
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of progression from exposed to infectious." unit="per day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of recovery or removal from the infectious state." unit="per day"/>
  <parameters name="p_ICU" expression="varies" type="CONSTANT" description="Probability of ICU admission given infection." unit="probability"/>
  <parameters name="μ_ICU|E" expression="5.708" type="CONSTANT" description="Mean time from infection to ICU admission." unit="days"/>
  <parameters name="σ2_ICU|E" expression="18.24" type="CONSTANT" description="Variance of time from infection to ICU admission." unit="days^2"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection occurs when a susceptible individual comes into contact with an infectious individual."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Progression from the first stage of exposure to the second stage."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Progression from the second stage of exposure to the first stage of being infectious."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Progression from the first stage of being infectious to the second stage."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0"/>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
