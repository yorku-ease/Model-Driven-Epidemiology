<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Susceptible individuals become exposed through contact with infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.3" description="Exposed individuals progress to presymptomatic infectious state."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Exposed individuals are quarantined to prevent further spread."/>
  </compartments>
  <compartments PrimaryName="Exposed (quarantined)" population="0"/>
  <compartments PrimaryName="Infectious (presymptomatic)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Presymptomatic individuals develop mild to moderate symptoms."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Presymptomatic individuals develop severe symptoms."/>
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic, isolated)" population="0"/>
  <compartments PrimaryName="Infectious (mild to moderate)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Mild to moderate cases that worsen are admitted to hospital."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Mild to moderate cases recover without hospital admission."/>
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate, isolated)" population="0"/>
  <compartments PrimaryName="Infectious (severe)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Severe cases are admitted to hospital."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Severe cases recover without ICU admission."/>
  </compartments>
  <compartments PrimaryName="Infectious (severe, isolated)" population="0"/>
  <compartments PrimaryName="Admitted to hospital (pre-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospitalized individuals progress to ICU care."/>
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Individuals in ICU recover enough to move to regular hospital care."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Individuals in ICU who succumb to the infection."/>
  </compartments>
  <compartments PrimaryName="Admitted to hospital (post-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Individuals recover from the infection after ICU care."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
</compartmental:CompartmentalModel>
