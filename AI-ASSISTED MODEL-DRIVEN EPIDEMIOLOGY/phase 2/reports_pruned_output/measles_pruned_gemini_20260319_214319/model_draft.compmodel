<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="L" expression="0.0" type="CONSTANT" description="Recruitment rate to children group."/>
  <parameters name="xU" expression="0.087" type="CONSTANT" description="Un-monitored children vaccination rate." unit="per week"/>
  <parameters name="xM" expression="4.77e-5" type="CONSTANT" description="Monitored children vaccination rate." unit="per week"/>
  <parameters name="xA" expression="0" type="CONSTANT" description="Adult vaccination rate." unit="per week"/>
  <parameters name="bC" expression="0.00188" type="CONSTANT" description="Transmission rate on the children."/>
  <parameters name="bA" expression="1.00e-5" type="CONSTANT" description="Transmission rate on the adults."/>
  <parameters name="m" expression="1/(72*52)" type="CONSTANT" description="Natural death rate." unit="per week"/>
  <parameters name="g" expression="0.5" type="CONSTANT" description="Rate of being immune after recovery from infection." unit="per week"/>
  <parameters name="j" expression="1/(15*52)" type="CONSTANT" description="Maturation rate from child to adult." unit="per week"/>
  <parameters name="e" expression="0.2" type="CONSTANT" description="Vaccine ineffectiveness (1-e is the effectiveness)." unit="dimensionless"/>
  <parameters name="hA" expression="0" type="CONSTANT" description="Rate of being immune for vaccinated adults." unit="per week"/>
  <parameters name="hU" expression="3e-6" type="CONSTANT" description="Rate of being immune for un-monitored vaccinated children." unit="per week"/>
  <parameters name="hM" expression="0.167" type="CONSTANT" description="Rate of being immune for monitored vaccinated children." unit="per week"/>
  <parameters name="d" expression="0.7" type="CONSTANT" description="Progression rate from exposed to infectious (inverse of incubation period)." unit="per week"/>
  <parameters name="δ" expression="9.3399e-05" type="CONSTANT" description="Disease induced death rate." unit="per week"/>
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible children into the un-monitored program."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Vaccination of susceptible children into the monitored program."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Infection of susceptible children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Maturation of susceptible children into the adult population."/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Breakthrough infection of un-monitored vaccinated children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Development of immunity in un-monitored vaccinated children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Maturation of un-monitored vaccinated children into the vaccinated adult population."/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Breakthrough infection of monitored vaccinated children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Development of immunity in monitored vaccinated children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Maturation of monitored vaccinated children into the vaccinated adult population."/>
  </compartments>
  <compartments PrimaryName="Exposed Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.4" description="Progression from exposed to infectious state for children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.8" description="Maturation of exposed children into the adult population."/>
  </compartments>
  <compartments PrimaryName="Infectious Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Recovery of infectious children."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.9" description="Maturation of infectious children into the adult population."/>
  </compartments>
  <compartments PrimaryName="Recovered Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.10" description="Maturation of recovered children into the adult population."/>
  </compartments>
  <compartments PrimaryName="Susceptible Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Vaccination of susceptible adults."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.0" target="//@compartments.8" description="Infection of susceptible adults."/>
  </compartments>
  <compartments PrimaryName="Vaccinated Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.0" target="//@compartments.8" description="Breakthrough infection of vaccinated adults."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.10" description="Development of immunity in vaccinated adults."/>
  </compartments>
  <compartments PrimaryName="Exposed Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.9" description="Progression from exposed to infectious state for adults."/>
  </compartments>
  <compartments PrimaryName="Infectious Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.10" description="Recovery of infectious adults."/>
  </compartments>
  <compartments PrimaryName="Recovered Adults" population="0"/>
</compartmental:CompartmentalModel>
