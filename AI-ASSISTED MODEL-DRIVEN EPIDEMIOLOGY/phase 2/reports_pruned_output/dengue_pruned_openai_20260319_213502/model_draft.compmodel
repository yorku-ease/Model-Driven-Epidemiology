<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="constant" type="CONSTANT" description="The constant influx rate of the human hosts." unit="individuals/time"/>
  <parameters name="k(a)" expression="age-dependent" type="CONSTANT" description="The rate at which exposed humans become infectious." unit="1/time"/>
  <parameters name="μh" expression="constant" type="CONSTANT" description="The natural death rate of the human hosts." unit="1/time"/>
  <parameters name="μv" expression="constant" type="CONSTANT" description="The natural death rate of the mosquitoes." unit="1/time"/>
  <parameters name="γ1(a)" expression="age-dependent" type="CONSTANT" description="The recovery rate of symptomatic infectious hosts." unit="1/time"/>
  <parameters name="γ2(a)" expression="age-dependent" type="CONSTANT" description="The recovery rate of asymptomatic infectious hosts." unit="1/time"/>
  <parameters name="βv(a)" expression="age-dependent" type="CONSTANT" description="The transmission rate from infectious hosts to susceptible mosquitoes." unit="1/time"/>
  <parameters name="βh(a)" expression="age-dependent" type="CONSTANT" description="The transmission rate from infected mosquitoes to susceptible hosts." unit="1/time"/>
  <parameters name="ρ" expression="0 &lt; ρ &lt; 1" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts." unit="dimensionless"/>
  <parameters name="σ" expression="constant" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Susceptible humans become exposed through bites by infected mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Exposed humans become asymptomatic infectious at a rate dependent on age."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Exposed humans become symptomatic infectious at a rate dependent on age."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Asymptomatic infectious humans recover at an age-specific rate."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Asymptomatic infectious humans can be reinfected and become symptomatic infectious."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Symptomatic infectious humans recover at an age-specific rate."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Susceptible mosquitoes become infectious after biting infectious humans."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
