<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="A" expression="2" type="CONSTANT" description="Recruitment rate of susceptible individuals" unit="per year"/>
  <parameters name="β" expression="0.75" type="CONSTANT" description="Transmission rate" unit="per year"/>
  <parameters name="μ" expression="0.02" type="CONSTANT" description="Natural death rate" unit="per year"/>
  <parameters name="u" expression="0.3" type="CONSTANT" description="Vaccination rate" unit="per year"/>
  <parameters name="θ" expression="0.1" type="CONSTANT" description="Rate of vaccine wane" unit="per year"/>
  <parameters name="σ" expression="0.8" type="CONSTANT" description="Efficacy of the vaccine" unit="dimensionless"/>
  <parameters name="ε" expression="0.5" type="CONSTANT" description="Factor for susceptibility of recovered individuals" unit="dimensionless"/>
  <parameters name="γ" expression="0.2" type="CONSTANT" description="Recovery rate" unit="per year"/>
  <parameters name="ω" expression="0.01" type="CONSTANT" description="Rate of waning natural immunity" unit="per year"/>
  <parameters name="d" expression="0.05" type="CONSTANT" description="Disease-induced death rate" unit="per year"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible individuals"/>
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning of vaccine-induced immunity"/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0"/>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning of natural immunity, leading to susceptibility"/>
  </compartments>
</compartmental:CompartmentalModel>
