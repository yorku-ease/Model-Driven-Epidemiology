<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="L" expression="N/A" type="CONSTANT" description="Recruitment rate to children group" unit="N/A"/>
  <parameters name="xU" expression="0.087" type="CONSTANT" description="Un-monitored children vaccination rate" unit="N/A"/>
  <parameters name="xM" expression="4.77e-5" type="CONSTANT" description="Monitored children vaccination rate" unit="N/A"/>
  <parameters name="xA" expression="0" type="CONSTANT" description="Adult vaccination rate" unit="N/A"/>
  <parameters name="bC" expression="0.00188" type="CONSTANT" description="Transmission rate among children" unit="N/A"/>
  <parameters name="bA" expression="1.00e-5" type="CONSTANT" description="Transmission rate among adults" unit="N/A"/>
  <parameters name="m" expression="1/(72*52)" type="CONSTANT" description="Natural death rate" unit="N/A"/>
  <parameters name="g" expression="1/2" type="CONSTANT" description="Rate of being immune after recovery" unit="N/A"/>
  <parameters name="j" expression="1/(15*52)" type="CONSTANT" description="Maturation rate" unit="N/A"/>
  <parameters name="e" expression="0.2" type="CONSTANT" description="Effectiveness of the vaccination" unit="N/A"/>
  <parameters name="hA" expression="0" type="CONSTANT" description="Rate of being immune of un-monitored vaccinated adults" unit="N/A"/>
  <parameters name="hU" expression="3e-6" type="CONSTANT" description="Rate of being immune of un-monitored vaccinated children" unit="N/A"/>
  <parameters name="hM" expression="0.167" type="CONSTANT" description="Rate of being immune of monitored vaccinated children" unit="N/A"/>
  <parameters name="d" expression="0.7" type="CONSTANT" description="Incubation period" unit="N/A"/>
  <parameters name="q" expression="0.15" type="CONSTANT" description="N/A" unit="N/A"/>
  <parameters name="a" expression="0.01253" type="CONSTANT" description="N/A" unit="N/A"/>
  <compartments PrimaryName="Susceptible Children" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Transmission of measles to susceptible children."/>
  </compartments>
  <compartments PrimaryName="Infectious Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Recovery from measles infection in children."/>
  </compartments>
  <compartments PrimaryName="Recovered Children" population="0"/>
  <compartments PrimaryName="Un-monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Immunity acquisition in un-monitored vaccinated children."/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated Children" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Immunity acquisition in monitored vaccinated children."/>
  </compartments>
  <compartments PrimaryName="Susceptible Adults" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Transmission of measles to susceptible adults."/>
  </compartments>
  <compartments PrimaryName="Infectious Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Recovery from measles infection in adults."/>
  </compartments>
  <compartments PrimaryName="Recovered Adults" population="0"/>
  <compartments PrimaryName="Vaccinated Adults" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Immunity acquisition in vaccinated adults."/>
  </compartments>
</compartmental:CompartmentalModel>
