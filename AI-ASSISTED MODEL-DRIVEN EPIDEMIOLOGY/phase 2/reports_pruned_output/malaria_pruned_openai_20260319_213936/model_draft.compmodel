<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="π" expression="0.012" type="CONSTANT" description="Human population birth rate." unit="per day"/>
  <parameters name="k" expression="0.60—0.90" type="CONSTANT" description="Vaccination rate."/>
  <parameters name="µ1" expression="0.0002" type="CONSTANT" description="Human population natural death rate." unit="per day"/>
  <parameters name="θ" expression="0.1—0.2" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure."/>
  <parameters name="ε" expression="0.3—0.5" type="CONSTANT" description="Rate of vaccine efficacy."/>
  <parameters name="ηV" expression="0.001—0.005" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected mosquitoes." unit="per day"/>
  <parameters name="ηS" expression="0.005—0.02" type="CONSTANT" description="Effective contact rate of susceptible humans with infected mosquitoes." unit="per day"/>
  <parameters name="ξV" expression="0.0005—0.002" type="CONSTANT" description="Effective contact rate of vaccinated humans through non-vector pathways." unit="per day"/>
  <parameters name="ξS" expression="0.001—0.003" type="CONSTANT" description="Effective contact rate of susceptible humans through non-vector pathways." unit="per day"/>
  <parameters name="τ1" expression="0.05" type="CONSTANT" description="Progression rate from exposed to infectious in humans (vector pathway)." unit="per day"/>
  <parameters name="τ2" expression="0.05" type="CONSTANT" description="Progression rate from exposed to infectious in mosquitoes." unit="per day"/>
  <parameters name="σ" expression="0.10" type="CONSTANT" description="Treatment rate for infectious humans." unit="per day"/>
  <parameters name="ω" expression="0.05" type="CONSTANT" description="Recovery rate from malaria infection." unit="per day"/>
  <parameters name="γ" expression="0.01" type="CONSTANT" description="Rate of immunity loss in recovered humans." unit="per day"/>
  <parameters name="δ1" expression="0.002" type="CONSTANT" description="Death rate due to malaria." unit="per day"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.5" target="//@compartments.2" description="Transmission from infectious mosquitoes to susceptible humans."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.5" target="//@compartments.3" description="Transmission through non-vector pathways such as blood transfusions."/>
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.5" target="//@compartments.2" description="Transmission from infectious mosquitoes to vaccinated humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans (Vector)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.12" target="//@compartments.4" description="Progression from exposed to infectious state in humans (vector pathway)."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans (Non-Vector)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.12" target="//@compartments.4" description="Progression from exposed to infectious state in humans (non-vector pathway)."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Humans receiving treatment for malaria."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.6" description="Recovery from malaria infection."/>
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0"/>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.5" target="//@compartments.8" description="Transmission from infectious humans to susceptible mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.12" target="//@compartments.9" description="Progression from exposed to infectious state in mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
