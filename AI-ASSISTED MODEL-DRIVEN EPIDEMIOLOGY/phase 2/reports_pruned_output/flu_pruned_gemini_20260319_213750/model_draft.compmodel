<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="1" type="CONSTANT" description="Daily rate of transition from E1 to E2 and from E2 to I1." unit="per day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Daily rate of transition from I1 to I2 and from I2 to R." unit="per day"/>
  <parameters name="β" expression="0.0" type="CONSTANT" description="The constant transmission rate (the rate at which new infections take place given a contact)."/>
  <parameters name="N2012/13" expression="53679750" type="CONSTANT" description="Population of 2012/13." unit="people"/>
  <parameters name="N2013/14" expression="54091200" type="CONSTANT" description="Population of 2013/14." unit="people"/>
  <parameters name="N2014/15" expression="54551450" type="CONSTANT" description="Population of 2014/15." unit="people"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Rate at which a person becomes infected, λ(t), assumed to be proportional to the number of infectious people (I1 + I2) and the constant transmission rate β."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Transition from the first to the second exposed compartment at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Transition from the second exposed compartment to the first infectious compartment at a daily rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Transition from the first to the second infectious compartment at a daily rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.5" description="Transition from the second infectious compartment to the recovered compartment at a daily rate γ."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
