<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="B" expression="0.0" type="CONSTANT" description="The constant influx rate of the human hosts."/>
  <parameters name="k(a)" expression="0.0" type="CONSTANT" description="The age-specific rate of progression from exposed to infectious (inverse of the latent period)."/>
  <parameters name="μh" expression="0.0" type="CONSTANT" description="The natural death rate of the human hosts."/>
  <parameters name="μv" expression="0.0" type="CONSTANT" description="The natural death rate of the mosquitoes."/>
  <parameters name="γ1(a)" expression="0.0" type="CONSTANT" description="The age-specific recovery rate of symptomatic infectious hosts."/>
  <parameters name="γ2(a)" expression="0.0" type="CONSTANT" description="The age-specific recovery rate of asymptomatic infectious hosts."/>
  <parameters name="βv(a)" expression="0.0" type="CONSTANT" description="The age-specific transmission rate from infectious hosts to susceptible mosquitoes."/>
  <parameters name="βh(a)" expression="0.0" type="CONSTANT" description="The age-specific transmission rate from infected mosquitoes to susceptible hosts."/>
  <parameters name="ρ" expression="0.0" type="CONSTANT" description="The probability of exposed hosts transferring to symptomatic infectious hosts."/>
  <parameters name="σ" expression="0.0" type="CONSTANT" description="The factor characterizing the intensity of reinfection of asymptomatic infectious hosts."/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Transmission of dengue from infectious mosquitoes to susceptible humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Progression from the exposed state to the asymptomatic infectious state with probability 1-ρ."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Progression from the exposed state to the symptomatic infectious state with probability ρ."/>
  </compartments>
  <compartments PrimaryName="Asymptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Recovery of asymptomatic infectious individuals."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Reinfection of asymptomatic individuals through mosquito bites, leading to a symptomatic infection."/>
  </compartments>
  <compartments PrimaryName="Symptomatic Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.4" description="Recovery of symptomatic infectious individuals."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.6" contactRateParameter="//@parameters.0" target="//@compartments.6" description="Transmission of dengue from infectious humans to susceptible mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
