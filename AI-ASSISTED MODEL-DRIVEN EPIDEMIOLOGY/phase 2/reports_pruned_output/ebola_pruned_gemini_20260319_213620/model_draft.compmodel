<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="α1" expression="10" type="CONSTANT" description="The rate of contact (effective) of infected human." unit="N/A"/>
  <parameters name="d" expression="0.0015" type="CONSTANT" description="Rate of deaths of human individuals due to infection." unit="N/A"/>
  <parameters name="α2" expression="3" type="CONSTANT" description="The rate contact of Ebola virus pathogens in the environment." unit="N/A"/>
  <parameters name="ψ1" expression="0.006" type="CONSTANT" description="The rate at which infected people quarantined." unit="N/A"/>
  <parameters name="ψ2" expression="0.0012" type="CONSTANT" description="The rate at which quarantined people are recovered." unit="N/A"/>
  <parameters name="b" expression="0" type="CONSTANT" description="The proportion rate of burial deceased people." unit="N/A"/>
  <parameters name="ψ3" expression="0.006" type="CONSTANT" description="The rate at which quarantine people are in deceased." unit="N/A"/>
  <parameters name="c" expression="0.8" type="CONSTANT" description="The proportion rate of burial deceased people." unit="N/A"/>
  <parameters name="ε" expression="0.5" type="CONSTANT" description="Rate at which shedding of infected humans." unit="N/A"/>
  <parameters name="h" expression="0.04" type="CONSTANT" description="proportion of shedding of deceased people." unit="N/A"/>
  <parameters name="ρ1" expression="0.123" type="CONSTANT" description="The rate at which EVD in the environment decays." unit="N/A"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.1" target="//@compartments.1" description="Infection of susceptible individuals from effective contact with infectious humans."/>
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Rate at which infected people are quarantined."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.5" description="Shedding of virus into the environment by infected humans."/>
  </compartments>
  <compartments PrimaryName="Quarantined" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.3" description="Rate at which quarantined people recover."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
  <compartments PrimaryName="Dead" population="0"/>
  <compartments PrimaryName="Pathogen in Environment" population="0"/>
</compartmental:CompartmentalModel>
