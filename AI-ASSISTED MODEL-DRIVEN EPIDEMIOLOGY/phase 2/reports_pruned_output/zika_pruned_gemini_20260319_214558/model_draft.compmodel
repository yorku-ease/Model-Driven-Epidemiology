<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="Number of infectious bites delivered per vector per day" expression="0.071 or 0.09" type="CONSTANT" description="Effective biting rate of vectors. The paper uses different values for two simulated locations." unit="per day"/>
  <parameters name="Human population growth rate" expression="0.00005" type="CONSTANT" description="Intrinsic growth rate for the human population, used in the logistic growth model." unit="per day"/>
  <parameters name="Carrying capacity for human population" expression="30,000,000 or 120,000" type="CONSTANT" description="Maximum sustainable human population for the two simulated locations." unit="individuals"/>
  <parameters name="Human incubation rate" expression="0.333" type="CONSTANT" description="Rate at which exposed humans become infectious, corresponding to an incubation time of 3 days." unit="per day"/>
  <parameters name="Human recovery rate" expression="0.143" type="CONSTANT" description="Rate at which infectious humans recover, corresponding to a recovery time of 7 days." unit="per day"/>
  <parameters name="Vector incubation rate" expression="0.1" type="CONSTANT" description="Rate at which exposed vectors become infectious, corresponding to an incubation time of 10 days." unit="per day"/>
  <parameters name="Oviposition rate" expression="80" type="CONSTANT" description="Number of eggs laid per female mosquito per day." unit="eggs per female per day"/>
  <parameters name="Egg development rate" expression="0.333" type="CONSTANT" description="Rate at which eggs develop into larvae, corresponding to a development time of 3 days." unit="per day"/>
  <parameters name="Natural egg mortality rate" expression="0.05" type="CONSTANT" description="Natural mortality rate of mosquito eggs." unit="per day"/>
  <parameters name="Larval development rate" expression="0.111" type="CONSTANT" description="Rate at which larvae develop into pupae, corresponding to a development time of 9 days." unit="per day"/>
  <parameters name="Natural larval mortality rate" expression="0.025" type="CONSTANT" description="Natural mortality rate of mosquito larvae." unit="per day"/>
  <parameters name="Carrying capacity for larvae" expression="100,000,000 or 5,000,000" type="CONSTANT" description="Maximum sustainable mosquito larvae population for the two simulated locations." unit="larvae"/>
  <parameters name="Density-dependent larval mortality rate" expression="1" type="CONSTANT" description="Additional mortality rate for larvae due to competition and limited carrying capacity." unit="per day"/>
  <parameters name="Pupal development rate" expression="0.333" type="CONSTANT" description="Rate at which pupae develop into adults, corresponding to a development time of 3 days." unit="per day"/>
  <parameters name="Natural pupal mortality rate" expression="0.0025" type="CONSTANT" description="Natural mortality rate of mosquito pupae." unit="per day"/>
  <parameters name="Adult mosquito mortality rate" expression="0.05" type="CONSTANT" description="Natural mortality rate of adult mosquitoes." unit="per day"/>
  <parameters name="Female adult percentage" expression="0.68" type="CONSTANT" description="Proportion of emerging adult mosquitoes that are female." unit="dimensionless"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Infection of susceptible humans by infectious mosquitoes through bites."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.2" description="Progression of exposed humans to the infectious state after the incubation period."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.3" description="Recovery of infectious humans, who then become immune."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0"/>
  <compartments PrimaryName="Vector Eggs" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Hatching of mosquito eggs into the larval stage."/>
  </compartments>
  <compartments PrimaryName="Vector Larvae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Maturation of mosquito larvae into the pupal stage."/>
  </compartments>
  <compartments PrimaryName="Vector Pupae" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Emergence of adult female mosquitoes from the pupal stage."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRate="0.0" target="//@compartments.8" description="Infection of susceptible mosquitoes by biting infectious humans."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Oviposition (egg laying) by susceptible adult female mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.3" target="//@compartments.9" description="Progression of exposed mosquitoes to the infectious state after the incubation period."/>
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Oviposition (egg laying) by exposed adult female mosquitoes."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Oviposition (egg laying) by infectious adult female mosquitoes."/>
  </compartments>
</compartmental:CompartmentalModel>
