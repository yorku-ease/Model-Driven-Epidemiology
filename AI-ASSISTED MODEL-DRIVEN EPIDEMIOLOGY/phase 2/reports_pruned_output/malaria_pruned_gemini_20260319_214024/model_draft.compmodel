<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="π" expression="0.012" type="CONSTANT" description="Human and mosquito population birth rate." unit="per day"/>
  <parameters name="k" expression="0.60—0.90" type="CONSTANT" description="Vaccination rate."/>
  <parameters name="µ1" expression="0.0002" type="CONSTANT" description="Human population natural death rate." unit="per day"/>
  <parameters name="µ2" expression="0.1" type="CONSTANT" description="Mosquito population natural death rate." unit="per day"/>
  <parameters name="θ" expression="0.1—0.2" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure."/>
  <parameters name="ε" expression="0.3—0.5" type="CONSTANT" description="Vaccine efficacy."/>
  <parameters name="ηV" expression="0.001—0.005" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected mosquitoes through bloodmeals." unit="per day"/>
  <parameters name="ηS" expression="0.005—0.02" type="CONSTANT" description="Effective contact rate of susceptible humans with infected mosquitoes through bloodmeals." unit="per day"/>
  <parameters name="ξV" expression="0.0005—0.002" type="CONSTANT" description="Effective contact rate for non-vector transmission to vaccinated humans from infectious humans." unit="per day"/>
  <parameters name="ξS" expression="0.001—0.003" type="CONSTANT" description="Effective contact rate for non-vector transmission to susceptible humans from infectious humans." unit="per day"/>
  <parameters name="τ1" expression="0.05" type="CONSTANT" description="Progression rate from vector-exposed to infectious for humans." unit="per day"/>
  <parameters name="τ2" expression="0.05" type="CONSTANT" description="Progression rate from non-vector-exposed to infectious for humans." unit="per day"/>
  <parameters name="σ" expression="0.10" type="CONSTANT" description="Treatment rate for infectious humans." unit="per day"/>
  <parameters name="ω" expression="0.05" type="CONSTANT" description="Recovery rate for treated humans." unit="per day"/>
  <parameters name="γ" expression="0.01" type="CONSTANT" description="Rate of natural immunity loss." unit="per day"/>
  <parameters name="δ1" expression="0.002" type="CONSTANT" description="Malaria-induced death rate for humans." unit="per day"/>
  <parameters name="beta_h" expression="0.02" type="CONSTANT" description="Rate of mosquito infection by infectious humans (represented by β in the paper)." unit="per day"/>
  <parameters name="beta_m" expression="0.10" type="CONSTANT" description="Progression rate of exposed mosquitoes to infectious (represented by β in the paper)." unit="per day"/>
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.1" description="Vaccination of susceptible individuals."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Infection of susceptible humans by infectious mosquitoes through bloodmeals."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Non-vector transmission from infectious humans to susceptible humans."/>
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.0" description="Loss of vaccine-induced immunity due to vaccine failure."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Infection of vaccinated humans by infectious mosquitoes through bloodmeals, with reduced susceptibility due to vaccine efficacy."/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Non-vector transmission from infectious humans to vaccinated humans, with reduced susceptibility due to vaccine efficacy."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans (Vector-borne)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.4" description="Progression from exposed (vector-borne) to infectious state."/>
  </compartments>
  <compartments PrimaryName="Exposed Humans (Non-vector)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.4" description="Progression from exposed (non-vector) to infectious state."/>
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.5" description="Infectious individuals beginning treatment."/>
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.6" description="Treated individuals recovering from malaria."/>
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.0" description="Loss of natural immunity."/>
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.6" target="//@compartments.8" description="Infection of susceptible mosquitoes by biting infectious humans."/>
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.9" description="Progression of exposed mosquitoes to infectious state."/>
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0"/>
</compartmental:CompartmentalModel>
