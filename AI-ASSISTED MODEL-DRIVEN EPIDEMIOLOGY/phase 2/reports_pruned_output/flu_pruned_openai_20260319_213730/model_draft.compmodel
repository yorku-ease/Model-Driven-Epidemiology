<?xml version="1.0" ?>
<compartmental:CompartmentalModel xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel" xmi:version="2.0">
  <parameters name="σ" expression="1" type="CONSTANT" description="Rate of transition from Exposed 1 to Exposed 2 and from Exposed 2 to Infectious 1." unit="per day"/>
  <parameters name="γ" expression="0.5797" type="CONSTANT" description="Rate of transition from Infectious 1 to Infectious 2 and from Infectious 2 to Recovered." unit="per day"/>
  <parameters name="β" expression="not specified" type="CONSTANT" description="Transmission rate at which new infections take place given a contact." unit="per contact per day"/>
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Infection occurs at a rate proportional to the number of infectious individuals and the transmission rate."/>
  </compartments>
  <compartments PrimaryName="Exposed 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.2" description="Transition from the first to the second stage of incubation at rate σ."/>
  </compartments>
  <compartments PrimaryName="Exposed 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Transition from the second stage of incubation to the first stage of being infectious at rate σ."/>
  </compartments>
  <compartments PrimaryName="Infectious 1" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.4" description="Transition from the first to the second stage of being infectious at rate γ."/>
  </compartments>
  <compartments PrimaryName="Infectious 2" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.5" description="Recovery from the second stage of being infectious at rate γ."/>
  </compartments>
  <compartments PrimaryName="Recovered" population="0"/>
</compartmental:CompartmentalModel>
