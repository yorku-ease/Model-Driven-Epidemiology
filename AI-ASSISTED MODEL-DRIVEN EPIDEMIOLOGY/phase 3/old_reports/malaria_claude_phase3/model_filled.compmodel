<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="I" expression="0" type="CONSTANT" />
  <parameters name="R" expression="0" type="CONSTANT" />
  <parameters name="S" expression="0" type="CONSTANT" />
  <parameters name="N" expression="0" type="CONSTANT" />
  <parameters name="Es" expression="2" type="CONSTANT" />
  <parameters name="g" expression="1" type="CONSTANT" />
  <parameters name="A" expression="1" type="CONSTANT" />
  <parameters name="V" expression="50" type="CONSTANT" />
  <parameters name="E" expression="30" type="CONSTANT" />
  <parameters name="π" expression="0.0" type="CONSTANT" description="Human Population birth rate" />
  <parameters name="θ" expression="0.0" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure" />
  <parameters name="ε" expression="0.0" type="CONSTANT" description="Rate of Vaccine Efficacy" />
  <parameters name="ηV" expression="0.0" type="CONSTANT" description="Effective contact rate of Human Vaccinated individuals with infected mosquitoes through bloodmeals" />
  <parameters name="ηS" expression="0.0" type="CONSTANT" description="Effective contact rate of Human susceptible individuals with infected mosquitoes through bloodmeals" />
  <parameters name="ξV" expression="0.0" type="CONSTANT" description="Effective contact rate of Human Vaccinated individuals with infected humans through other non-mosquitoes' ways (non-vector pathways) of malaria infectivity" />
  <parameters name="ξS" expression="0.0" type="CONSTANT" description="Effective contact rate of Human susceptible individuals with infected human through other non-mosquitos' ways (non-vector pathways) of malaria infectivity" />
  <parameters name="τ1" expression="0.0" type="CONSTANT" description="Human Population Progression rate from exposed to infectious for mosquitos' malaria exposed individuals" />
  <parameters name="τ2" expression="0.0" type="CONSTANT" description="Human Population Progression rate from exposed to infectious for non-mosquitos' (non-vector pathways) malaria exposed individuals" />
  <parameters name="δ1" expression="0.0" type="CONSTANT" description="Human Population Malaria disease death rate" />
  <parameters name="σ" expression="0.0" type="CONSTANT" description="Human Population progression rate from infected to treated" />
  <parameters name="ω" expression="0.0" type="CONSTANT" description="Human Population progression rate from treated to recovered" />
  <parameters name="γ" expression="0.0" type="CONSTANT" description="Human recovered Population rate of immunity loss" />
  <parameters name="ρ" expression="0.0" type="CONSTANT" description="Effective contact rate of susceptible mosquitoes with infected humans through bloodmeals" />
  <parameters name="φ" expression="0.0" type="CONSTANT" description="Mosquitoes Population Progression rate from exposed to infectious" />
  <parameters name="β1" expression="0.0" type="CONSTANT" description="Active contact rate of vaccinated humans with infectious vector, defined as β1 = ηV * IM" />
  <parameters name="β2" expression="0.0" type="CONSTANT" description="Active contact rate of susceptible humans with infectious vector, defined as β2 = ηS * IM" />
  <parameters name="α1" expression="0.0" type="CONSTANT" description="Active contact rate of vaccinated humans with infectious non-vector ways, defined as α1 = ξV * IH" />
  <parameters name="α2" expression="0.0" type="CONSTANT" description="Active contact rate of susceptible humans with infectious non-vector ways, defined as α2 = ξS * IH" />
  <parameters name="β3" expression="0.0" type="CONSTANT" description="Effective contact rate of susceptible mosquitoes with infected humans, defined as β3 = ρ * IH" />
  <parameters name="R0" expression="0.0" type="CONSTANT" description="Basic reproduction number of the malaria model, computed via next generation method" unit="dimensionless" />
  <parameters name="R01" expression="0.0" type="CONSTANT" description="Component of R0 related to non-vector transmission: R01 = ξS * π * τ2 / [µ1 * (µ1+τ2) * (µ1+δ1+σ)]" unit="dimensionless" />
  <parameters name="R02" expression="0.0" type="CONSTANT" description="Component of R0 related to vector-borne transmission (human to mosquito side): R02 = ηS * π * τ1 / [µ1 * (µ1+τ1) * (µ1+δ1+σ)]" unit="dimensionless" />
  <parameters name="R03" expression="0.0" type="CONSTANT" description="Component of R0 related to vector-borne transmission (mosquito side): R03 = ρ * Λ * φ / [µ2^2 * (µ2+φ)]" unit="dimensionless" />
  <parameters name="q" expression="0.98765" type="CONSTANT" unit="1/time" description="Progression rate of Rh to Sh" />
  <parameters name="μₕ" expression="0.001384" type="CONSTANT" unit="1/time" description="Natural mortality rate of human population" />
  <parameters name="μᵥ(t)" expression="1" type="CONSTANT" unit="1/time" description="Mortality rate of adult mosquitoes" />
  <parameters name="k" expression="100000" type="CONSTANT" unit="mosquitoes" description="Mosquito carrying capacity" />
  <compartments PrimaryName="H" population="0" />
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Susceptible humans exposed to malaria through infectious mosquito bites" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.0" target="//@compartments.4" description="Susceptible humans exposed to malaria through non-vector pathways" />
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Loss of vaccine immunity, vaccinated humans return to susceptible class" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Vaccinated humans exposed to malaria through infectious mosquito bites" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.4" contactRateParameter="//@parameters.0" target="//@compartments.4" description="Vaccinated humans exposed to malaria through non-vector pathways" />
  </compartments>
  <compartments PrimaryName="Vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" />
  </compartments>
  <compartments PrimaryName="Non-vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.5" description="Progression from non-vector exposed to infectious at rate τ2" />
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Infectious humans receive treatment at rate σ" />
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="Treated humans recover at rate ω" />
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Loss of immunity in recovered humans, relapse to susceptible class" />
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.0" target="//@compartments.9" description="Susceptible mosquitoes become exposed through contact with infectious humans" />
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.10" description="Exposed mosquitoes progress to infectious at rate φ" />
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0" />
</ns0:CompartmentalModel>