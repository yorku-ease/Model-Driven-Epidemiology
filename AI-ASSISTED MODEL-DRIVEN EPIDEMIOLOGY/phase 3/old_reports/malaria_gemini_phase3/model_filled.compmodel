<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="π" expression="0.012" type="CONSTANT" description="Human Population birth rate" unit="per day" />
  <parameters name="k" expression="0.60-0.90" type="CONSTANT" description="Vaccination rate" />
  <parameters name="θ" expression="0.1-0.2" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure" unit="per day" />
  <parameters name="ε" expression="0.3-0.5" type="CONSTANT" description="Rate of Vaccine Efficacy" />
  <parameters name="ηV" expression="0.001-0.005" type="CONSTANT" description="Effective contact rate of Human Vaccinated individuals with infected mosquitoes through bloodmeals" unit="per day" />
  <parameters name="ηS" expression="0.005-0.02" type="CONSTANT" description="Effective contact rate of Human susceptible individuals with infected mosquitoes through bloodmeals" unit="per day" />
  <parameters name="ξV" expression="0.0005-0.002" type="CONSTANT" description="Effective contact rate of Human Vaccinated individuals with infected humans through other non-mosquitoes’ ways (non-vector pathways) of malaria infectivity" unit="per day" />
  <parameters name="ξS" expression="0.001-0.003" type="CONSTANT" description="Effective contact rate of Human susceptible individuals with infected human through other non-mosquitos’ ways (non-vector pathways) of malaria infectivity" unit="per day" />
  <parameters name="τ1" expression="0.05" type="CONSTANT" description="Human Population Progression rate from exposed to infectious for mosquitos’ malaria exposed individuals" unit="per day" />
  <parameters name="τ2" expression="0.05" type="CONSTANT" description="Human Population Progression rate from exposed to infectious for non-mosquitos’ (non-vector pathways) malaria exposed individuals" unit="per day" />
  <parameters name="δ1" expression="0.002" type="CONSTANT" description="Human Population Malaria disease death rate" unit="per day" />
  <parameters name="σ" expression="0.10" type="CONSTANT" description="Human Population progression rate from infected to treated" unit="per day" />
  <parameters name="ω" expression="0.05" type="CONSTANT" description="Human Population progression rate from treated to recovered" unit="per day" />
  <parameters name="γ" expression="0.01" type="CONSTANT" description="Human recovered Population rate of immunity loss" unit="per day" />
  <parameters name="ρ" expression="0.01-0.05" type="CONSTANT" description="Effective contact rate of susceptible mosquitoes with infected humans through bloodmeals" unit="per mosquito" />
  <parameters name="φ" expression="0.0" type="CONSTANT" description="Mosquitoes Population Progression rate from exposed to infectious" />
  <parameters name="αₕ" expression="15129" type="CONSTANT" unit="people/time" description="Recruitment rate of human populations" />
  <parameters name="q" expression="0.98765" type="CONSTANT" unit="1/time" description="Progression rate of Rh to Sh" />
  <parameters name="β₁" expression="0.9969" type="CONSTANT" unit="dimensionless" description="Probability of transmission (human)" />
  <parameters name="μₕ" expression="0.001384" type="CONSTANT" unit="1/time" description="Natural mortality rate of human population" />
  <parameters name="a(t)" expression="0.000203" type="CONSTANT" unit="bites/person/time" description="Mosquito biting rate" />
  <parameters name="μᵥ(t)" expression="1" type="CONSTANT" unit="1/time" description="Mortality rate of adult mosquitoes" />
  <parameters name="μₕ+δ" expression="0.017325" type="CONSTANT" unit="1/time" description="Disease-induced death rate" />
  <parameters name="nᵥ" expression="80000" type="CONSTANT" unit="mosquitoes" description="Approx. Mosquito population" />
  <parameters name="λₘ(t)" expression="0.000203" type="CONSTANT" unit="bites/person/time" description="Mosquito biting rate" />
  <compartments PrimaryName="Malaria Susceptible Human" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.5" target="//@compartments.2" description="Infection of susceptible humans by infectious mosquitoes at rate β2 = ηS * I_M." />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.7" target="//@compartments.3" description="Infection of susceptible humans through non-vector pathways from infectious humans at rate α2 = ξS * I_H." />
  </compartments>
  <compartments PrimaryName="Malaria Vaccinated Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.0" description="Loss of vaccine-induced immunity at rate θ." />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.1" target="//@compartments.2" description="Infection of vaccinated humans by infectious mosquitoes (breakthrough infection) at rate β1 * ε = ηV * I_M * ε." />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Infection of vaccinated humans through non-vector pathways from infectious humans at rate α1 = ξV * I_H." />
  </compartments>
  <compartments PrimaryName="Malaria vector Exposed Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.4" description="Progression from vector-exposed to infectious at rate τ1." />
  </compartments>
  <compartments PrimaryName="Malaria non-vector Exposed Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.4" description="Progression from non-vector-exposed to infectious at rate τ2." />
  </compartments>
  <compartments PrimaryName="Malaria Infectious Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.11" target="//@compartments.5" description="Progression from infectious to treated at rate σ." />
  </compartments>
  <compartments PrimaryName="Malaria Treated Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.12" target="//@compartments.6" description="Progression from treated to recovered at rate ω." />
  </compartments>
  <compartments PrimaryName="Malaria Recovered Human" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.0" description="Loss of natural immunity at rate γ." />
  </compartments>
  <compartments PrimaryName="Malaria Susceptible Mosquito" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.14" target="//@compartments.8" description="Infection of susceptible mosquitoes by biting infectious humans at rate β3 = ρ * I_H." />
  </compartments>
  <compartments PrimaryName="Malaria Exposed Mosquito" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.15" target="//@compartments.9" description="Progression from exposed to infectious in mosquitoes at rate φ." />
  </compartments>
  <compartments PrimaryName="Malaria Infectious Mosquito" population="0" />
</ns0:CompartmentalModel>