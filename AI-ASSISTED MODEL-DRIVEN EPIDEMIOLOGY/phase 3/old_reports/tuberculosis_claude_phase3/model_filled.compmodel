<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="A" expression="1000/(65*12)" type="CONSTANT" description="Recruitment rate of humans" unit="humans per month" />
  <parameters name="β" expression="0.01-5" type="CONSTANT" description="Probability of successful infection rate" unit="1/(year × human)" />
  <parameters name="ε" expression="0-1" type="CONSTANT" description="Correction parameter for reinfection term" unit="dimensionless" />
  <parameters name="u" expression="0-1" type="CONSTANT" description="Rate of vaccination" unit="1/day" />
  <parameters name="θ" expression="0.067-0.1" type="CONSTANT" description="Vaccine wane rate" unit="1/day" />
  <parameters name="γ" expression="0.5-2" type="CONSTANT" description="Recovery rate" unit="1/year" />
  <parameters name="δ" expression="0.003-0.02" type="CONSTANT" description="Drop out rate due to waning immunity" unit="1/day" />
  <parameters name="μ" expression="1/(65*12)" type="CONSTANT" description="Natural death rate" unit="1/month" />
  <parameters name="π" expression="0" type="CONSTANT" unit="dimensionless" description="Susceptibility; the proportion of the population that is initially susceptible." />
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible individuals at rate u*S" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Recruitment of new susceptible individuals at constant rate A (inflow from birth)" />
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning of vaccine protection, return to susceptible at rate θ*V" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Natural death from vaccinated compartment at rate μ*V (outflow)" />
  </compartments>
  <compartments PrimaryName="Infectious" population="0" />
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.0" description="Waning immunity, return to susceptible at rate δ*R" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Natural death from recovered compartment at rate μ*R (outflow)" />
  </compartments>
</ns0:CompartmentalModel>