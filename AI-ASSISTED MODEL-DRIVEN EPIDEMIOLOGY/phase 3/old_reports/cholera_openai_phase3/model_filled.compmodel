<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="β" expression="varies" type="CONSTANT" description="Contact rate between susceptible individuals and contaminated water." unit="days^-1" />
  <parameters name="γ" expression="varies" type="CONSTANT" description="Recovery rate of infectious individuals." unit="days^-1" />
  <parameters name="δ" expression="varies" type="CONSTANT" description="Decay rate of cholera bacteria in the water." unit="days^-1" />
  <parameters name="κ" expression="varies" type="CONSTANT" description="Concentration of cholera bacteria at which the infection rate is 50% of the maximum." unit="cells/mL" />
  <parameters name="ξ" expression="varies" type="CONSTANT" description="Rate of water contamination by infectious individuals." unit="cells * mL^-1 * person^-1 * day^-1" />
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.1" target="//@compartments.1" description="Susceptible individuals become infected through contact with contaminated water." />
  </compartments>
  <compartments PrimaryName="Infectious" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.2" description="Infectious individuals recover and become immune." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Infectious individuals contaminate the water supply with bacteria." />
  </compartments>
  <compartments PrimaryName="Recovered" population="0" />
  <compartments PrimaryName="Cholera Bacteria in Water" population="0" />
</ns0:CompartmentalModel>