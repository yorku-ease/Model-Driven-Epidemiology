<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="C" expression="333" type="CONSTANT" description="Constant recruitment in susceptible populations" unit="Individuals/year" />
  <parameters name="h" expression="0.48" type="CONSTANT" description="Proportion of men" unit="Nondimensional" />
  <parameters name="c" expression="0.92" type="CONSTANT" description="Proportion of heterosexual men" unit="Nondimensional" />
  <parameters name="p" expression="0.90" type="CONSTANT" description="Proportion of initially treated individuals" unit="Nondimensional" />
  <parameters name="l" expression="0.0129" type="CONSTANT" description="Natural mortality rate" unit="1/year" />
  <parameters name="d" expression="0.3333" type="CONSTANT" description="Induced disease mortality rate (for people with AIDS)" unit="1/year" />
  <parameters name="a" expression="0.3333" type="CONSTANT" description="Departure rate from infected compartments (to treatment)" unit="1/year" />
  <parameters name="b_s" expression="0.02" type="CONSTANT" description="Probability of sexual transmission (heterosexual)" unit="Nondimensional" />
  <parameters name="b_h" expression="0.44" type="CONSTANT" description="Probability of sexual transmission (homosexual)" unit="Nondimensional" />
  <parameters name="b_hw" expression="0.018" type="CONSTANT" description="Probability of sexual transmission (from infected women to homosexual men)" unit="Nondimensional" />
  <parameters name="b_hm" expression="0.25" type="CONSTANT" description="Probability of sexual transmission (from infected homosexual men to women)" unit="Nondimensional" />
  <parameters name="c_s" expression="4" type="CONSTANT" description="Sexual partner rate (heterosexual)" unit="1/year" />
  <parameters name="c_h" expression="7" type="CONSTANT" description="Sexual partner rate (homosexual)" unit="1/year" />
  <parameters name="c_hw" expression="2" type="CONSTANT" description="Sexual partner rate (homosexual men with women)" unit="1/year" />
  <parameters name="c_hm" expression="1" type="CONSTANT" description="Sexual partner rate (homosexual men with women)" unit="1/year" />
  <compartments PrimaryName="Susceptible Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.0" target="//@compartments.1" description="Infection of susceptible homosexual men through contact with untreated infected homosexual men or untreated infected women." />
  </compartments>
  <compartments PrimaryName="Untreated Infected Homosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Departure from infected class to begin antiretroviral therapy." />
  </compartments>
  <compartments PrimaryName="Susceptible Women" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.0" target="//@compartments.3" description="Infection of susceptible women through contact with untreated infected homosexual men or untreated infected heterosexual men." />
  </compartments>
  <compartments PrimaryName="Untreated Infected Women" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Departure from infected class to begin antiretroviral therapy." />
  </compartments>
  <compartments PrimaryName="Susceptible Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRateParameter="//@parameters.0" target="//@compartments.5" description="Infection of susceptible heterosexual men through contact with untreated infected women." />
  </compartments>
  <compartments PrimaryName="Untreated Infected Heterosexual Men" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.6" description="Departure from infected class to begin antiretroviral therapy." />
  </compartments>
  <compartments PrimaryName="Treated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.7" description="AIDS development rate in treated individuals due to ART resistance or treatment failure." />
  </compartments>
  <compartments PrimaryName="People with AIDS" population="0" />
</ns0:CompartmentalModel>