<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="π" expression="0.012" type="CONSTANT" description="Human population birth rate." unit="per day" />
  <parameters name="k" expression="0.60–0.90" type="CONSTANT" description="Vaccination rate / fraction vaccinated at birth." unit="dimensionless" />
  <parameters name="µ1" expression="0.0002" type="CONSTANT" description="Human natural death rate." unit="per day" />
  <parameters name="µ2" expression="0.1" type="CONSTANT" description="Mosquito natural death rate." unit="per day" />
  <parameters name="θ" expression="0.1–0.2" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure." unit="per day" />
  <parameters name="ε" expression="0.3–0.5" type="CONSTANT" description="Vaccine efficacy." unit="dimensionless" />
  <parameters name="ηV" expression="0.001–0.005" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected mosquitoes through blood meals." unit="per day" />
  <parameters name="ηS" expression="0.005–0.02" type="CONSTANT" description="Effective contact rate of susceptible humans with infected mosquitoes through blood meals." unit="per day" />
  <parameters name="ξV" expression="0.0005–0.002" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected humans through non-mosquito pathways." unit="per day" />
  <parameters name="ξS" expression="0.001–0.003" type="CONSTANT" description="Effective contact rate of susceptible humans with infected humans through non-mosquito pathways." unit="per day" />
  <parameters name="τ1" expression="0.05" type="CONSTANT" description="Progression rate from vector-exposed humans to infectious humans." unit="per day" />
  <parameters name="τ2" expression="0.05" type="CONSTANT" description="Progression rate from non-vector-exposed humans to infectious humans." unit="per day" />
  <parameters name="δ1" expression="0.002" type="CONSTANT" description="Human malaria disease death rate." unit="per day" />
  <parameters name="σ" expression="0.10" type="CONSTANT" description="Progression rate from infectious humans to treated humans." unit="per day" />
  <parameters name="ω" expression="0.05" type="CONSTANT" description="Progression rate from treated humans to recovered humans." unit="per day" />
  <parameters name="γ" expression="0.01" type="CONSTANT" description="Recovered human immunity loss rate." unit="per day" />
  <parameters name="ρ" expression="0.01–0.05" type="CONSTANT" description="Effective contact rate of susceptible mosquitoes with infected humans through blood meals." unit="per mosquito" />
  <parameters name="φ" expression="not explicitly listed in table" type="CONSTANT" description="Progression rate from exposed mosquitoes to infectious mosquitoes." unit="per day" />
  <parameters name="β1" expression="ηV I M" type="CONSTANT" description="Force of infection term for vaccinated humans from infected mosquitoes." unit="not specified" />
  <parameters name="β2" expression="ηS I M" type="CONSTANT" description="Force of infection term for susceptible humans from infected mosquitoes." unit="not specified" />
  <parameters name="α1" expression="ξV I H" type="CONSTANT" description="Force of infection term for vaccinated humans from infected humans via non-vector pathways." unit="not specified" />
  <parameters name="α2" expression="ξS I H" type="CONSTANT" description="Force of infection term for susceptible humans from infected humans via non-vector pathways." unit="not specified" />
  <parameters name="β3" expression="ρ I H" type="CONSTANT" description="Force of infection term for susceptible mosquitoes from infected humans." unit="not specified" />
  <parameters name="μ1" expression="0.001384" type="CONSTANT" unit="1/time" description="Natural death rate of humans (μ1)" />
  <parameters name="μ2" expression="0.1" type="CONSTANT" unit="1/time" description="Natural death rate of mosquitoes (μ2)" />
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Infection of susceptible humans through contact with infectious mosquitoes." />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.6" target="//@compartments.3" description="Infection of susceptible humans through non-vector transmission from infectious humans." />
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.1" target="//@compartments.2" description="Breakthrough infection of vaccinated humans through contact with infectious mosquitoes, reduced by vaccine efficacy." />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.1" target="//@compartments.3" description="Breakthrough infection of vaccinated humans through non-vector transmission from infectious humans." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.0" description="Loss of vaccine-induced immunity." />
  </compartments>
  <compartments PrimaryName="Vector-Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.4" description="Progression from vector-exposed to infectious humans." />
  </compartments>
  <compartments PrimaryName="Non-Vector-Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.4" description="Progression from non-vector-exposed to infectious humans." />
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.5" description="Treatment of infectious humans." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.15" target="//@compartments.6" description="Recovery from infection after treatment/clinical course." />
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.15" target="//@compartments.6" description="Recovery from treated state." />
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.1" target="//@compartments.0" description="Loss of natural immunity / relapse back to susceptibility." />
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.6" target="//@compartments.8" description="Mosquito infection after feeding on infectious humans." />
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.9" description="Progression from exposed to infectious mosquitoes." />
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0" />
</ns0:CompartmentalModel>