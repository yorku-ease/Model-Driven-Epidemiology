<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="Recruitment rate of susceptible people" expression="10" type="CONSTANT" description="Rate at which susceptible individuals are recruited." unit="per day" />
  <parameters name="Recruitment rate of infected people" expression="3" type="CONSTANT" description="Rate at which infected individuals are recruited." unit="per day" />
  <parameters name="Effective contact rate of infected humans" expression="0.006" type="CONSTANT" description="Rate of effective contact with infected humans." unit="per day" />
  <parameters name="Contact rate of Ebola virus pathogens in the environment" expression="0.0012" type="CONSTANT" description="Rate of contact with Ebola virus pathogens in the environment." unit="per day" />
  <parameters name="Rate of contact with deceased humans" expression="0.006" type="CONSTANT" description="Rate of effective contact with deceased humans." unit="per day" />
  <parameters name="Natural death rate of humans" expression="0.5" type="CONSTANT" description="Natural death rate of humans." unit="per day" />
  <parameters name="Death rate due to infection" expression="0.123" type="CONSTANT" description="Rate of deaths due to infection." unit="per day" />
  <parameters name="Rate of shedding of infected humans" expression="0.04" type="CONSTANT" description="Rate at which infected humans shed pathogens." unit="per day" />
  <parameters name="Rate at which infected people are quarantined" expression="0.12" type="CONSTANT" description="Rate at which infected individuals are quarantined." unit="per day" />
  <parameters name="Rate at which quarantined people recover" expression="0.04" type="CONSTANT" description="Rate at which quarantined individuals recover." unit="per day" />
  <parameters name="Rate at which quarantined people die" expression="0.22" type="CONSTANT" description="Rate at which quarantined individuals die." unit="per day" />
  <parameters name="Proportion of shedding of deceased people" expression="0.04" type="CONSTANT" description="Proportion of shedding of pathogens by deceased individuals." unit="per day" />
  <parameters name="Proportion rate of burial of deceased people" expression="0.8" type="CONSTANT" description="Proportion rate of burial of deceased individuals." unit="per day" />
  <parameters name="Rate at which Ebola virus decays in the environment" expression="0" type="CONSTANT" description="Rate at which Ebola virus decays in the environment." unit="per day" />
  <parameters name="λ" expression="0.0" type="CONSTANT" />
  <parameters name="μ" expression="0.00038461" type="CONSTANT" unit="1/time" description="Natural human death rate (μ)" />
  <parameters name="β1" expression="0.25" type="CONSTANT" unit="per day" />
  <parameters name="β2" expression="0.2" type="CONSTANT" unit="per day" />
  <parameters name="β3" expression="0.5" type="CONSTANT" unit="per day" />
  <parameters name="δ1" expression="0.1" type="CONSTANT" unit="1/day" />
  <parameters name="ω2" expression="0.2" type="CONSTANT" unit="1/day" />
  <parameters name="ω3" expression="0.005" type="CONSTANT" unit="per day" />
  <parameters name="ω1" expression="0.1" type="CONSTANT" unit="per day" />
  <parameters name="ω1q" expression="0.01" type="CONSTANT" unit="1/day" />
  <parameters name="δ2" expression="0.05" type="CONSTANT" unit="1/day" />
  <parameters name="η" expression="0.001" type="CONSTANT" unit="per day" />
  <parameters name="ρ" expression="0.5" type="CONSTANT" />
  <parameters name="μb" expression="0.0001" type="CONSTANT" unit="per day" />
  <compartments PrimaryName="Susceptible People" population="1000">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.2" target="//@compartments.1" description="Transmission of the disease through contact with infectious people, deceased, or the environment. [S→I direct: no E stage] [S→I direct: no E stage]" />
  </compartments>
  <compartments PrimaryName="Infectious People" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.2" description="Infected individuals being quarantined." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.4" description="Shedding of pathogens into the environment by infected individuals." />
    <outgoingFlows target="//@compartments.3" rateParameter="//@parameters.7" />
    <outgoingFlows target="//@compartments.5" rateParameter="//@parameters.1" />
    <outgoingFlows target="//@compartments.7" rateParameter="//@parameters.8" />
  </compartments>
  <compartments PrimaryName="Quarantine People" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.3" description="Quarantined individuals recovering from the disease." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Quarantined individuals dying from the disease." rateParameter="//@parameters.0" />
  </compartments>
  <compartments PrimaryName="Recovered Disease" population="0" />
  <compartments PrimaryName="Ebola Virus Pathogens in the Environment" population="0"><outgoingFlows target="//@compartments.3" description="Auto-added: Ebola Virus Pathogens in the Environment → Recovered Disease" rateParameter="//@parameters.6" /></compartments>
  <compartments PrimaryName="Deceased People" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Shedding of pathogens into the environment by deceased individuals." rateParameter="//@parameters.11" />
    <outgoingFlows target="//@compartments.7" rateParameter="//@parameters.10" />
  </compartments>
  <compartments PrimaryName="Environmental Pathogens"><outgoingFlows target="//@compartments.3" description="Auto-added: Environmental Pathogens → Recovered Disease" rateParameter="//@parameters.4" /><outgoingFlows target="//@compartments.3" description="Auto-added: Environmental Pathogens → Recovered Disease" rateParameter="//@parameters.5" /><outgoingFlows target="//@compartments.3" description="Auto-added: Environmental Pathogens → Recovered Disease" rateParameter="//@parameters.3" /></compartments>
  <compartments PrimaryName="Environment Pathogens" />
</ns0:CompartmentalModel>