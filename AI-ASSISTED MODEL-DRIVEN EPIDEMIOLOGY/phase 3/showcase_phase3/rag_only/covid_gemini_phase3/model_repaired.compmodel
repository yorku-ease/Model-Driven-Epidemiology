<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="Latent period" expression="2.5" type="CONSTANT" description="Time from exposure to onset of infectiousness" unit="days" />
  <parameters name="Presymptomatic infectious period" expression="1" type="CONSTANT" description="Duration of infectiousness before symptom onset" unit="days" />
  <parameters name="Infectious period mild to moderate" expression="6" type="CONSTANT" description="Symptomatic infectious period for mild-to-moderate cases in absence of isolation" unit="days" />
  <parameters name="Infectious period severe" expression="6" type="CONSTANT" description="Symptomatic infectious period for severe cases; assumed equal to time to hospital admission" unit="days" />
  <parameters name="R0" expression="2.3" type="CONSTANT" description="Basic reproduction number: average number of secondary infections from a primary infection in a susceptible population" unit="dimensionless" />
  <parameters name="Quarantine duration" expression="14" type="CONSTANT" description="Duration of quarantine for exposed cases" unit="days" />
  <parameters name="Relative risk of transmission for isolated cases" expression="0.1" type="CONSTANT" description="Isolated cases have reduced transmission relative to unrecognized cases" unit="dimensionless" />
  <parameters name="Hospital length of stay non-ICU" expression="10" type="CONSTANT" description="Average length of stay in hospital for cases not requiring ICU care" unit="days" />
  <parameters name="Hospital length of stay pre-ICU" expression="3" type="CONSTANT" description="Average length of stay in hospital before ICU admission for severe cases" unit="days" />
  <parameters name="ICU length of stay" expression="21" type="CONSTANT" description="Average length of stay in ICU for severe cases requiring ICU care" unit="days" />
  <parameters name="Hospital length of stay post-ICU" expression="21" type="CONSTANT" description="Average length of stay in hospital after ICU for severe cases" unit="days" />
  <parameters name="Probability of severe infection, &lt;15 yr, no comorbidities" expression="0.01" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, 15-49 yr, no comorbidities" expression="0.03" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, 50-69 yr, no comorbidities" expression="0.12" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, &gt;=70 yr, no comorbidities" expression="0.35" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, &lt;15 yr, comorbidities" expression="0.02" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, 15-49 yr, comorbidities" expression="0.06" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, 50-69 yr, comorbidities" expression="0.25" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability of severe infection, &gt;=70 yr, comorbidities" expression="0.76" type="CONSTANT" description="Probability of severe infection requiring hospital admission" unit="dimensionless" />
  <parameters name="Probability severe case requires ICU" expression="0.26" type="CONSTANT" description="Probability that a severe case requires admission to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, &lt;15 yr, no comorbidities" expression="0" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, 15-49 yr, no comorbidities" expression="0.2" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, 50-69 yr, no comorbidities" expression="0.36" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, &gt;=70 yr, no comorbidities" expression="0.58" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, &lt;15 yr, comorbidities" expression="0" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, 15-49 yr, comorbidities" expression="0.53" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, 50-69 yr, comorbidities" expression="0.9" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Probability of death in ICU, &gt;=70 yr, comorbidities" expression="1" type="CONSTANT" description="Probability of death for cases admitted to ICU" unit="dimensionless" />
  <parameters name="Base case testing and isolation rate, &lt;15 yr" expression="10" type="CONSTANT" description="Percentage of nonquarantined cases tested and isolated in base case" unit="percent" />
  <parameters name="Base case testing and isolation rate, 15-49 yr" expression="40" type="CONSTANT" description="Percentage of nonquarantined cases tested and isolated in base case" unit="percent" />
  <parameters name="Base case testing and isolation rate, &gt;=50 yr" expression="70" type="CONSTANT" description="Percentage of nonquarantined cases tested and isolated in base case" unit="percent" />
  <parameters name="Base case quarantine rate" expression="10" type="CONSTANT" description="Percentage of exposed cases in quarantine before becoming infectious in base case" unit="percent" />
  <parameters name="Base case physical distancing reduction" expression="0" type="CONSTANT" description="Reduction in contacts with physical distancing in base case" unit="percent" />
  <parameters name="Physical distancing contact reduction (restrictive)" expression="60" type="CONSTANT" description="Reduction in contacts under restrictive physical distancing scenario" unit="percent" />
  <parameters name="Physical distancing contact reduction (combination)" expression="25" type="CONSTANT" description="Reduction in contacts under combination intervention scenario" unit="percent" />
  <parameters name="ICU threshold for dynamic intervention" expression="200" type="CONSTANT" description="Number of COVID-19 cases in ICU that triggers dynamic intervention activation" unit="cases" />
  <compartments PrimaryName="Susceptible" population="1000">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.6" target="//@compartments.2" description="Infection of susceptible individuals through contact with infectious individuals" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.6" target="//@compartments.1" description="Infection of susceptible individuals who are then quarantined via contact tracing" />
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.3" description="Progression from latent period to presymptomatic infectious stage" />
  </compartments>
  <compartments PrimaryName="Exposed Quarantined" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.4" description="Progression from quarantined exposed to presymptomatic infectious isolated stage" />
  </compartments>
  <compartments PrimaryName="Infectious Presymptomatic" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.5" description="Progression from presymptomatic to mild/moderate symptomatic infection" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.7" description="Progression from presymptomatic to severe symptomatic infection" />
  </compartments>
  <compartments PrimaryName="Infectious Presymptomatic Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.6" description="Progression from presymptomatic isolated to mild/moderate isolated" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.2" target="//@compartments.8" description="Progression from presymptomatic isolated to severe isolated" />
  </compartments>
  <compartments PrimaryName="Infectious Mild to Moderate" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Testing and isolation of mild/moderate cases" rateParameter="//@parameters.1" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of mild/moderate cases" rateParameter="//@parameters.5" />
  </compartments>
  <compartments PrimaryName="Infectious Mild to Moderate Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of isolated mild/moderate cases" rateParameter="//@parameters.14" />
  </compartments>
  <compartments PrimaryName="Infectious Severe" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Testing and isolation of severe cases" rateParameter="//@parameters.3" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospital admission for severe cases not requiring ICU" rateParameter="//@parameters.7" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospital admission for severe cases before ICU" rateParameter="//@parameters.8" />
  </compartments>
  <compartments PrimaryName="Infectious Severe Isolated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospital admission for isolated severe cases not requiring ICU" rateParameter="//@parameters.9" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospital admission for isolated severe cases before ICU" rateParameter="//@parameters.13" />
  </compartments>
  <compartments PrimaryName="Admitted to Hospital" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery and discharge from hospital (non-ICU)" rateParameter="//@parameters.4" />
  </compartments>
  <compartments PrimaryName="Admitted to Hospital Pre-ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Transfer from hospital to ICU" rateParameter="//@parameters.15" />
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Transfer from ICU to post-ICU hospital care for survivors" rateParameter="//@parameters.10" />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.14" description="Death in ICU" rateParameter="//@parameters.19" />
  </compartments>
  <compartments PrimaryName="Admitted to Hospital Post-ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery and discharge after post-ICU hospital stay" rateParameter="//@parameters.11" />
    <outgoingFlows target="//@compartments.15" rateParameter="//@parameters.12" />
  </compartments>
  <compartments PrimaryName="Recovered" population="0" />
  <compartments PrimaryName="Dead" population="0"><outgoingFlows target="//@compartments.13" description="Auto-added: Dead → Recovered" rateParameter="//@parameters.0" /></compartments>
  <compartments PrimaryName="covid deaths"><outgoingFlows target="//@compartments.13" description="Auto-added: covid deaths → Recovered" rateParameter="//@parameters.0" /></compartments>
</ns0:CompartmentalModel>