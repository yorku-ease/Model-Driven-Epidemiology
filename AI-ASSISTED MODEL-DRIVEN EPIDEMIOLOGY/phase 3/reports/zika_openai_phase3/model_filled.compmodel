<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="b" expression="0.0" type="CONSTANT" />
  <parameters name="1/τ_h" expression="1" type="CONSTANT" unit="1/time" description="Progression rate Ev to Iv" />
  <parameters name="γ_h" expression="100000" type="CONSTANT" unit="individuals" description="Number of alternative hosts besides humans in the environment" />
  <parameters name="1/τ1_v" expression="3" type="CONSTANT" unit="days" description="Egg development time" />
  <parameters name="1/τ2_v" expression="9" type="CONSTANT" unit="days" description="Larval development time" />
  <parameters name="τ3_v" expression="1" type="CONSTANT" unit="1/day" description="Inverse of pupal development time (3 days)." />
  <parameters name="b_v" expression="0.3" type="CONSTANT" unit="1/day" description="Average biting rate per unit time of a female mosquito." />
  <parameters name="1/τ_v" expression="1" type="CONSTANT" unit="1/time" description="Progression rate Ev to Iv" />
  <parameters name="r_h" expression="0.001995" type="CONSTANT" unit="1/time" description="Progression rate Eh to Ih" />
  <parameters name="μ_h" expression="0.005" type="CONSTANT" unit="per unit time" description="The natural death rate of the human hosts" />
  <parameters name="f" expression="1947.0" type="CONSTANT" />
  <parameters name="μ1_v" expression="0.05" type="CONSTANT" unit="per day" description="Egg mortality rate" />
  <parameters name="μ2_v" expression="0.025" type="CONSTANT" unit="per day" description="Larval mortality rate" />
  <parameters name="δ_l" expression="80" type="CONSTANT" unit="eggs/mosquito/day" description="Number of eggs laid per female mosquito per unit time." />
  <parameters name="μ3_v" expression="0.0025" type="CONSTANT" unit="per day" description="Pupal mortality rate" />
  <parameters name="μ_a_v" expression="100000" type="CONSTANT" unit="individuals" description="Number of alternative hosts besides humans in the environment" />
  <parameters name="φ" expression="0.1" type="CONSTANT" unit="per day" />
  <parameters name="φ * τ3_v" expression="1" type="CONSTANT" unit="1/day" description="Inverse of pupal development time (3 days)." />
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Humans become exposed after being bitten by an infectious mosquito." />
  </compartments>
  <compartments PrimaryName="Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Exposed humans become infectious after the incubation period." />
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.3" description="Infectious humans recover from the virus." />
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0" />
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.5" contactRate="0.0" target="//@compartments.5" description="Mosquitoes become exposed after biting an infectious human." />
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Exposed mosquitoes become infectious after the incubation period." />
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0" />
</ns0:CompartmentalModel>