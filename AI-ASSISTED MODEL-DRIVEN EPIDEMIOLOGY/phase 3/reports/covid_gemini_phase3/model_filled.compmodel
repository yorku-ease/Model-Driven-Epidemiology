<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRate="0.0" target="//@compartments.1" description="Transmission of infection to susceptible individuals." />
  </compartments>
  <compartments PrimaryName="Exposed" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.2" description="Quarantine of exposed individuals." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.3" description="Progression from latent period to presymptomatic infectiousness." />
  </compartments>
  <compartments PrimaryName="Exposed (quarantined)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Progression from quarantined latent period to isolated presymptomatic infectiousness." />
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.5" description="Development of mild to moderate symptoms." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.7" description="Development of severe symptoms." />
  </compartments>
  <compartments PrimaryName="Infectious (presymptomatic, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Development of mild to moderate symptoms while isolated." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Development of severe symptoms while isolated." />
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.6" description="Isolation of individuals with mild to moderate symptoms." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery from mild to moderate infection." />
  </compartments>
  <compartments PrimaryName="Infectious (mild to moderate, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery from isolated mild to moderate infection." />
  </compartments>
  <compartments PrimaryName="Infectious (severe)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.8" description="Isolation of individuals with severe symptoms." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospitalization of severe cases not requiring ICU care." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospitalization of severe cases requiring ICU care." />
  </compartments>
  <compartments PrimaryName="Infectious (severe, isolated)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.9" description="Hospitalization of isolated severe cases not requiring ICU care." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.10" description="Hospitalization of isolated severe cases requiring ICU care." />
  </compartments>
  <compartments PrimaryName="Admitted to hospital" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of hospitalized non-ICU patients." />
  </compartments>
  <compartments PrimaryName="Admitted to hospital (pre-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.11" description="Admission to the ICU." />
  </compartments>
  <compartments PrimaryName="ICU" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.12" description="Discharge from ICU to a hospital ward." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.14" description="Death of patients in the ICU." />
  </compartments>
  <compartments PrimaryName="Admitted to hospital (post-ICU)" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.13" description="Recovery of patients after ICU stay." />
  </compartments>
  <compartments PrimaryName="Recovered" population="0" />
  <compartments PrimaryName="Dead" population="0" />
</ns0:CompartmentalModel>