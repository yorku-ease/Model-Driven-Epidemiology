<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="Case detection rate" expression="70% (WHO target for new programme)" type="CONSTANT" description="Target proportion of infectious cases diagnosed and treated per year." unit="%" />
  <parameters name="Cure rate" expression="85% (WHO target for new programme)" type="CONSTANT" description="Fraction of treated cases cured under the new DOTS programme." unit="%" />
  <parameters name="Case detection rate, old programme" expression="50% to 80% depending on region" type="CONSTANT" description="Baseline case detection rate under the pre-DOTS programme." unit="%" />
  <parameters name="Fraction cured, old programme" expression="40% to 75% depending on region" type="CONSTANT" description="Baseline cure fraction under the pre-DOTS programme." unit="%" />
  <parameters name="Relative case detection rate of non-infectious cases" expression="0.5 to 0.8 depending on region" type="CONSTANT" description="Detection rate for non-infectious cases relative to infectious cases." unit="ratio" />
  <parameters name="Annual risk of infection" expression="2.6, 0.6, 1.0, 0.1, 0.5, 2.0, 0.9" type="CONSTANT" description="Regional annual risk of tuberculosis infection for the WHO regions listed in the table." unit="%" />
  <parameters name="Incidence rate, all forms" expression="215, 62, 102, 13, 61, 188, 94" type="CONSTANT" description="Regional incidence of all forms of tuberculosis." unit="per 100000 per year" />
  <parameters name="Incidence rate, infectious cases" expression="106, 34, 55, 7, 34, 102, 52" type="CONSTANT" description="Regional incidence of infectious tuberculosis cases." unit="per 100000 per year" />
  <parameters name="Prevalence rate, infectious cases" expression="201, 55, 101, 8, 55, 184, 83" type="CONSTANT" description="Regional prevalence of infectious tuberculosis cases." unit="per 100000 people" />
  <parameters name="Death rate, all forms" expression="92, 21, 40, 3, 21, 73, 33" type="CONSTANT" description="Regional tuberculosis death rate." unit="per 100000 people per year" />
  <parameters name="Population growth" expression="2.8, 1.4, 2.7, 0.4, 0.4, 1.7, 1.1" type="CONSTANT" description="Regional population growth rates." unit="% per year" />
  <parameters name="Change in annual risk of infection" expression="-0.3, -2.2, -2.9, -5.6, -1.3, -0.9, -1.8" type="CONSTANT" description="Regional annual change in annual risk of infection." unit="% per year" />
  <parameters name="Change in incidence rate" expression="2.7, -2.5, -2.1, -5.0, -1.1, -0.3, -1.2" type="CONSTANT" description="Regional annual change in incidence rate." unit="% per year" />
  <parameters name="Change in death rate" expression="2.9, -2.7, -2.2, -4.6, -0.7, -0.7, -1.6" type="CONSTANT" description="Regional annual change in death rate." unit="% per year" />
  <parameters name="Change in contact rate" expression="-0.7, -0.8, -1.0, -0.5, -0.9, -0.5, -0.6" type="CONSTANT" description="Regional annual change in contact rate used to represent declining transmission." unit="% per year" />
  <parameters name="HIV-1 infection in tuberculosis cases, 2020" expression="21, 2.5, 0.2, 0.5, 0.5, 4.0, 1.4" type="CONSTANT" description="Projected proportion of tuberculosis cases that are HIV-1 positive in 2020 by region." unit="%" />
  <parameters name="primaryinfectiontolatentrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="primaryinfectiontoinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="primaryinfectiontononinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="latentreactivationtoinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="latentreactivationtononinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="exogenousreinfectiontoinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="exogenousreinfectiontononinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="infectiouscasedetectionrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="infectiousselfcurerate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="noninfectiouscasedetectionrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="noninfectiousselfcurerate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="treatmentcurerate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="treatmentfailurerate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="failurerelapsetoinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="failurerelapsetononinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="selfcurerelapsetoinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <parameters name="selfcurerelapsetononinfectiousrate" expression="0.0001" type="CONSTANT" unit="day^-1" description="Human birth and death rate (susceptible renewal rate)" />
  <compartments PrimaryName="Susceptible" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.1" contactRateParameter="//@parameters.14" target="//@compartments.1" description="New infection with Mycobacterium tuberculosis." />
    <outgoingFlows target="//@compartments.3" />
  </compartments>
  <compartments PrimaryName="Latent Infection" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.2" description="Endogenous reactivation or progression to active disease." />
    <outgoingFlows target="//@compartments.3" />
  </compartments>
  <compartments PrimaryName="Infectious Tuberculosis" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rate="0.0" target="//@compartments.4" description="Patients diagnosed and treated who do not complete treatment (fail, default, or transfer out)." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.5" description="Successful completion of short-course chemotherapy with cure of active disease but persistence of infection." />
  </compartments>
  <compartments PrimaryName="Non-infectious Tuberculosis" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.4" description="Non-infectious cases enrolled in treatment who do not complete treatment." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.5" description="Successful completion of short-course chemotherapy for non-infectious tuberculosis." />
    <outgoingFlows target="//@compartments.6" />
  </compartments>
  <compartments PrimaryName="Treatment Failure" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.2" description="A proportion of treatment failures remain infectious and may progress back to full tuberculosis." />
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.1" description="Treatment failures that are not infectious may remain infected and later relapse/reactivate." />
    <outgoingFlows target="//@compartments.3" />
  </compartments>
  <compartments PrimaryName="Cured but Latently Infected" population="0" />
  <compartments PrimaryName="Self-cured" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.14" target="//@compartments.1" description="Self-cured individuals return to the latent class while remaining infected." />
    <outgoingFlows target="//@compartments.3" />
  </compartments>
</ns0:CompartmentalModel>