<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="A" expression="1/(65*12)" type="CONSTANT" description="Recruitment rate of humans (newborns entering susceptible class)" unit="per month" />
  <parameters name="β" expression="0.01-5" type="CONSTANT" description="Probability of successful infection rate" unit="1/(year × human)" />
  <parameters name="ϵ" expression="0-1" type="CONSTANT" description="Correction parameter for reinfection term (reinfection probability relative to primary infection)" unit="dimensionless" />
  <parameters name="u" expression="0-1" type="CONSTANT" description="Rate of vaccination of susceptible individuals" unit="1/day" />
  <parameters name="θ" expression="0.067-0.1" type="CONSTANT" description="Vaccine wane rate (rate of loss of vaccine protection)" unit="1/day" />
  <parameters name="γ" expression="0.5-2" type="CONSTANT" description="Recovery rate from tuberculosis" unit="1/year" />
  <parameters name="δ" expression="0.003-0.02" type="CONSTANT" description="Drop out rate due to waning immunity (recovered to susceptible)" unit="1/day" />
  <parameters name="μ" expression="1/(65*12)" type="CONSTANT" description="Natural death rate" unit="per month" />
  <parameters name="π" expression="0.02" type="CONSTANT" unit="year^-1" />
  <compartments PrimaryName="Susceptible" population="1000">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.0" target="//@compartments.1" description="Vaccination of susceptible individuals at rate u" />
  </compartments>
  <compartments PrimaryName="Vaccinated" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.4" target="//@compartments.0" description="Waning of vaccine protection at rate θ" />
  </compartments>
  <compartments PrimaryName="Infectious" population="0"><outgoingFlows target="//@compartments.3" description="Auto-added: Infectious → Recovered" rateParameter="//@parameters.5" /></compartments>
  <compartments PrimaryName="Recovered" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.0" description="Waning immunity causing transition from recovered to susceptible at rate δ" />
  </compartments>
</ns0:CompartmentalModel>