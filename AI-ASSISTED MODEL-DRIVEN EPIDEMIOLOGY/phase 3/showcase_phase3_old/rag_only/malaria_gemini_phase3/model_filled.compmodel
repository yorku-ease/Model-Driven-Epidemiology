<?xml version='1.0' encoding='utf-8'?>
<ns0:CompartmentalModel xmlns:ns0="http://example.com/compartmentalmodel" xmlns:ns1="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ns1:version="2.0">
  <parameters name="π" expression="0.012" type="CONSTANT" description="Human population birth rate" unit="per day" />
  <parameters name="k" expression="0.60-0.90" type="CONSTANT" description="Vaccination rate (fraction of births vaccinated)" unit="dimensionless" />
  <parameters name="µ1" expression="0.0002" type="CONSTANT" description="Human population natural death rate" unit="per day" />
  <parameters name="µ2" expression="0.1" type="CONSTANT" description="Mosquito population natural death rate" unit="per day" />
  <parameters name="Λ" expression="0.02" type="CONSTANT" description="Mosquito population birth rate" unit="per day" />
  <parameters name="ε" expression="0.3-0.5" type="CONSTANT" description="Rate of vaccine efficacy" unit="dimensionless" />
  <parameters name="θ" expression="0.1-0.2" type="CONSTANT" description="Rate of vaccine immunity loss due to vaccine failure" unit="per day" />
  <parameters name="τ1" expression="0.05" type="CONSTANT" description="Progression rate from vector-exposed to infectious" unit="per day" />
  <parameters name="τ2" expression="0.05" type="CONSTANT" description="Progression rate from non-vector-exposed to infectious" unit="per day" />
  <parameters name="σ" expression="0.10" type="CONSTANT" description="Progression rate from infectious to treated" unit="per day" />
  <parameters name="ω" expression="0.05" type="CONSTANT" description="Progression rate from treated to recovered" unit="per day" />
  <parameters name="γ" expression="0.01" type="CONSTANT" description="Recovered population rate of immunity loss" unit="per day" />
  <parameters name="δ1" expression="0.002" type="CONSTANT" description="Human population malaria disease death rate" unit="per day" />
  <parameters name="φ" expression="0.10" type="CONSTANT" description="Mosquito progression rate from exposed to infectious" unit="per day" />
  <parameters name="η_V" expression="0.001-0.005" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected mosquitoes through bloodmeals" unit="per day" />
  <parameters name="η_S" expression="0.005-0.02" type="CONSTANT" description="Effective contact rate of susceptible humans with infected mosquitoes through bloodmeals" unit="per day" />
  <parameters name="ξ_V" expression="0.0005-0.002" type="CONSTANT" description="Effective contact rate of vaccinated humans with infected humans through non-vector pathways" unit="per day" />
  <parameters name="ξ_S" expression="0.001-0.003" type="CONSTANT" description="Effective contact rate of susceptible humans with infected humans through non-vector pathways" unit="per day" />
  <parameters name="ρ" expression="0.01-0.05" type="CONSTANT" description="Effective contact rate of susceptible mosquitoes with infected humans through bloodmeals" unit="per mosquito" />
  <parameters name="α1" expression="15129" type="CONSTANT" unit="people/time" description="Human birth/recruitment rate (α1)" />
  <parameters name="μ1" expression="0.001384" type="CONSTANT" unit="1/time" description="Natural death rate of humans (μ1)" />
  <parameters name="μ2" expression="0.1" type="CONSTANT" unit="1/time" description="Natural death rate of mosquitoes (μ2)" />
  <compartments PrimaryName="Susceptible Humans" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.15" target="//@compartments.2" description="Vector-borne transmission from infectious mosquitoes to susceptible humans at rate β2 = η_S * I_M" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.17" target="//@compartments.3" description="Non-vector transmission from infectious humans to susceptible humans at rate α2 = ξ_S * I_H" />
  </compartments>
  <compartments PrimaryName="Vaccinated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.6" target="//@compartments.0" description="Loss of vaccine immunity at rate θ" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.2" contactRateParameter="//@parameters.5" target="//@compartments.2" description="Vector-borne transmission from infectious mosquitoes to vaccinated humans at rate β1*ε = η_V * I_M * ε" />
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.3" contactRateParameter="//@parameters.16" target="//@compartments.3" description="Non-vector transmission from infectious humans to vaccinated humans at rate α1 = ξ_V * I_H" />
  </compartments>
  <compartments PrimaryName="Vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.7" target="//@compartments.4" description="Progression from vector-exposed to infectious at rate τ1" />
  </compartments>
  <compartments PrimaryName="Non-Vector Exposed Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.8" target="//@compartments.4" description="Progression from non-vector-exposed to infectious at rate τ2" />
  </compartments>
  <compartments PrimaryName="Infectious Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.9" target="//@compartments.5" description="Treatment of infectious humans at rate σ" />
  </compartments>
  <compartments PrimaryName="Treated Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.10" target="//@compartments.6" description="Recovery after treatment at rate ω" />
  </compartments>
  <compartments PrimaryName="Recovered Humans" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.11" target="//@compartments.0" description="Loss of natural immunity at rate γ" />
  </compartments>
  <compartments PrimaryName="Susceptible Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.18" target="//@compartments.8" description="Mosquito infection from contact with infectious humans at rate β3 = ρ * I_H" />
  </compartments>
  <compartments PrimaryName="Exposed Mosquitoes" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow" rateParameter="//@parameters.13" target="//@compartments.9" description="Progression from exposed to infectious mosquitoes at rate φ" />
  </compartments>
  <compartments PrimaryName="Infectious Mosquitoes" population="0" />
</ns0:CompartmentalModel>