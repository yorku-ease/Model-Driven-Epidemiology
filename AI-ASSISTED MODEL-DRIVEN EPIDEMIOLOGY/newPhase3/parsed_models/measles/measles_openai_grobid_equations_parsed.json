  "parameters": [
    {"symbol": "Λ", "type": "CONSTANT", "value": null, "unit": "persons/time", "description": "Recruitment/birth inflow into child susceptible population (S_C)."},
    {"symbol": "μ", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Natural death rate (applies to all human compartments). Text: ~1/(72*52) per week."},
    {"symbol": "ξ_M", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Rate at which susceptible children enroll into monitored vaccination program (S_C → M_C^V)."},
    {"symbol": "ξ_U", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Rate at which susceptible children enroll into un-monitored vaccination program (S_C → U_C^V). Estimated by fitting."},
    {"symbol": "ψ", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Maturation/aging rate from children (<15) to adults (≥15). Text: ψ (denoted j in text) ≈ 1/(15*52) per week."},
    {"symbol": "β_C", "type": "CONSTANT", "value": null, "unit": "1/(persons*time)", "description": "Effective transmission/contact rate for children (child susceptibility/infection force). Estimated by fitting."},
    {"symbol": "β_A", "type": "CONSTANT", "value": null, "unit": "1/(persons*time)", "description": "Effective transmission/contact rate for adults (assumed lower than children). Estimated by fitting."},
    {"symbol": "ξ_A", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Adult catch-up vaccination enrollment rate (S_A → V_A). Text: taken as 0 during Nepal data period."},
    {"symbol": "ε", "type": "CONSTANT", "value": null, "unit": "dimensionless", "description": "Residual susceptibility factor for un-monitored vaccinated individuals; (1-ε) corresponds to vaccine effectiveness in text. Text: measles vaccine effectiveness ~77–86%."},
    {"symbol": "η_U", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Immunization rate for un-monitored vaccinated children (U_C^V → I_mC). Estimated by fitting (text uses h_U)."},
    {"symbol": "η_M", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Immunization rate for monitored vaccinated children (M_C^V → I_mC). Estimated by fitting (text uses h_M)."},
    {"symbol": "η_A", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Immunization rate for vaccinated adults (U_A^V and V_A → I_mA). Text: taken as 0 during Nepal data period (h_A=0)."},
    {"symbol": "δ", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Progression rate from exposed to infectious (incubation). Text: incubation ~10 days ⇒ δ ≈ 0.7 per week."},
    {"symbol": "γ", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Recovery rate from infectious. Text: recovery ~15 days ⇒ γ ≈ 1/2 per week."},
    {"symbol": "d", "type": "CONSTANT", "value": null, "unit": "1/time", "description": "Disease-induced death rate in infectious compartments (I_C, I_A). Text references CFR; symbol d used in equations."}
  ],
