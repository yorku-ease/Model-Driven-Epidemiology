    {
      "symbol": "\u03b2\u2095(a)",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/time",
      "description": "The age-specific transmission rate from infected mosquitoes to susceptible hosts."
    },
    {
      "symbol": "\u03b2\u1d65(a)",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/time",
      "description": "The age-specific transmission rate from infectious hosts to susceptible mosquitoes."
    },
    {
      "symbol": "k(a)",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/time",
      "description": "The age-specific rate at which exposed humans become infectious (inverse of latent period)."
    },
    {
      "symbol": "\u03c1",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "The probability of exposed hosts transferring to the symptomatic infectious class."
    },
    {
      "symbol": "\u03b3\u2081(a)",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/time",
      "description": "The age-specific recovery rate of symptomatic infectious hosts."
    },
    {
      "symbol": "\u03b3\u2082(a)",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/time",
      "description": "The age-specific recovery rate of asymptomatic infectious hosts."
    },
    {
      "symbol": "\u03c3",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "The factor characterizing the intensity of reinfection of asymptomatic individuals and their relative transmissibility."
    },
    {
      "symbol": "N\u2095*",
      "type": "EXPRESSION",
      "value": "B / \u03bc\u2095",
      "unit": "persons",
      "description": "The total human population at the disease-free equilibrium."
    },
    {
      "symbol": "rate_E_to_I",
      "type": "EXPRESSION",
      "value": "\u03c1 * k(a)",
      "unit": "1/time",
      "description": "Progression rate from Exposed to Symptomatic Infectious."
    },
    {
      "symbol": "rate_E_to_A",
      "type": "EXPRESSION",
      "value": "(1 - \u03c1) * k(a)",
      "unit": "1/time",
      "description": "Progression rate from Exposed to Asymptomatic Infectious."
    },
    {
      "symbol": "contact_rate_h_freq",
      "type": "EXPRESSION",
      "value": "\u03b2\u2095(a) / N\u2095*",
      "unit": "1/(person*time)",
      "description": "Frequency-dependent contact rate for primary human infection from mosquitoes."
    },
    {
      "symbol": "contact_rate_reinfect_freq",
      "type": "EXPRESSION",
      "value": "\u03c3 * \u03b2\u2095(a) / N\u2095*",
      "unit": "1/(person*time)",
      "description": "Frequency-dependent contact rate for reinfection of asymptomatic humans."
    },
    {
      "symbol": "contact_rate_v_symp_freq",
      "type": "EXPRESSION",
      "value": "\u03b2\u1d65(a) / N\u2095*",
      "unit": "1/(person*time)",
      "description": "Frequency-dependent contact rate for mosquito infection from symptomatic humans."
    },
    {
      "symbol": "contact_rate_v_asymp_freq",
      "type": "EXPRESSION",
      "value": "\u03c3 * \u03b2\u1d65(a) / N\u2095*",
      "unit": "1/(person*time)",
      "description": "Frequency-dependent contact rate for mosquito infection from asymptomatic humans."
    }
  ]
