  "parameters": [
    {
      "symbol": "C",
      "type": "CONSTANT",
      "value": 333.0,
      "unit": "individuals/year",
      "description": "Constant recruitment into susceptible population (San Juan de Pasto); total recruits per year."
    },
    {
      "symbol": "h",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of recruits that are men (used to split recruitment into male vs women)."
    },
    {
      "symbol": "c",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of men that are heterosexual (used to split male recruitment into heterosexual men vs homosexual men)."
    },
    {
      "symbol": "p",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of initially treated individuals among those leaving untreated infected class (branching to treatment vs AIDS)."
    },
    {
      "symbol": "\u03bb",
      "type": "CONSTANT",
      "value": 0.0129,
      "unit": "1/year",
      "description": "Natural mortality rate (estimated from life expectancy 77.3 years)."
    },
    {
      "symbol": "d",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "AIDS-induced mortality rate (average survival with AIDS ~3 years)."
    },
    {
      "symbol": "\u03b4",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/year",
      "description": "AIDS development rate in treated individuals due to ART resistance/treatment failure (T \u2192 A)."
    },
    {
      "symbol": "\u03b1",
      "type": "CONSTANT",
      "value": null,
      "unit": "1/year",
      "description": "Departure rate from all untreated infected compartments (I_h, I_w, I_m); governs leaving I to either treatment or AIDS."
    },
    {
      "symbol": "b_h",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Probability of contagion per homosexual contact (exclusive homosexual contact)."
    },
    {
      "symbol": "c_h",
      "type": "CONSTANT",
      "value": null,
      "unit": "partners/(person\u00b7year)",
      "description": "Rate/number of sexual partners in exclusive homosexual contact."
    },
    {
      "symbol": "b_s",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Probability of contagion per exclusive heterosexual contact."
    },
    {
      "symbol": "c_s",
      "type": "CONSTANT",
      "value": null,
      "unit": "partners/(person\u00b7year)",
      "description": "Rate/number of sexual partners in exclusive heterosexual contact."
    },
    {
      "symbol": "b_hw",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Probability of contagion per bisexual contact from homosexual men to women (h\u2192w)."
    },
    {
      "symbol": "c_hw",
      "type": "CONSTANT",
      "value": null,
      "unit": "partners/(person\u00b7year)",
      "description": "Rate/number of sexual partners for bisexual contact between homosexual men and women."
    },
    {
      "symbol": "b_hm",
      "type": "CONSTANT",
      "value": null,
      "unit": "dimensionless",
      "description": "Probability of contagion per bisexual contact from homosexual men to heterosexual men (h\u2192m)."
    },
    {
      "symbol": "c_hm",
      "type": "CONSTANT",
      "value": null,
      "unit": "partners/(person\u00b7year)",
      "description": "Rate/number of sexual partners for bisexual contact between homosexual men and heterosexual men."
    },
    {
      "symbol": "\u03b2_h",
      "type": "EXPRESSION",
      "value": "c_h * b_h",
      "unit": "1/year",
      "description": "Effective transmission coefficient for exclusive homosexual contact (partners rate \u00d7 transmission probability)."
    },
    {
      "symbol": "\u03b2_s",
      "type": "EXPRESSION",
      "value": "c_s * b_s",
      "unit": "1/year",
      "description": "Effective transmission coefficient for exclusive heterosexual contact (partners rate \u00d7 transmission probability)."
    },
    {
      "symbol": "R0_hom",
      "type": "EXPRESSION",
      "value": "(c_h * b_h) / (\u03b1 + \u03bb)",
      "unit": "dimensionless",
      "description": "Basic reproduction number component for homosexual transmission (as reported: Rhom0 = ch*bh/(a+l))."
    },
    {
      "symbol": "R0_het",
      "type": "EXPRESSION",
      "value": "(c_s * b_s) / (\u03b1 + \u03bb)",
      "unit": "dimensionless",
      "description": "Basic reproduction number component for heterosexual transmission (as reported: Rhet0 = cs*bs/(a+l))."
    },
    {
      "symbol": "C_h",
      "type": "EXPRESSION",
      "value": "C * h * (1 - c)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible homosexual men."
    },
    {
      "symbol": "C_w",
      "type": "EXPRESSION",
      "value": "C * (1 - h)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible women."
    },
    {
      "symbol": "C_m",
      "type": "EXPRESSION",
      "value": "C * h * c",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible heterosexual men."
    }
  ]
