  "parameters": [
    {
      "symbol": "\u03a8",
      "type": "VARIABLE",
      "value": null,
      "unit": "individuals/year",
      "description": "Total constant recruitment into adult susceptible population (all groups combined). Text denotes constant recruitment C; equations use \u03a8."
    },
    {
      "symbol": "\u03b8",
      "type": "VARIABLE",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of recruits that are men (text: h)."
    },
    {
      "symbol": "\u03b3",
      "type": "VARIABLE",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of men that are heterosexual (text: c). Thus homosexual men proportion among men is (1-\u03b3)."
    },
    {
      "symbol": "\u03bc",
      "type": "CONSTANT",
      "value": 0.0129,
      "unit": "1/year",
      "description": "Natural mortality rate (estimated from life expectancy 77.3 years: \u03bc = 1/77.3 \u2248 0.0129)."
    },
    {
      "symbol": "\u03b1",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Departure rate from infected (untreated) compartments (text: a). Governs leaving I compartments into treatment or AIDS classes."
    },
    {
      "symbol": "p",
      "type": "VARIABLE",
      "value": null,
      "unit": "dimensionless",
      "description": "Proportion of infected individuals who initiate ART upon leaving infected class (text: proportion initially treated)."
    },
    {
      "symbol": "\u03b4",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "AIDS development rate in treated individuals due to ART resistance/treatment failure (text uses d for this; equations use \u03b4)."
    },
    {
      "symbol": "d",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "AIDS-induced mortality rate (average survival with AIDS ~3 years: d = 1/3 \u2248 0.3333)."
    },
    {
      "symbol": "\u03bb_h",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Force of infection for susceptible homosexual men (infection via contact with infected homosexual men)."
    },
    {
      "symbol": "\u03bb_m",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Force of infection on women due to infected heterosexual men (heterosexual transmission)."
    },
    {
      "symbol": "\u03bb_hw",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Force of infection on women due to infected homosexual men (bisexual contact: homosexual men \u2192 women)."
    },
    {
      "symbol": "\u03bb_w",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Force of infection on heterosexual men due to infected women (heterosexual transmission)."
    },
    {
      "symbol": "\u03bb_hm",
      "type": "VARIABLE",
      "value": null,
      "unit": "1/year",
      "description": "Force of infection on heterosexual men due to infected homosexual men (bisexual contact: homosexual men \u2192 heterosexual men)."
    },
    {
      "symbol": "\u03a8_h",
      "type": "EXPRESSION",
      "value": "\u03a8 * \u03b8 * (1 - \u03b3)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible homosexual men: \u03a8\u03b8(1-\u03b3)."
    },
    {
      "symbol": "\u03a8_w",
      "type": "EXPRESSION",
      "value": "\u03a8 * (1 - \u03b8)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible women: \u03a8(1-\u03b8)."
    },
    {
      "symbol": "\u03a8_m",
      "type": "EXPRESSION",
      "value": "\u03a8 * \u03b8 * \u03b3",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible heterosexual men: \u03a8\u03b8\u03b3."
    },
    {
      "symbol": "Inflow_T",
      "type": "EXPRESSION",
      "value": "\u03b1 * p * (I_h + I_w + I_m)",
      "unit": "individuals/year",
      "description": "Total inflow to Treated (ART) from all infected classes, as in equation for T."
    },
    {
      "symbol": "Inflow_A_from_I",
      "type": "EXPRESSION",
      "value": "\u03b1 * (1 - p) * (I_h + I_w + I_m)",
      "unit": "individuals/year",
      "description": "Total inflow to AIDS from all infected classes not initiating ART, as in equation for A."
    }
  ]
