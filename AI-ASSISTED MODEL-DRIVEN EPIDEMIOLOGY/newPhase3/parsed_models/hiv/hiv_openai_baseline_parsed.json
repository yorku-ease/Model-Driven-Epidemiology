  "parameters": [
    {
      "symbol": "C",
      "type": "CONSTANT",
      "value": 333.0,
      "unit": "individuals/year",
      "description": "Constant recruitment into susceptible population (total recruitment, allocated across susceptible strata via h and c)"
    },
    {
      "symbol": "h",
      "type": "CONSTANT",
      "value": 0.48,
      "unit": "dimensionless",
      "description": "Proportion of men in recruitment; used to split recruitment between men and women"
    },
    {
      "symbol": "c",
      "type": "CONSTANT",
      "value": 0.92,
      "unit": "dimensionless",
      "description": "Proportion of heterosexual men among men in recruitment; used to split recruitment between homosexual men and heterosexual men"
    },
    {
      "symbol": "p",
      "type": "CONSTANT",
      "value": 0.9,
      "unit": "dimensionless",
      "description": "Proportion of initially treated individuals (initial condition parameter)"
    },
    {
      "symbol": "\u03bb",
      "type": "CONSTANT",
      "value": 0.0129,
      "unit": "1/year",
      "description": "Natural mortality rate (applies to all compartments)"
    },
    {
      "symbol": "\u03b4",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "AIDS-induced mortality rate (applies to AIDS compartment)"
    },
    {
      "symbol": "d",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "1/year",
      "description": "AIDS development rate in treated individuals due to ART resistance or treatment failure (T \u2192 A)"
    },
    {
      "symbol": "a",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "Departure rate from all compartments of infected individuals (progression from untreated infected to treated: I_* \u2192 T); identified as most sensitive parameter"
    },
    {
      "symbol": "b_s",
      "type": "CONSTANT",
      "value": 0.02,
      "unit": "dimensionless",
      "description": "Probability of sexual transmission for heterosexual contact (men-women)"
    },
    {
      "symbol": "b_h",
      "type": "CONSTANT",
      "value": 0.44,
      "unit": "dimensionless",
      "description": "Probability of sexual transmission for exclusive homosexual contact among homosexual men"
    },
    {
      "symbol": "b_hw",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "dimensionless",
      "description": "Probability of sexual transmission for contact between homosexual men and women"
    },
    {
      "symbol": "b_hm",
      "type": "CONSTANT",
      "value": 0.25,
      "unit": "dimensionless",
      "description": "Probability of sexual transmission for contact between homosexual men and heterosexual men (bisexual contact)"
    },
    {
      "symbol": "c_s",
      "type": "CONSTANT",
      "value": 4.0,
      "unit": "1/year",
      "description": "Rate of number of sexual partners for heterosexual contact"
    },
    {
      "symbol": "c_h",
      "type": "CONSTANT",
      "value": 7.0,
      "unit": "1/year",
      "description": "Rate of number of sexual partners for exclusive homosexual contact among homosexual men"
    },
    {
      "symbol": "c_hw",
      "type": "CONSTANT",
      "value": 2.0,
      "unit": "1/year",
      "description": "Rate of number of sexual partners for contact between homosexual men and women"
    },
    {
      "symbol": "c_hm",
      "type": "CONSTANT",
      "value": 1.0,
      "unit": "1/year",
      "description": "Rate of number of sexual partners for contact between homosexual men and heterosexual men"
    },
    {
      "symbol": "C_hom_rec",
      "type": "EXPRESSION",
      "value": "C*h*(1-c)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible homosexual men: C h (1-c)"
    },
    {
      "symbol": "C_w_rec",
      "type": "EXPRESSION",
      "value": "C*(1-h)",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible women: C (1-h)"
    },
    {
      "symbol": "C_hetm_rec",
      "type": "EXPRESSION",
      "value": "C*h*c",
      "unit": "individuals/year",
      "description": "Recruitment into susceptible heterosexual men: C h c"
    }
  ]
