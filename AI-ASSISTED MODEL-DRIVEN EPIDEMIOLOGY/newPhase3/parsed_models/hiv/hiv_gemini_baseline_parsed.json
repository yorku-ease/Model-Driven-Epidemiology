  "parameters": [
    {
      "symbol": "C",
      "type": "CONSTANT",
      "value": 333.0,
      "unit": "Individuals/year",
      "description": "Constant recruitment in susceptible populations"
    },
    {
      "symbol": "h",
      "type": "CONSTANT",
      "value": 0.48,
      "unit": "Nondimensional",
      "description": "Proportion of men in the population"
    },
    {
      "symbol": "c",
      "type": "CONSTANT",
      "value": 0.92,
      "unit": "Nondimensional",
      "description": "Proportion of heterosexual men among all men"
    },
    {
      "symbol": "\u03bb",
      "type": "CONSTANT",
      "value": 0.0129,
      "unit": "1/year",
      "description": "Natural mortality rate"
    },
    {
      "symbol": "\u03b4",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "Induced disease mortality rate for people with AIDS"
    },
    {
      "symbol": "d",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "1/year",
      "description": "AIDS development rate in treated individuals"
    },
    {
      "symbol": "\u03b1",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "Departure rate from infected to treated (ART enrollment)"
    },
    {
      "symbol": "b_s",
      "type": "CONSTANT",
      "value": 0.02,
      "unit": "Nondimensional",
      "description": "Probability of heterosexual transmission"
    },
    {
      "symbol": "c_s",
      "type": "CONSTANT",
      "value": 4.0,
      "unit": "1/year",
      "description": "Sexual partner rate for heterosexuals"
    },
    {
      "symbol": "b_h",
      "type": "CONSTANT",
      "value": 0.44,
      "unit": "Nondimensional",
      "description": "Probability of homosexual transmission"
    },
    {
      "symbol": "c_h",
      "type": "CONSTANT",
      "value": 7.0,
      "unit": "1/year",
      "description": "Sexual partner rate for homosexuals"
    },
    {
      "symbol": "b_hw",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "Nondimensional",
      "description": "Probability of transmission from homosexual men to women"
    },
    {
      "symbol": "c_hw",
      "type": "CONSTANT",
      "value": 2.0,
      "unit": "1/year",
      "description": "Sexual partner rate between homosexual men and women"
    },
    {
      "symbol": "b_hm",
      "type": "CONSTANT",
      "value": 0.25,
      "unit": "Nondimensional",
      "description": "Probability of transmission from homosexual men to heterosexual men"
    },
    {
      "symbol": "c_hm",
      "type": "CONSTANT",
      "value": 1.0,
      "unit": "1/year",
      "description": "Sexual partner rate between homosexual men and heterosexual men"
    },
    {
      "symbol": "k_s",
      "type": "EXPRESSION",
      "value": "b_s * c_s",
      "unit": "1/year",
      "description": "Heterosexual transmission rate"
    },
    {
      "symbol": "k_h",
      "type": "EXPRESSION",
      "value": "b_h * c_h",
      "unit": "1/year",
      "description": "Homosexual transmission rate"
    },
    {
      "symbol": "k_hw",
      "type": "EXPRESSION",
      "value": "b_hw * c_hw",
      "unit": "1/year",
      "description": "Bisexual (homosexual men to/from women) transmission rate"
    },
    {
      "symbol": "k_hm",
      "type": "EXPRESSION",
      "value": "b_hm * c_hm",
      "unit": "1/year",
      "description": "Bisexual (homosexual men to/from heterosexual men) transmission rate"
    },
    {
      "symbol": "\u039b_h",
      "type": "EXPRESSION",
      "value": "C * h * (1 - c)",
      "unit": "Individuals/year",
      "description": "Recruitment rate of susceptible homosexual men"
    },
    {
      "symbol": "\u039b_w",
      "type": "EXPRESSION",
      "value": "C * (1 - h)",
      "unit": "Individuals/year",
      "description": "Recruitment rate of susceptible women"
    },
    {
      "symbol": "\u039b_m",
      "type": "EXPRESSION",
      "value": "C * h * c",
      "unit": "Individuals/year",
      "description": "Recruitment rate of susceptible heterosexual men"
    }
  ]
}