{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EpiMDE Canonical JSON",
  "description": "Output schema for xmlParsestojson.py — converts .compmodel XML into this flat structure for the evaluator.",
  "type": "object",
  "required": ["compartments", "flows", "parameters"],

  "properties": {

    "compartments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":             { "type": "string" },
          "secondary_name":  { "type": "string" },
          "initial_population": { "type": ["number", "null"] }
        }
      }
    },

    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source":              { "type": ["string", "null"] },
          "target":              { "type": ["string", "null"] },
          "type":                { "type": "string", "enum": ["ContactFlow", "RateFlow", "BirthSource", "DeathSink"] },
          "contact_compartment": { "type": ["string", "null"] },
          "rate_parameter":      { "type": ["string", "null"] },
          "rate_value":          { "type": ["number", "null"] },
          "rate_unit":           { "type": ["string", "null"] },
          "description":         { "type": "string" }
        }
      }
    },

    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol":      { "type": "string" },
          "type":        { "type": "string", "enum": ["CONSTANT", "VARIABLE", "EXPRESSION"] },
          "value":       { "type": ["number", "string", "null"] },
          "unit":        { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
