      "value": 0.92,
      "unit": "Nondimensional",
      "description": "Proportion of heterosexual men among all men"
    },
    {
      "symbol": "p",
      "type": "CONSTANT",
      "value": 0.9,
      "unit": "Nondimensional",
      "description": "Proportion of infected individuals who enroll in ART"
    },
    {
      "symbol": "\u03bb",
      "type": "CONSTANT",
      "value": 0.0129,
      "unit": "1/year",
      "description": "Natural mortality rate"
    },
    {
      "symbol": "d",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "AIDS-induced mortality rate for individuals in compartment A"
    },
    {
      "symbol": "\u03b4",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "1/year",
      "description": "AIDS development rate in treated individuals (T to A) due to treatment failure"
    },
    {
      "symbol": "\u03b1",
      "type": "CONSTANT",
      "value": 0.3333,
      "unit": "1/year",
      "description": "Departure rate from untreated infected compartments (I)"
    },
    {
      "symbol": "b_s",
      "type": "CONSTANT",
      "value": 0.02,
      "unit": "Nondimensional",
      "description": "Probability of sexual transmission (heterosexual contact)"
    },
    {
      "symbol": "b_h",
      "type": "CONSTANT",
      "value": 0.44,
      "unit": "Nondimensional",
      "description": "Probability of sexual transmission (homosexual contact)"
    },
    {
      "symbol": "b_hw",
      "type": "CONSTANT",
      "value": 0.018,
      "unit": "Nondimensional",
      "description": "Probability of sexual transmission (homosexual men to women)"
    },
    {
      "symbol": "b_hm",
      "type": "CONSTANT",
      "value": 0.25,
      "unit": "Nondimensional",
      "description": "Probability of sexual transmission (homosexual men to heterosexual men)"
    },
    {
      "symbol": "c_s",
      "type": "CONSTANT",
      "value": 4.0,
      "unit": "1/year",
      "description": "Sexual partner rate (heterosexuals)"
    },
    {
      "symbol": "c_h",
      "type": "CONSTANT",
      "value": 7.0,
      "unit": "1/year",
      "description": "Sexual partner rate (homosexuals)"
    },
    {
      "symbol": "c_hw",
      "type": "CONSTANT",
      "value": 2.0,
      "unit": "1/year",
      "description": "Sexual partner rate (homosexual men with women)"
    },
    {
      "symbol": "c_hm",
      "type": "CONSTANT",
      "value": 1.0,
      "unit": "1/year",
      "description": "Sexual partner rate (homosexual men with heterosexual men)"
    },
    {
      "symbol": "\u039b_h",
      "type": "EXPRESSION",
      "value": "C * h * (1 - c)",
      "unit": "Individuals/year",
      "description": "Recruitment rate for susceptible homosexual men"
    },
    {
      "symbol": "\u039b_w",
      "type": "EXPRESSION",
      "value": "C * (1 - h)",
      "unit": "Individuals/year",
      "description": "Recruitment rate for susceptible women"
    },
    {
      "symbol": "\u039b_m",
      "type": "EXPRESSION",
      "value": "C * h * c",
      "unit": "Individuals/year",
      "description": "Recruitment rate for susceptible heterosexual men"
    },
    {
      "symbol": "\u03b2_s",
      "type": "EXPRESSION",
      "value": "b_s * c_s",
      "unit": "1/year",
      "description": "Effective contact rate for heterosexual transmission"
    },
    {
      "symbol": "\u03b2_h",
      "type": "EXPRESSION",
      "value": "b_h * c_h",
      "unit": "1/year",
      "description": "Effective contact rate for homosexual transmission"
    },
    {
      "symbol": "\u03b2_hw",
      "type": "EXPRESSION",
      "value": "b_hw * c_hw",
      "unit": "1/year",
      "description": "Effective contact rate for homosexual men to women transmission"
    },
    {
      "symbol": "\u03b2_hm",
      "type": "EXPRESSION",
      "value": "b_hm * c_hm",
      "unit": "1/year",
      "description": "Effective contact rate for homosexual men to heterosexual men transmission"
    },
    {
      "symbol": "rate_I_to_T",
      "type": "EXPRESSION",
      "value": "p * \u03b1",
      "unit": "1/year",
      "description": "Rate of starting ART for infected individuals"
    },
    {
      "symbol": "rate_I_to_A",
      "type": "EXPRESSION",
      "value": " (1 - p) * \u03b1",
      "unit": "1/year",
      "description": "Rate of developing AIDS for untreated infected individuals"
    },
    {
      "symbol": "k_h",
      "type": "EXPRESSION",
      "value": "\u03b2_h * Ih / (Sh + Ih)",
      "unit": "1/year",
      "description": "Force of infection for susceptible homosexual men"
    },
    {
      "symbol": "k_wm",
      "type": "EXPRESSION",
      "value": "\u03b2_s * Im / (Sm + Im)",
      "unit": "1/year",
      "description": "Force of infection for susceptible women from heterosexual men"
    },
    {
      "symbol": "k_wh",
      "type": "EXPRESSION",
      "value": "\u03b2_hw * Ih / (Sh + Ih)",
      "unit": "1/year",
      "description": "Force of infection for susceptible women from homosexual men"
    },
    {
      "symbol": "k_mw",
      "type": "EXPRESSION",
      "value": "\u03b2_s * Iw / (Sw + Iw)",
      "unit": "1/year",
      "description": "Force of infection for susceptible heterosexual men from women"
    },
    {
      "symbol": "k_mh",
      "type": "EXPRESSION",
      "value": "\u03b2_hm * Ih / (Sh + Ih)",
      "unit": "1/year",
      "description": "Force of infection for susceptible heterosexual men from homosexual men"
    }
  ]
