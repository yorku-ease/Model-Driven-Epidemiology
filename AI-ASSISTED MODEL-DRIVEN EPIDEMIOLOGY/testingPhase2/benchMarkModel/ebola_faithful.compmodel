<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="1000">

  <!-- Compartments: S, I, Q, R, B (environment pathogens), D (deceased). [file:24] -->

  <compartments PrimaryName="Susceptible" SecondaryName="S" population="999">
    <!-- S -> I via contact with infectious humans (β1 in Table 1). [file:24] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.1"
      contactRateParameter="//@parameters.2"
      description="S→I via infectious humans (effective contact rate β1)."/>
    <!-- S -> I via contact with environmental pathogens B (β2 in Table 1). [file:24] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.4"
      contactRateParameter="//@parameters.3"
      description="S→I via environment/pathogens B (contact rate β2)."/>
    <!-- S -> I via contact with deceased D (β3 in Table 1). [file:24] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.5"
      contactRateParameter="//@parameters.4"
      description="S→I via deceased (contact rate β3)."/>
  </compartments>

  <compartments PrimaryName="Infectious" SecondaryName="I" population="1">
    <!-- I -> Q at quarantine rate ω3. [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.8"
      description="I→Q at quarantine rate ω3."/>
    <!-- I -> R at recovery rate ω1 (from infectious). [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.9"
      description="I→R at recovery rate ω1."/>
    <!-- I -> D at disease-induced death rate δ1. [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.6"
      description="I→D at disease death rate δ1."/>
    <!-- I -> B shedding into environment at rate ω2 (infected shedding). [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.7"
      description="I→B shedding of pathogens into environment at rate ω2."/>
  </compartments>

  <compartments PrimaryName="Quarantine" SecondaryName="Q" population="0">
    <!-- Q -> R at recovery rate ω1 (quarantine recovery). [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.10"
      description="Q→R at recovery-from-quarantine rate ω1q."/>
    <!-- Q -> D at death-in-quarantine rate δ2. [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.11"
      description="Q→D at death-in-quarantine rate δ2."/>
  </compartments>

  <compartments PrimaryName="Recovered" SecondaryName="R" population="0"/>

  <compartments PrimaryName="Environment pathogens" SecondaryName="B" population="0">
    <!-- B decays/clears at rate μ1 (environmental removal). [file:24] -->
    <externalSinks name="Env_clearance" rateParameter="//@parameters.14" sourceCompartment="//@compartments.4"/>
  </compartments>

  <compartments PrimaryName="Deceased" SecondaryName="D" population="0">
    <!-- D -> (removed / safely buried) at rate ρ (burial). [file:24] -->
    <externalSinks name="Burial" rateParameter="//@parameters.12" sourceCompartment="//@compartments.5"/>
    <!-- D -> B shedding into environment at rate η (shedding from deceased). [file:24] -->
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.13"
      description="D→B shedding from deceased at rate η."/>
  </compartments>

  <!-- Recruitment and natural death -->
  <externalSources name="Recruitment" rateParameter="//@parameters.0" targetCompartment="//@compartments.0"/>
  <externalSinks name="Natural_death_S" rateParameter="//@parameters.1" sourceCompartment="//@compartments.0"/>
  <externalSinks name="Natural_death_I" rateParameter="//@parameters.1" sourceCompartment="//@compartments.1"/>
  <externalSinks name="Natural_death_Q" rateParameter="//@parameters.1" sourceCompartment="//@compartments.2"/>
  <externalSinks name="Natural_death_R" rateParameter="//@parameters.1" sourceCompartment="//@compartments.3"/>

  <!-- Parameters: use paper’s Table 1 names/roles (values optional here). [file:24] -->
  <parameters name="Λ" expression="0.38461" description="Recruitment of susceptibles (Λ)" unit="people/time"/>          <!-- ω1 in paper text is different; keep Λ for clarity -->
  <parameters name="μ" expression="0.00038461" description="Natural human death rate (μ)" unit="1/time"/>

  <parameters name="β1" expression="0.0" description="Effective contact rate with infectious humans" unit="1/time"/>
  <parameters name="β2" expression="0.0" description="Effective contact rate with pathogens in environment" unit="1/time"/>
  <parameters name="β3" expression="0.0" description="Effective contact rate with deceased humans" unit="1/time"/>

  <parameters name="δ1" expression="0.0" description="Disease-induced death rate from I" unit="1/time"/>
  <parameters name="ω2" expression="0.0" description="Shedding rate from I into environment" unit="1/time"/>
  <parameters name="ω3" expression="0.0" description="Quarantine rate (I→Q)" unit="1/time"/>

  <parameters name="ω1" expression="0.0" description="Recovery rate from I (I→R)" unit="1/time"/>
  <parameters name="ω1q" expression="0.0" description="Recovery rate from Q (Q→R)" unit="1/time"/>
  <parameters name="δ2" expression="0.0" description="Death rate in quarantine (Q→D)" unit="1/time"/>

  <parameters name="η" expression="0.0" description="Shedding rate from deceased into environment (D→B)" unit="1/time"/>
  <parameters name="ρ" expression="0.0" description="Burial/removal rate of deceased (D removed)" unit="1/time"/>
  <parameters name="μB" expression="0.0" description="Clearance/decay rate of pathogens in environment" unit="1/time"/>

</compartmental:CompartmentalModel>

