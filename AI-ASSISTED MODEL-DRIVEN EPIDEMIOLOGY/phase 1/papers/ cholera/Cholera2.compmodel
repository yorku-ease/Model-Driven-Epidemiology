<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="11000000">

  <!--
    Synthesized national cholera vaccination model for the Haiti study:
    "Achieving coordinated national immunity and cholera elimination in Haiti through vaccination" (Lancet Glob Health, 2020).

    Important note:
    The paper is a MULTI-MODEL study (4 different models), including stochastic compartmental,
    deterministic metapopulation, stochastic metapopulation, and agent-based models.
    The paper does not provide one single canonical compartment diagram/equation system in the main text.

    Therefore this .compmodel is a faithful SYNTHESIS of the paper's shared epidemiological assumptions:
    - national cholera transmission in Haiti;
    - vaccinated vs unvaccinated populations;
    - different protection for adults vs children under 5;
    - one-dose vs two-dose oral cholera vaccine protection;
    - waning vaccine protection;
    - symptomatic and asymptomatic infection;
    - recovery and waning natural immunity;
    - environmental bacterial reservoir, which is a major cholera mechanism discussed in the paper.

    It is designed to match the style of the user's existing compmodels and to be reusable for scenario modelling.
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible adults" population="8800000">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.0"
      description="Adult infection through environmental exposure to Vibrio cholerae reservoir"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.2"
      rateParameter="//@parameters.9"
      description="Vaccination campaign: adults receiving two OCV doses"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.4"
      rateParameter="//@parameters.10"
      description="Vaccination campaign: adults receiving one OCV dose"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Susceptible children under 5" population="1200000">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.1"
      description="Child infection through environmental exposure; vaccine efficacy is lower for children under 5"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.3"
      rateParameter="//@parameters.9"
      description="Vaccination campaign: children receiving two OCV doses"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.5"
      rateParameter="//@parameters.10"
      description="Vaccination campaign: children receiving one OCV dose"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="Vaccinated adults (two doses)" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.2"
      description="Breakthrough infection in adults after two-dose vaccination"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.0"
      rateParameter="//@parameters.11"
      description="Waning of two-dose adult vaccine protection"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="Vaccinated children under 5 (two doses)" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.3"
      description="Breakthrough infection in children after two-dose vaccination; reduced protection relative to adults"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.1"
      rateParameter="//@parameters.11"
      description="Waning of two-dose child vaccine protection"/>
  </compartments>

  <!-- 4 -->
  <compartments PrimaryName="Vaccinated adults (one dose)" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.4"
      description="Breakthrough infection in adults after one-dose vaccination"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.0"
      rateParameter="//@parameters.12"
      description="Loss of one-dose protection after the first year"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="Vaccinated children under 5 (one dose)" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6"
      contactCompartment="//@compartments.9" contactRateParameter="//@parameters.5"
      description="Breakthrough infection in children after one-dose vaccination"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.1"
      rateParameter="//@parameters.12"
      description="Loss of one-dose protection after the first year"/>
  </compartments>

  <!-- 6 -->
  <compartments PrimaryName="Exposed / recently infected" population="10">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.7"
      rateParameter="//@parameters.6"
      description="Fraction progressing to symptomatic infectious cholera"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.8"
      rateParameter="//@parameters.7"
      description="Fraction progressing to asymptomatic infectious cholera"/>
  </compartments>

  <!-- 7 -->
  <compartments PrimaryName="Symptomatic infectious" population="3">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10"
      rateParameter="//@parameters.8"
      description="Recovery from symptomatic infection"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.9"
      rateParameter="//@parameters.14"
      description="Shedding of Vibrio cholerae into environmental reservoir from symptomatic cases"/>
  </compartments>

  <!-- 8 -->
  <compartments PrimaryName="Asymptomatic infectious" population="7">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10"
      rateParameter="//@parameters.8"
      description="Recovery from asymptomatic infection"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.9"
      rateParameter="//@parameters.15"
      description="Environmental shedding from asymptomatic infections (lower than symptomatic)"/>
  </compartments>

  <!-- 9 -->
  <compartments PrimaryName="Environmental Vibrio cholerae reservoir" population="1"/>

  <!-- 10 -->
  <compartments PrimaryName="Recovered / naturally immune" population="1000">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.0"
      rateParameter="//@parameters.13"
      description="Waning of natural immunity in adults/mixed national population"/>
  </compartments>

  <!-- Demographic replenishment into susceptible pools -->
  <externalSources name="Adult recruitment" rateParameter="//@parameters.16" targetCompartment="//@compartments.0"/>
  <externalSources name="Child recruitment" rateParameter="//@parameters.17" targetCompartment="//@compartments.1"/>

  <!-- Natural mortality -->
  <externalSinks name="Natural death susceptible adults" rateParameter="//@parameters.18" sourceCompartment="//@compartments.0"/>
  <externalSinks name="Natural death susceptible children" rateParameter="//@parameters.18" sourceCompartment="//@compartments.1"/>
  <externalSinks name="Natural death vaccinated adults two-dose" rateParameter="//@parameters.18" sourceCompartment="//@compartments.2"/>
  <externalSinks name="Natural death vaccinated children two-dose" rateParameter="//@parameters.18" sourceCompartment="//@compartments.3"/>
  <externalSinks name="Natural death vaccinated adults one-dose" rateParameter="//@parameters.18" sourceCompartment="//@compartments.4"/>
  <externalSinks name="Natural death vaccinated children one-dose" rateParameter="//@parameters.18" sourceCompartment="//@compartments.5"/>
  <externalSinks name="Natural death exposed" rateParameter="//@parameters.18" sourceCompartment="//@compartments.6"/>
  <externalSinks name="Natural death symptomatic" rateParameter="//@parameters.18" sourceCompartment="//@compartments.7"/>
  <externalSinks name="Natural death asymptomatic" rateParameter="//@parameters.18" sourceCompartment="//@compartments.8"/>
  <externalSinks name="Natural death recovered" rateParameter="//@parameters.18" sourceCompartment="//@compartments.10"/>

  <!-- Cholera mortality -->
  <externalSinks name="Disease-induced death from symptomatic cholera" rateParameter="//@parameters.19" sourceCompartment="//@compartments.7"/>

  <!-- Environmental decay -->
  <externalSinks name="Bacterial decay" rateParameter="//@parameters.20" sourceCompartment="//@compartments.9"/>

  <!-- Parameters -->
  <parameters name="βA" expression="0.35" description="Adult environmental transmission/contact rate" unit="1/week"/>
  <parameters name="βC" expression="0.35" description="Child environmental transmission/contact rate" unit="1/week"/>
  <parameters name="βA_2dose" type="EXPRESSION" expression="βA * (1 - VE2A)" description="Breakthrough transmission rate for adults after two doses" unit="1/week"/>
  <parameters name="βC_2dose" type="EXPRESSION" expression="βC * (1 - VE2C)" description="Breakthrough transmission rate for children under 5 after two doses" unit="1/week"/>
  <parameters name="βA_1dose" type="EXPRESSION" expression="βA * (1 - VE1A)" description="Breakthrough transmission rate for adults after one dose" unit="1/week"/>
  <parameters name="βC_1dose" type="EXPRESSION" expression="βC * (1 - VE1C)" description="Breakthrough transmission rate for children under 5 after one dose" unit="1/week"/>
  <parameters name="σ*k" expression="0.14" description="Progression from exposure to symptomatic infection" unit="1/week"/>
  <parameters name="(1-σ)*k" expression="0.21" description="Progression from exposure to asymptomatic infection" unit="1/week"/>
  <parameters name="γ" expression="0.5" description="Recovery rate from infectious cholera" unit="1/week"/>

  <parameters name="ν2" expression="0.015" description="Campaign vaccination rate into two-dose classes; scenario-dependent rollout parameter" unit="1/week"/>
  <parameters name="ν1" expression="0.002" description="Campaign vaccination rate into one-dose classes; scenario-dependent rollout parameter" unit="1/week"/>
  <parameters name="ω2" expression="0.00385" description="Waning rate of two-dose protection; approximately 5-year horizon" unit="1/week"/>
  <parameters name="ω1" expression="0.01923" description="Waning rate of one-dose protection; protection assumed lost after about 1 year" unit="1/week"/>
  <parameters name="ωR" expression="0.01" description="Waning rate of natural immunity" unit="1/week"/>

  <parameters name="ξS" expression="0.8" description="Shedding rate from symptomatic infectious individuals into environmental reservoir" unit="1/week"/>
  <parameters name="ξA" expression="0.2" description="Shedding rate from asymptomatic infectious individuals into environmental reservoir" unit="1/week"/>

  <parameters name="ΛA" expression="2500" description="Recruitment rate into adult susceptible class" unit="persons/week"/>
  <parameters name="ΛC" expression="800" description="Recruitment rate into child susceptible class" unit="persons/week"/>
  <parameters name="μ" expression="0.00023" description="Natural mortality rate" unit="1/week"/>
  <parameters name="δ" expression="0.002" description="Disease-induced death rate for symptomatic cholera" unit="1/week"/>
  <parameters name="μB" expression="0.6" description="Environmental bacterial decay rate" unit="1/week"/>

  <!-- Vaccine effectiveness assumptions derived from the paper's shared assumptions -->
  <parameters name="VE2A" expression="0.76" description="Initial effectiveness of two-dose OCV in adults" unit="dimensionless"/>
  <parameters name="VE2C" type="EXPRESSION" expression="0.469 * VE2A" description="Two-dose vaccine effectiveness in children under 5, scaled as 46.9% of adult protection" unit="dimensionless"/>
  <parameters name="VE1A" expression="0.76" description="One-dose adult protection during the first year, assumed equal initially to two-dose protection" unit="dimensionless"/>
  <parameters name="VE1C" type="EXPRESSION" expression="0.469 * VE1A" description="One-dose protection in children under 5 during the first year" unit="dimensionless"/>

</compartmental:CompartmentalModel>
