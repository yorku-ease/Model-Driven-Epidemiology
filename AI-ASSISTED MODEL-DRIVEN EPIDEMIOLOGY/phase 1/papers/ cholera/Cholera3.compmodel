<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="10000">

  <!--
    Faithful structural encoding of Codeço (2001), "Endemic and epidemic dynamics of cholera:
    the role of the aquatic reservoir".

    Main paper structure:
      - State variables: S (susceptible), I (infected), B (aquatic toxigenic V. cholerae).
      - Recovered individuals are implicit and can be estimated as H - S - I.
      - Infection is dose-dependent: a * B / (K + B). Because the current compmodel metamodel
        supports contact flows but not state-dependent saturating incidence terms directly,
        the S→I transition is encoded as an environmental contact flow using B as the contact
        compartment and parameter a. K is retained as a parameter for semantic fidelity.
      - Bacterial environmental dynamics are B' = (nb - mb) B + e I.
        In the common endemic/epidemic setting analysed in the paper, mb > nb, so this is
        represented exactly as human shedding I→B plus a net bacterial loss sink (mb - nb) from B.
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible" population="9999">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.2"
      description="Environmental infection S→I through exposure to contaminated water; paper incidence uses a * B / (K + B)"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Infected" population="1">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.7"
      description="Human shedding into aquatic reservoir: I contributes e units of toxigenic V. cholerae to B"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="Aquatic toxigenic Vibrio cholerae" population="0"/>

  <!-- Human renewal and removal -->
  <externalSources name="Renewal into susceptible population"
    rateParameter="//@parameters.0"
    targetCompartment="//@compartments.0"/>

  <externalSinks name="Natural death / loss from susceptible"
    rateParameter="//@parameters.1"
    sourceCompartment="//@compartments.0"/>

  <externalSinks name="Natural death / loss from infected"
    rateParameter="//@parameters.1"
    sourceCompartment="//@compartments.1"/>

  <externalSinks name="Recovery from infection (implicit recovered class)"
    rateParameter="//@parameters.4"
    sourceCompartment="//@compartments.1"/>

  <!-- Environmental bacterial net loss: (mb - nb) * B, exact when mb > nb -->
  <externalSinks name="Net bacterial loss from aquatic reservoir"
    rateParameter="//@parameters.8"
    sourceCompartment="//@compartments.2"/>

  <!-- Parameters from the paper's notation -->
  <parameters name="nH" type="EXPRESSION" expression="n * H"
    description="Renewal into susceptible population; with constant human population H, influx is nH" unit="persons/day"/>
  <parameters name="n" expression="0.0001"
    description="Human birth and death rate" unit="1/day"/>
  <parameters name="a" expression="1"
    description="Rate of exposure to contaminated water (used in dose-dependent infection term a * B / (K + B))" unit="1/day"/>
  <parameters name="K" expression="1e6"
    description="Concentration of V. cholerae in water giving 50% chance of infection" unit="cells/mL"/>
  <parameters name="r" expression="0.2"
    description="Recovery rate from cholera" unit="1/day"/>
  <parameters name="nb" expression="0"
    description="Growth rate of V. cholerae in the aquatic environment" unit="1/day"/>
  <parameters name="mb" expression="0.33"
    description="Loss rate of V. cholerae in the aquatic environment" unit="1/day"/>
  <parameters name="e" expression="10"
    description="Contribution of each infected person to aquatic V. cholerae concentration" unit="cells/mL/day/person"/>
  <parameters name="mb-nb" type="EXPRESSION" expression="mb - nb"
    description="Net bacterial loss rate in water; exact B sink term when mb > nb" unit="1/day"/>
  <parameters name="H" expression="10000"
    description="Total human population" unit="persons"/>

</compartmental:CompartmentalModel>
