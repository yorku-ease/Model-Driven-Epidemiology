<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel"
  totalPopulation="82051">

  <!-- Faithful to Pokharel et al. (2024): 12-compartment child/adult model with monitored/unmonitored vaccination,
       maturation j from child→adult, infections from (IC+IA), vaccine “leak” via eβ, disease-induced death d from IC,IA,
       and immunity via recovery γ plus immunization flows hU,hM,hA. [file:22] -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible children" population="2142">
    <!-- dSC/dt has infection term βC*(IC+IA)*SC [file:22] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.3"
      contactCompartment="//@compartments.4" contactRateParameter="//@parameters.2"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.3"
      contactCompartment="//@compartments.10" contactRateParameter="//@parameters.2"/>

    <!-- Vaccination of children: xU, xM [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.1"
      rateParameter="//@parameters.0"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.2"
      rateParameter="//@parameters.1"/>

    <!-- Maturation: j SC → SA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.6"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Un-monitored vaccinated children" population="2382">
    <!-- Infection leak in vaccinated unmonitored: eβC*(IC+IA)*UVC [file:22] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.3"
      contactCompartment="//@compartments.4" contactRateParameter="//@parameters.17"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.3"
      contactCompartment="//@compartments.10" contactRateParameter="//@parameters.17"/>

    <!-- Immunization: hU UVC → ImC [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.5"
      rateParameter="//@parameters.9"/>

    <!-- Maturation: j UVC → UVA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.7"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="Monitored vaccinated children" population="50">
    <!-- Immunization: hM MVC → ImC [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.5"
      rateParameter="//@parameters.10"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="Exposed children" population="5">
    <!-- Progression: δ EC → IC [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.4"
      rateParameter="//@parameters.11"/>

    <!-- Maturation: j EC → EA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.9"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- 4 -->
  <compartments PrimaryName="Infectious children" population="2">
    <!-- Recovery: γ IC → ImC [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.5"
      rateParameter="//@parameters.5"/>

    <!-- Maturation: j IC → IA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="Immune children" population="19271">
    <!-- Maturation: j ImC → ImA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11"
      rateParameter="//@parameters.6"/>
  </compartments>

  <!-- 6 -->
  <compartments PrimaryName="Susceptible adults" population="6408">
    <!-- dSA/dt infection term βA*(IC+IA)*SA [file:22] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.9"
      contactCompartment="//@compartments.4" contactRateParameter="//@parameters.3"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.9"
      contactCompartment="//@compartments.10" contactRateParameter="//@parameters.3"/>

    <!-- Adult vaccination: xA SA → VA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.8"
      rateParameter="//@parameters.13"/>
  </compartments>

  <!-- 7 -->
  <compartments PrimaryName="Un-monitored vaccinated adults" population="5703">
    <!-- Infection leak in adult unmonitored vaccinated: eβA*(IC+IA)*UVA [file:22] -->
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.9"
      contactCompartment="//@compartments.4" contactRateParameter="//@parameters.18"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.9"
      contactCompartment="//@compartments.10" contactRateParameter="//@parameters.18"/>

    <!-- Immunization: hA UVA → ImA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11"
      rateParameter="//@parameters.8"/>
  </compartments>

  <!-- 8 -->
  <compartments PrimaryName="Vaccinated adults (catch-up/monitored)" population="0">
    <!-- Immunization: hA VA → ImA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11"
      rateParameter="//@parameters.8"/>
  </compartments>

  <!-- 9 -->
  <compartments PrimaryName="Exposed adults" population="3">
    <!-- Progression: δ EA → IA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10"
      rateParameter="//@parameters.11"/>
  </compartments>

  <!-- 10 -->
  <compartments PrimaryName="Infectious adults" population="1">
    <!-- Recovery: γ IA → ImA [file:22] -->
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11"
      rateParameter="//@parameters.5"/>
  </compartments>

  <!-- 11 -->
  <compartments PrimaryName="Immune adults" population="46145"/>

  <!-- Recruitment into SC: L [file:22] -->
  <externalSources name="Birth" rateParameter="//@parameters.16" targetCompartment="//@compartments.0"/>

  <!-- Natural death m from all compartments [file:22] -->
  <externalSinks name="Natural_Death_SC"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.0"/>
  <externalSinks name="Natural_Death_UVC" rateParameter="//@parameters.4" sourceCompartment="//@compartments.1"/>
  <externalSinks name="Natural_Death_MVC" rateParameter="//@parameters.4" sourceCompartment="//@compartments.2"/>
  <externalSinks name="Natural_Death_EC"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.3"/>
  <externalSinks name="Natural_Death_IC"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.4"/>
  <externalSinks name="Natural_Death_ImC" rateParameter="//@parameters.4" sourceCompartment="//@compartments.5"/>
  <externalSinks name="Natural_Death_SA"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.6"/>
  <externalSinks name="Natural_Death_UVA" rateParameter="//@parameters.4" sourceCompartment="//@compartments.7"/>
  <externalSinks name="Natural_Death_VA"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.8"/>
  <externalSinks name="Natural_Death_EA"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.9"/>
  <externalSinks name="Natural_Death_IA"  rateParameter="//@parameters.4" sourceCompartment="//@compartments.10"/>
  <externalSinks name="Natural_Death_ImA" rateParameter="//@parameters.4" sourceCompartment="//@compartments.11"/>

  <!-- Disease-induced death d from IC and IA only [file:22] -->
  <externalSinks name="Disease-induced_Death_IC" rateParameter="//@parameters.12" sourceCompartment="//@compartments.4"/>
  <externalSinks name="Disease-induced_Death_IA" rateParameter="//@parameters.12" sourceCompartment="//@compartments.10"/>

  <!-- Parameters: naming aligned to paper (xU,xM,xA, βC,βA, m, γ, j, e, hA,hU,hM, δ, d, L, q, α). [file:22] -->
  <parameters name="ξU" expression="0.0087"  description="Un-monitored child vaccination rate (xU)" unit="1/week"/>
  <parameters name="ξM" expression="4.77e-5" description="Monitored child vaccination rate (xM)" unit="1/week"/>
  <parameters name="βC" expression="0.00188" description="Child transmission rate (βC)" unit="1/week"/>
  <parameters name="βA" expression="1.00e-5" description="Adult transmission rate (βA)" unit="1/week"/>
  <parameters name="m"  expression="2.68e-4" description="Natural death rate (m)" unit="1/week"/>
  <parameters name="γ"  expression="0.5"     description="Recovery-immunity rate after infection (g)" unit="1/week"/>
  <parameters name="φ"  expression="0.00128" description="Maturation rate child→adult (j)" unit="1/week"/>
  <parameters name="e"  expression="0.2"     description="Vaccine failure fraction; vaccine effectiveness is (1-e)" unit="dimensionless"/>
  <parameters name="ηA" expression="0"       description="Immunization rate for adult vaccinated groups (hA)" unit="1/week"/>
  <parameters name="ηU" expression="3e-6"    description="Immunization rate for un-monitored vaccinated children (hU)" unit="1/week"/>
  <parameters name="ηM" expression="0.0167"  description="Immunization rate for monitored vaccinated children (hM)" unit="1/week"/>
  <parameters name="δ"  expression="0.7"     description="Incubation progression rate E→I (d in paper notation)" unit="1/week"/>
  <parameters name="d"  expression="9.34e-5" description="Disease-induced death rate (d)" unit="1/week"/>
  <parameters name="ξA" expression="0"       description="Adult vaccination rate SA→VA (xA)" unit="1/week"/>
  <parameters name="α"  expression="0.01253" description="Contact network fraction a (portion of population in contact network)" unit="dimensionless"/>
  <parameters name="q"  expression="0.15"    description="Case reporting fraction (used for incidence: q·δ·E(t))" unit="dimensionless"/>
  <parameters name="L"  expression="0.02197" description="Recruitment rate into children susceptible (L)" unit="1/week"/>

  <!-- Derived infection leak rates: eβC and eβA [file:22] -->
  <parameters name="e * βC" type="EXPRESSION" expression="e * βC"
    description="Leak transmission rate for un-monitored vaccinated children" unit="1/week"/>
  <parameters name="e * βA" type="EXPRESSION" expression="e * βA"
    description="Leak transmission rate for un-monitored vaccinated adults" unit="1/week"/>

</compartmental:CompartmentalModel>

