<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Ferguson et al. (2006)
    Strategies for mitigating an influenza pandemic

    This paper primarily uses an individual-based transmission model with
    explicit social contexts (households, schools, workplaces, community),
    not a single published compartment diagram. The nearest faithful
    compartmental abstraction from the paper is an SEIR-type influenza model
    with explicit clinical cases, because the paper distinguishes infected
    persons, clinical cases, and intervention effects such as case isolation,
    household quarantine, antiviral treatment/prophylaxis, and vaccination.

    This .compmodel therefore encodes the core epidemic progression and the
    paper's intervention-relevant state structure:
      S  = susceptible
      E  = latent / exposed
      Ic = infectious clinical case
      Is = infectious subclinical case
      T  = treated clinical case
      P  = prophylaxed / vaccinated protected
      R  = removed / recovered

    Important paper-aligned features preserved:
      - 50% of infections become clinical cases
      - treatment targets clinical cases
      - prophylaxis/vaccination reduce susceptibility
      - epidemic dynamics driven by transmission before removal

    Important limitation:
      the paper's full model has transmission in households, schools,
      workplaces and community plus spatial travel structure. Those social
      layers are represented here semantically via parameter names rather than
      as separate spatial/network compartments.
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible" population="999000">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.2"
      contactRateParameter="//@parameters.0"
      description="Infection of susceptible individuals by clinical infectious cases; corresponds to the paper's transmission processes across households, schools, workplaces and community"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.1"
      contactCompartment="//@compartments.3"
      contactRateParameter="//@parameters.1"
      description="Infection of susceptible individuals by subclinical infectious cases; included because the paper distinguishes infected individuals from clinical cases"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.7"
      description="Protective coverage by prophylaxis or vaccination; represents intervention-driven movement into temporary protection"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="Exposed" population="500">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.2"
      description="Progression from latent infection to clinical infectiousness; approximately half of infections become clinical cases in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.3"
      description="Progression from latent infection to subclinical infectiousness; complements the 50% clinical assumption used in the paper"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="InfectiousClinical" population="250">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.4"
      rateParameter="//@parameters.4"
      description="Rapid antiviral treatment of clinical cases; the paper emphasizes treatment only has strong transmission impact if given within one day of symptom onset"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.5"
      description="Recovery/removal of untreated clinical infectious cases"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="InfectiousSubclinical" population="250">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.6"
      description="Recovery/removal of subclinical infectious cases"/>
  </compartments>

  <!-- 4 -->
  <compartments PrimaryName="TreatedClinical" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.8"
      description="Recovery/removal after antiviral treatment of clinical cases"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="Protected" population="0">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.0"
      rateParameter="//@parameters.9"
      description="Loss of prophylactic or vaccine protection and return to susceptibility"/>
  </compartments>

  <!-- 6 -->
  <compartments PrimaryName="Removed" population="0"/>

  <!-- Parameters -->
  <parameters name="ClinicalTransmissionRate" expression="0.45"
    description="Effective transmission rate from clinical infectious cases in the compartmental abstraction of the paper"/>
  <parameters name="SubclinicalTransmissionRate" expression="0.22"
    description="Effective transmission rate from subclinical infectious cases"/>
  <parameters name="ClinicalProgressionRate" expression="0.38"
    description="Latent-to-clinical progression rate, reflecting that roughly 50 percent of infections become clinical cases in the paper"/>
  <parameters name="SubclinicalProgressionRate" expression="0.38"
    description="Latent-to-subclinical progression rate"/>
  <parameters name="TreatmentRate" expression="1.0"
    description="Rapid treatment rate for clinical cases; chosen to reflect same-day to one-day treatment emphasis in the paper"/>
  <parameters name="ClinicalRecoveryRate" expression="0.33"
    description="Recovery rate from untreated clinical infectiousness"/>
  <parameters name="SubclinicalRecoveryRate" expression="0.33"
    description="Recovery rate from subclinical infectiousness"/>
  <parameters name="ProtectionAcquisitionRate" expression="0.02"
    description="Population movement into temporary protection through prophylaxis or vaccination interventions"/>
  <parameters name="TreatedRecoveryRate" expression="0.5"
    description="Recovery rate from treated clinical infection"/>
  <parameters name="ProtectionLossRate" expression="0.05"
    description="Loss of prophylactic or vaccine-induced protection"/>

</compartmental:CompartmentalModel>
