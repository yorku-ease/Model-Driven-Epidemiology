<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:compartmental="http://example.com/compartmentalmodel">

  <!--
    Paper: Chowell et al. (2009)
    Adaptive Vaccination Strategies to Mitigate Pandemic Influenza: Mexico as a Case Study

    This .compmodel is based directly on the age-structured transmission model
    described in the paper and shown in Figure 1 / Equation (1).

    The published model has 6 age groups:
      0-5, 6-12, 13-19, 20-39, 40-59, 60+
    and 9 epidemiological states in each age group:
      S_i = susceptible
      V_i = effectively vaccinated but not yet protected
      U_i = ineffectively vaccinated
      P_i = protected by vaccination
      E_i = latent
      I_i = symptomatic infectious in community
      H_i = hospitalized
      R_i = recovered
      D_i = dead

    To keep the file usable while remaining faithful to the paper structure,
    this compmodel encodes one representative age stratum with the exact 9-state
    progression logic used in the paper. Age-specific mixing, hospitalization,
    mortality, and vaccine efficacy are preserved semantically through parameter names.

    Core paper-aligned transitions preserved:
      S -> V  effective vaccination
      S -> U  ineffective vaccination
      S/V/U -> E through force of infection
      V -> P after protection delay
      E -> I
      I -> H
      I -> R
      H -> R
      H -> D
  -->

  <!-- 0 -->
  <compartments PrimaryName="Susceptible" population="9800">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.5"
      contactRateParameter="//@parameters.0"
      description="Influenza infection of susceptible individuals through contact with infectious community cases and hospitalized cases, corresponding to the force of infection lambda_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.6"
      contactRateParameter="//@parameters.1"
      description="Influenza infection of susceptible individuals through contact with hospitalized infectious individuals, included in lambda_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.1"
      rateParameter="//@parameters.2"
      description="Effective vaccination of susceptible individuals; corresponds to e_i * nu(t) * S_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.2"
      rateParameter="//@parameters.3"
      description="Ineffective vaccination of susceptible individuals; corresponds to (1-e_i) * nu(t) * S_i in the paper"/>
  </compartments>

  <!-- 1 -->
  <compartments PrimaryName="VaccinatedEffectiveNotYetProtected" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.5"
      contactRateParameter="//@parameters.0"
      description="Breakthrough infection before vaccine-derived protection is established; corresponds to lambda_i * V_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.6"
      contactRateParameter="//@parameters.1"
      description="Breakthrough infection from hospitalized infectious individuals before protection is established"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.3"
      rateParameter="//@parameters.4"
      description="Development of vaccine-derived protection after delay; corresponds to gamma * V_i in the paper"/>
  </compartments>

  <!-- 2 -->
  <compartments PrimaryName="VaccinatedIneffective" population="0">
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.5"
      contactRateParameter="//@parameters.0"
      description="Infection of ineffectively vaccinated individuals; corresponds to lambda_i * U_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow"
      target="//@compartments.4"
      contactCompartment="//@compartments.6"
      contactRateParameter="//@parameters.1"
      description="Infection of ineffectively vaccinated individuals from hospitalized infectious individuals"/>
  </compartments>

  <!-- 3 -->
  <compartments PrimaryName="ProtectedByVaccination" population="0"/>

  <!-- 4 -->
  <compartments PrimaryName="Latent" population="20">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.5"
      rateParameter="//@parameters.5"
      description="Progression from latent infection to symptomatic infectiousness; corresponds to kappa * E_i in the paper"/>
  </compartments>

  <!-- 5 -->
  <compartments PrimaryName="InfectiousCommunity" population="20">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.6"
      rateParameter="//@parameters.6"
      description="Hospitalization of infectious cases; corresponds to a_i * I_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.7"
      description="Recovery of non-hospitalized infectious cases; corresponds to c_1 * I_i in the paper"/>
  </compartments>

  <!-- 6 -->
  <compartments PrimaryName="Hospitalized" population="5">
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.7"
      rateParameter="//@parameters.8"
      description="Recovery from hospitalization; corresponds to c_2 * H_i in the paper"/>
    <outgoingFlows xsi:type="compartmental:RateFlow"
      target="//@compartments.8"
      rateParameter="//@parameters.9"
      description="Influenza mortality among hospitalized cases; corresponds to d_i * H_i in the paper"/>
  </compartments>

  <!-- 7 -->
  <compartments PrimaryName="Recovered" population="0"/>

  <!-- 8 -->
  <compartments PrimaryName="Dead" population="0"/>

  <!-- Parameters -->
  <parameters name="CommunityTransmissionRate" expression="0.45"
    description="Representative age-specific transmission term from infectious community cases; in the paper lambda_i depends on the age-structured contact matrix and transmission probability q"/>
  <parameters name="HospitalTransmissionRate" expression="0.20"
    description="Representative contribution of hospitalized infectious individuals to the force of infection; the paper includes I_j + H_j in the force of infection"/>
  <parameters name="EffectiveVaccinationRate" expression="0.03"
    description="e_i * nu(t), effective vaccination rate for this representative age group"/>
  <parameters name="IneffectiveVaccinationRate" expression="0.01"
    description="(1-e_i) * nu(t), ineffective vaccination rate for this representative age group"/>
  <parameters name="ProtectionDelayRate" expression="0.10"
    description="gamma, rate of becoming protected after vaccination; mean 10 days in the paper"/>
  <parameters name="LatentProgressionRate" expression="0.526"
    description="kappa, progression rate from latent to infectious; based on mean latent period 1.9 days in the paper"/>
  <parameters name="HospitalizationRate" expression="0.08"
    description="a_i, age-specific hospitalization rate among infectious individuals"/>
  <parameters name="CommunityRecoveryRate" expression="0.667"
    description="c_1, recovery rate for infectious individuals in the community; based on mean 1.5 days in the paper"/>
  <parameters name="HospitalRecoveryRate" expression="0.667"
    description="c_2, recovery rate for hospitalized individuals; based on mean 1.5 days in the paper"/>
  <parameters name="HospitalMortalityRate" expression="0.015"
    description="d_i, age-specific mortality rate among hospitalized individuals"/>

</compartmental:CompartmentalModel>
