digraph G {
  graph [bgcolor="white" pad="0.7,0.5" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD ALIGN="LEFT"><FONT FACE="Helvetica Neue" POINT-SIZE="18"><B>Epidemiological Feature Vocabulary</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Helvetica Neue" POINT-SIZE="10" COLOR="#666666">The 17 Boolean flags used to describe any compartmental epidemic model. Per-disease diagrams highlight which flags are active for that disease.</FONT></TD></TR></TABLE>> labelloc=t labeljust=l]
  node [shape=none margin=0]
  main [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6" CELLPADDING="0"><TR><TD BGCOLOR="#daf0fc" BORDER="0" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Helvetica Neue" POINT-SIZE="11" COLOR="#5a9fc2"><B>Transmission routes</B></FONT></TD><TD BGCOLOR="#d4f5e8" BORDER="0" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Helvetica Neue" POINT-SIZE="11" COLOR="#4aaa7a"><B>Natural history &#38; pathogenesis</B></FONT></TD><TD BGCOLOR="#f9f5d9" BORDER="0" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Helvetica Neue" POINT-SIZE="11" COLOR="#c8a838"><B>Population structure</B></FONT></TD><TD BGCOLOR="#fae8fb" BORDER="0" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Helvetica Neue" POINT-SIZE="11" COLOR="#aa6ab8"><B>Non-human hosts</B></FONT></TD><TD BGCOLOR="#ede8fc" BORDER="0" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Helvetica Neue" POINT-SIZE="11" COLOR="#8877cc"><B>Demography</B></FONT></TD></TR><TR><TD HEIGHT="5" BORDER="0"></TD><TD HEIGHT="5" BORDER="0"></TD><TD HEIGHT="5" BORDER="0"></TD><TD HEIGHT="5" BORDER="0"></TD><TD HEIGHT="5" BORDER="0"></TD></TR><TR><TD BGCOLOR="#daf0fc" BORDER="1" COLOR="#5a9fc2" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Vector / Arthropod</FONT></TD><TD BGCOLOR="#d4f5e8" BORDER="1" COLOR="#4aaa7a" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Latent / Exposed</FONT></TD><TD BGCOLOR="#f9f5d9" BORDER="1" COLOR="#c8a838" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Demographic Stratification</FONT></TD><TD BGCOLOR="#fae8fb" BORDER="1" COLOR="#aa6ab8" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Vector / Intermediate Spp.</FONT></TD><TD BGCOLOR="#ede8fc" BORDER="1" COLOR="#8877cc" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Birth / Recruitment</FONT></TD></TR><TR><TD BGCOLOR="#daf0fc" BORDER="1" COLOR="#