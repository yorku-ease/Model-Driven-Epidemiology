TD><TD BORDER="0" CELLPADDING="9"></TD><TD BORDER="0" CELLPADDING="9"></TD></TR><TR><TD BGCOLOR="#daf0fc" BORDER="1" COLOR="#5a9fc2" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Healthcare Contact</FONT></TD><TD BGCOLOR="#d4f5e8" BORDER="1" COLOR="#4aaa7a" CELLPADDING="9" STYLE="rounded"><FONT FACE="Helvetica Neue" POINT-SIZE="10.5" COLOR="#333333">Recovered / Immune</FONT></TD><TD BORDER="0" CELLPADDING="9"></TD><TD BORDER="0" CELLPADDING="9"></TD><TD BORDER="0" CELLPADDING="9"></TD></TR></TABLE>>]
