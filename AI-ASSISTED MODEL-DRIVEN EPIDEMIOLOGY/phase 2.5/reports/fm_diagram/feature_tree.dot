digraph EpidemiologicalFeatureTree {
  graph [
    bgcolor="white",
    fontname="Helvetica",
    fontsize=12,
    margin=0.25,
    pad=0.5,
    nodesep=0.28,
    ranksep=0.75,
    splines=spline,
    compound=false,
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
      <TR><TD ALIGN="LEFT"><B>What this picture is</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.8" COLOR="#333333"><B>Each box</B> names one Yes/No <B>EpiFeatureVector</B> signal: did we infer (from compartments/flows) that gold models use this <B>structural choice?</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#444444">• This is <B>not</B> infection biology or a causal timeline; arrows only group related booleans.<BR ALIGN="LEFT"/>• Coloured sections = themes (transmission routes, clinical course, ...).<BR ALIGN="LEFT"/>• For one disease we OR-merge gold papers into one canonical profile; SPL checks booleans versus cross-tree logic.<BR ALIGN="LEFT"/>• Hover tooltips on leaves in <B>.svg</B> for one-line meanings.</FONT></TD></TR>
    </TABLE>>,
    labelloc=t,
    labeljust=l,
  ];
  node [fontname="Helvetica", fontsize=10.5, color="#333333"];
  edge [color="#6b8299", penwidth=0.85, arrowsize=0.75];
  rankdir=TB;
  "EpidemicCompartmentalModel" [
    shape=box,
    style="filled,rounded",
    fillcolor="#e8edf3",
    penwidth=1.2,
    fontsize=12,
    label="Epidemic compartmental model (abstract root)",
    width=1.6,
  ];

  subgraph cluster_G_Transmission {
    graph [
      label="Transmission ecology\n(parallel optional routes - multi-route models allowed)",
      labelloc=t,
      fontsize=11.5,
      fontname="Helvetica",
      style="rounded,filled",
      fillcolor="#daf0fc",
      color="#6b8299",
      penwidth=1.0,
      margin=14,
    ];
    "G_Transmission" [shape=tab, style="filled,rounded", fillcolor="#ffffff",  fontsize=10.5, label="Transmission ecology"];
    "route_vector_arthropod" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Vector Arthropod", tooltip="Transmission via arthropod / vector compartments or wording (e.g. mosquito)."];
    "route_sexual_or_partner_network" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Sexual Or Partner Network", tooltip="Partnership sexual network or analogous route cues in flows."];
    "route_airborne_or_respiratory_droplet" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Airborne Or Respiratory Droplet", tooltip="Respiratory aerosol droplet airborne wording or lung-focused flows."];
    "route_fecal_oral_or_waterborne" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Fecal Oral Or Waterborne", tooltip="Fecal-oral, oral, water/food-associated transmission wording."];
    "route_bloodborne_vertical_or_parenteral" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Bloodborne Vertical Or Parenteral", tooltip="Blood, syringe, maternal-fetal vertical, parental cues."];
    "route_healthcare_general_contact" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Route Healthcare General Contact", tooltip="Hospital ward, HCW, nonspecific institutional contact wording."];
    "G_Transmission" -> "route_vector_arthropod" [ penwidth=1.05 ];
    "route_vector_arthropod" -> "route_sexual_or_partner_network" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "route_sexual_or_partner_network" -> "route_airborne_or_respiratory_droplet" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "route_airborne_or_respiratory_droplet" -> "route_fecal_oral_or_waterborne" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "route_fecal_oral_or_waterborne" -> "route_bloodborne_vertical_or_parenteral" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "route_bloodborne_vertical_or_parenteral" -> "route_healthcare_general_contact" [ color="#aab8c6", penwidth=0.75, constraint=true ];
  }

  "EpidemicCompartmentalModel" -> "G_Transmission" [ penwidth=1.2 ];

  subgraph cluster_G_ClinicalPath {
    graph [
      label="Natural history \& pathogenesis",
      labelloc=t,
      fontsize=11.5,
      fontname="Helvetica",
      style="rounded,filled",
      fillcolor="#d4f5e8",
      color="#6b8299",
      penwidth=1.0,
      margin=14,
    ];
    "G_ClinicalPath" [shape=tab, style="filled,rounded", fillcolor="#ffffff",  fontsize=10.5, label="Natural history \& pathogenesis"];
    "latent_or_exposed_class" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Latent Or Exposed Class", tooltip="Latent, exposed, Eh, incubating, chronic carrier style compartment classes."];
    "multiple_infectious_stages_or_chronic" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Multiple Infectious Stages Or Chronic", tooltip="Multiple sequential infectious strata or staged chronic progression."];
    "hospitalized_or_severity_stratification" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Hospitalized Or Severity Stratification", tooltip="Hospitalized ICU severe mild stratified clinical severity strata."];
    "treatment_or_art_intervention" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Treatment Or Art Intervention", tooltip="Treatment ART therapy drug compartments or explicit therapy flows."];
    "vaccination_route_compartment" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Vaccination Route Compartment", tooltip="Vaccinated vaccine immune compartment wording."];
    "recovered_or_immune_endpoint" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Recovered Or Immune Endpoint", tooltip="Recovered immune endpoint compartment naming."];
    "G_ClinicalPath" -> "latent_or_exposed_class" [ penwidth=1.05 ];
    "latent_or_exposed_class" -> "multiple_infectious_stages_or_chronic" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "multiple_infectious_stages_or_chronic" -> "hospitalized_or_severity_stratification" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "hospitalized_or_severity_stratification" -> "treatment_or_art_intervention" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "treatment_or_art_intervention" -> "vaccination_route_compartment" [ color="#aab8c6", penwidth=0.75, constraint=true ];
    "vaccination_route_compartment" -> "recovered_or_immune_endpoint" [ color="#aab8c6", penwidth=0.75, constraint=true ];
  }

  subgraph cluster_G_Population {
    graph [
      label="Population structure",
      labelloc=t,
      fontsize=11.5,
      fontname="Helvetica",
      style="rounded,filled",
      fillcolor="#f9f5d9",
      color="#6b8299",
      penwidth=1.0,
      margin=14,
    ];
    "G_Population" [shape=tab, style="filled,rounded", fillcolor="#ffffff",  fontsize=10.5, label="Population structure"];
    "stratification_demographic_roles" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Stratification Demographic Roles", tooltip="Age sex risk group MSM strata demographic roles in compartments."];
    "spatial_or_patch_like_naming" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Spatial Or Patch Like Naming", tooltip="Patch metropolis multiple regions geographic spatial structuring."];
    "G_Population" -> "stratification_demographic_roles" [ penwidth=1.05 ];
    "stratification_demographic_roles" -> "spatial_or_patch_like_naming" [ color="#aab8c6", penwidth=0.75, constraint=true ];
  }

  subgraph cluster_G_NonHumanHosts {
    graph [
      label="Hosts beyond humans",
      labelloc=t,
      fontsize=11.5,
      fontname="Helvetica",
      style="rounded,filled",
      fillcolor="#fae8fb",
      color="#6b8299",
      penwidth=1.0,
      margin=14,
    ];
    "G_NonHumanHosts" [shape=tab, style="filled,rounded", fillcolor="#ffffff",  fontsize=10.5, label="Hosts beyond humans"];
    "vector_or_intermediate_species_present" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Vector Or Intermediate Species Present", tooltip="Non-human vector snail aquatic intermediate reservoir species compartments."];
    "zoonotic_or_animal_compartment" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Zoonotic Or Animal Compartment", tooltip="Zoonotic non-human vertebrate mammal bird reservoir compartments."];
    "G_NonHumanHosts" -> "vector_or_intermediate_species_present" [ penwidth=1.05 ];
    "vector_or_intermediate_species_present" -> "zoonotic_or_animal_compartment" [ color="#aab8c6", penwidth=0.75, constraint=true ];
  }

  subgraph cluster_G_Demography {
    graph [
      label="Birth / recruitment / immigration",
      labelloc=t,
      fontsize=11.5,
      fontname="Helvetica",
      style="rounded,filled",
      fillcolor="#ede8fc",
      color="#6b8299",
      penwidth=1.0,
      margin=14,
    ];
    "G_Demography" [shape=tab, style="filled,rounded", fillcolor="#ffffff",  fontsize=10.5, label="Birth / recruitment / immigration"];
    "recruitment_birth_or_immigration_named" [shape=box, style="rounded,filled", fillcolor="#ffffff",  fontsize=9.5, margin=0.1, label="Recruitment Birth Or Immigration Named", tooltip="Birth influx immigration recruitment into susceptible explicit naming."];
    "G_Demography" -> "recruitment_birth_or_immigration_named" [ penwidth=1.05 ];
  }

  "route_healthcare_general_contact" -> "G_ClinicalPath" [ style=invis, weight=999, minlen=2, constraint=true ];
  "recovered_or_immune_endpoint" -> "G_Population" [ style=invis, weight=999, minlen=2, constraint=true ];
  "spatial_or_patch_like_naming" -> "G_NonHumanHosts" [ style=invis, weight=999, minlen=2, constraint=true ];
  "zoonotic_or_animal_compartment" -> "G_Demography" [ style=invis, weight=999, minlen=2, constraint=true ];
}
