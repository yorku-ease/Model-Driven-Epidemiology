<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" name="CompartmentalModel" version="12.0.0.2017041100">
  <ownedViewpoints name="MyViewpoint">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="Diagram" initialisation="true" domainClass="compartmentalmodel.CompartmentalModel" enablePopupBars="true">
      <metamodel href="../../CompartmentalModel/compartmental.ecore#/"/>
      <layout xsi:type="description_1:CompositeLayout"/>
      <defaultLayer name="Diagram">
        <nodeMappings name="Compartment" semanticCandidatesExpression="compartments" domainClass="Compartment"/>
        <edgeMappings name="Flow" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']" targetFinderExpression="aql:self.target" sourceFinderExpression="aql:self.source" domainClass="Flow" useDomainElement="true">
          <style sizeComputationExpression="2" centeredSourceMappings="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </defaultLayer>
      <additionalLayers name="Default" activeByDefault="true">
        <nodeMappings name="CompartmentNode" semanticCandidatesExpression="aql:self.compartments" domainClass="compartmentalmodel.Compartment">
          <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="9" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName + '\n' + 'ρ=' + self.population.toString() + if self.supplyFunction &lt;&gt; null then '\n[' + self.supplyFunction.type.toString() + ']' else '' endif" labelPosition="node" resizeKind="NSEW" width="12" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
          </style>
          <conditionnalStyles predicateExpression="aql: self.PrimaryName.startsWith('A') or self.PrimaryName.startsWith('a')">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="10" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName" labelPosition="node" resizeKind="NSEW" width="12" height="6">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_gray']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.PrimaryName.startsWith('B') or self.PrimaryName.startsWith('b')">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="10" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName" labelPosition="node" resizeKind="NSEW" width="12" height="6" borderColorExpression="service:borderColorFromPrimaryName(self.PrimaryName)">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.PrimaryName.startsWith('C') or self.PrimaryName.startsWith('c')">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="10" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName" labelPosition="node" resizeKind="NSEW" width="12" height="6">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
