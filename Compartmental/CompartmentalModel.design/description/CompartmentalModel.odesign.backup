            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="10" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName" labelPosition="node" resizeKind="NSEW" width="12" height="6">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.supplyFunction &lt;&gt; null and self.supplyFunction.type.toString() = 'TRIANGULAR' and self.supplyFunction.isSourceNode">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="5" labelSize="9" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName + '\n' + 'ρ=' + self.population.toString() + '\n[' + self.supplyFunction.type.toString() + '-SRC]' + '\nΦ_max=' + self.supplyFunction.maxDemand.toString()" labelPosition="node" resizeKind="NSEW" width="12" height="7">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.supplyFunction &lt;&gt; null and self.supplyFunction.type.toString() = 'TRIANGULAR' and not self.supplyFunction.isSourceNode">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="9" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName + '\n' + 'ρ=' + self.population.toString() + '\n[' + self.supplyFunction.type.toString() + ']' + '\nρ_max=' + self.supplyFunction.maxDensity.toString() + ', Φ=' + self.supplyFunction.maxThroughput.toString()" labelPosition="node" resizeKind="NSEW" width="12" height="8">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.supplyFunction &lt;&gt; null and self.supplyFunction.type.toString() = 'TRM_MAK'">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="6" labelSize="9" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName + '\n' + 'ρ=' + self.population.toString() + '\n[TRM-MAK]' + '\nρ_max=' + self.supplyFunction.maxDensity.toString() + ', Φ=' + self.supplyFunction.maxThroughput.toString()" labelPosition="node" resizeKind="NSEW" width="12" height="8">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.supplyFunction &lt;&gt; null and self.supplyFunction.type.toString() = 'TRM_CAPACITATED'">
            <style xsi:type="style:SquareDescription" borderSizeComputationExpression="6" labelSize="9" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName + '\n' + 'ρ=' + self.population.toString() + '\n[TRM-CAPACITATED]' + '\nρ_max=' + self.supplyFunction.maxDensity.toString() + ', Φ=' + self.supplyFunction.maxThroughput.toString()" labelPosition="node" resizeKind="NSEW" width="12" height="8">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
          </conditionnalStyles>
        </nodeMappings>
        <nodeMappings name="ExternalSourceNode" semanticCandidatesExpression="aql:self.externalSources" domainClass="compartmentalmodel.ExternalSource">
          <style xsi:type="style:EllipseNodeDescription" borderSizeComputationExpression="2" labelSize="10" labelExpression="aql:self.name + '\\n' + if self.rateParameter->notEmpty() then self.rateParameter.name else self.rate.toString() endif" labelPosition="node" resizeKind="NSEW" width="8" height="8">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="ExternalSinkNode" semanticCandidatesExpression="aql:self.externalSinks" domainClass="compartmentalmodel.ExternalSink">
          <style xsi:type="style:EllipseNodeDescription" borderSizeComputationExpression="2" labelSize="10" labelExpression="aql:self.name + '\\n' + if self.rateParameter->notEmpty() then self.rateParameter.name else self.rate.toString() endif" labelPosition="node" resizeKind="NSEW" width="8" height="8">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
          <conditionnalStyles predicateExpression="aql:self.isCOVIDDeath">
            <style xsi:type="style:EllipseNodeDescription" borderSizeComputationExpression="3" labelSize="10" labelExpression="aql:self.name + '\\n' + if self.rateParameter->notEmpty() then self.rateParameter.name else self.rate.toString() endif" labelPosition="node" resizeKind="NSEW" width="8" height="8">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            </style>
          </conditionnalStyles>
        </nodeMappings>
        <edgeMappings name="FlowEdge" semanticCandidatesExpression="aql:self.compartments.outgoingFlows" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetFinderExpression="aql:self.target" sourceFinderExpression="aql:self.eContainer()" domainClass="compartmentalmodel.Flow" useDomainElement="true">
          <style sourceArrow="OutputArrow" foldingStyle="SOURCE" endsCentering="Target">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription labelSize="12" labelExpression="aql:if self.oclIsKindOf(compartmentalmodel::RateFlow) then let rf : compartmentalmodel::RateFlow = self.oclAsType(compartmentalmodel::RateFlow) in if rf.rateParameter->notEmpty() then rf.rateParameter.name else rf.rate endif else let cf : compartmentalmodel::ContactFlow = self.oclAsType(compartmentalmodel::ContactFlow) in if cf.contactRateParameter->notEmpty() then cf.contactRateParameter.name else cf.contactRate endif endif">
              <labelFormat>italic</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="ExternalSourceEdge" semanticCandidatesExpression="aql:self.externalSources" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='ExternalSourceNode']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetFinderExpression="aql:self.targetCompartment" sourceFinderExpression="aql:self" domainClass="compartmentalmodel.ExternalSource" useDomainElement="true">
          <style lineStyle="dash" sourceArrow="OutputArrow" endsCentering="Both">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
            <centerLabelStyleDescription labelSize="12" labelExpression="aql:if self.rateParameter->notEmpty() then self.rateParameter.name else self.rate endif">
              <labelFormat>italic</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="ExternalSinkEdge" semanticCandidatesExpression="aql:self.externalSinks" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='ExternalSinkNode']" targetFinderExpression="aql:self" sourceFinderExpression="aql:self.sourceCompartment" domainClass="compartmentalmodel.ExternalSink" useDomainElement="true">
          <style lineStyle="dash" sourceArrow="OutputArrow" endsCentering="Both">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
            <centerLabelStyleDescription labelSize="12" labelExpression="aql:if self.rateParameter->notEmpty() then self.rateParameter.name else self.rate endif">
              <labelFormat>italic</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </additionalLayers>
      <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
    </ownedRepresentations>
    
    <ownedJavaExtensions qualifiedClassName="CompartmentalModel.design.Services"/>
  </ownedViewpoints>
</description:Group>
