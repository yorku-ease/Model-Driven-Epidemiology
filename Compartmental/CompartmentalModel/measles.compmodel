    <parameters name="ξU" expression="0.0087" description="un-monitored child vaccination rate" unit="1/week"/> 
    <parameters name="ξM" expression="4.77e-5" description="monitored child vaccination rate" unit="1/week"/> 
    <parameters name="βC" expression="0.00188" description="child transmission rate" unit="1/week"/> 
    <parameters name="βA" expression="1.00e-5" description="adult transmission rate" unit="1/week"/> 
    <parameters name="m" expression="2.68e-4" description="natural death rate" unit="1/week"/> 
    <parameters name="γ" expression="0.5" description="recovery rate" unit="1/week"/> 
    <parameters name="φ" expression="0.00128" description="maturation rate" unit="1/week"/> 
    <parameters name="ε" expression="0.2" description="vaccine effectiveness" unit="1/week"/> 
    <parameters name="ηA" expression="0" description="adult immunization rate" unit="1/week"/> 
    <parameters name="ηU" expression="3e-6" description="un-monitored child immunization" unit="1/week"/> 
    <parameters name="ηM" expression="0.0167" description="monitored child immunization" unit="1/week"/> 
    <parameters name="δ" expression="0.7" description="incubation rate" unit="1/week"/> 
    <parameters name="d" expression="9.34e-5" description="disease death rate" unit="1/week"/> 
    <parameters name="ξA" expression="0" description="adult vaccination rate" unit="1/week"/> 
    <parameters name="α" expression="0.01253" description="contact network fraction" unit="1/week"/> 
    <parameters name="q" expression="0.15" description="case reporting fraction" unit="1/week"/> 
    <parameters name="L" expression="0.02197" description="Birth Rate" unit="1/week"/> 
 
    <parameters name="ε * βC" type="EXPRESSION" expression="ε * βC" description="" unit="1/week"/> 
    <parameters name="ε * βA" type="EXPRESSION" expression="ε * βA" description="" unit="1/week"/> 


