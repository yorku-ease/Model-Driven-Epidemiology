<?xml version="1.0" encoding="UTF-8"?>
<compartmental:CompartmentalModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:compartmental="http://example.com/compartmentalmodel">
  <parameters name="L" description="Recruitment rate to children group"/>
  <parameters name="xᵤ" description="Un-monitored children Vaccination rate"/>
  <parameters name="xₘ" description="Monitored children Vaccination rate"/>
  <parameters name="xₐ" description="Adult Vaccination rate"/>
  <parameters name="β_c" description="Transmission rate on the children"/>
  <parameters name="β_a" description="Transmission rate on the adults"/>
  <parameters name="μ" description="Natural death rate"/>
  <parameters name="γ" description="Rate of being immune after recovery from infection"/>
  <parameters name="j" description="Maturation rate from child to adult"/>
  <parameters name="ε" description="Factor for reduced susceptibility in un-monitored vaccinated group"/>
  <parameters name="ηₐ" description="Rate of being immune for vaccinated adults"/>
  <parameters name="ηᵤ" description="Rate of being immune for Un-monitored vaccinated children"/>
  <parameters name="ηₘ" description="Rate of being immune for Monitored vaccinated children"/>
  <parameters name="δ" description="Incubation rate (progression from Exposed to Infectious)"/>
  <parameters name="d" description="Disease-induced death rate"/>
  <parameters name="εβ_c" type="EXPRESSION" expression="ε * β_c" description="Effective transmission rate for un-monitored vaccinated children"/>
  <parameters name="εβ_a" type="EXPRESSION" expression="ε * β_a" description="Effective transmission rate for un-monitored vaccinated adults"/>
  <compartments PrimaryName="Susceptible" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.2" rateParameter="//@parameters.1" description="Un-monitored vaccination"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.4" rateParameter="//@parameters.2" description="Monitored vaccination"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.1" rateParameter="//@parameters.8" description="Maturation"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.4" description="Infection from infectious children"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.4" description="Infection from infectious adults"/>
  </compartments>
  <compartments PrimaryName="Susceptible" SecondaryName="Adults">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.5" rateParameter="//@parameters.3" description="Adult vaccination"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.7" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.5" description="Infection from infectious children"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.7" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.5" description="Infection from infectious adults"/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.15" description="Breakthrough infection from infectious children"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.6" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.15" description="Breakthrough infection from infectious adults"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10" rateParameter="//@parameters.11" description="Gaining immunity"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.3" rateParameter="//@parameters.8" description="Maturation"/>
  </compartments>
  <compartments PrimaryName="Un-monitored Vaccinated" SecondaryName="Adults">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11" rateParameter="//@parameters.10" description="Gaining immunity"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.7" contactCompartment="//@compartments.8" contactRateParameter="//@parameters.16" description="Breakthrough infection from infectious children"/>
    <outgoingFlows xsi:type="compartmental:ContactFlow" target="//@compartments.7" contactCompartment="//@compartments.9" contactRateParameter="//@parameters.16" description="Breakthrough infection from infectious adults"/>
  </compartments>
  <compartments PrimaryName="Monitored Vaccinated" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10" rateParameter="//@parameters.12" description="Gaining immunity"/>
  </compartments>
  <compartments PrimaryName="Vaccinated" SecondaryName="Adults">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11" rateParameter="//@parameters.10" description="Gaining immunity"/>
  </compartments>
  <compartments PrimaryName="Exposed" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.8" rateParameter="//@parameters.13" description="Progression to infectious"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.7" rateParameter="//@parameters.8" description="Maturation"/>
  </compartments>
  <compartments PrimaryName="Exposed" SecondaryName="Adults">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.9" rateParameter="//@parameters.13" description="Progression to infectious"/>
  </compartments>
  <compartments PrimaryName="Infectious" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.10" rateParameter="//@parameters.7" description="Recovery"/>
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.9" rateParameter="//@parameters.8" description="Maturation"/>
  </compartments>
  <compartments PrimaryName="Infectious" SecondaryName="Adults">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11" rateParameter="//@parameters.7" description="Recovery"/>
  </compartments>
  <compartments PrimaryName="Immune" SecondaryName="Children">
    <outgoingFlows xsi:type="compartmental:RateFlow" target="//@compartments.11" rateParameter="//@parameters.8" description="Maturation"/>
  </compartments>
  <compartments PrimaryName="Immune" SecondaryName="Adults"/>
  <birthSources name="Child_Births" rateParameter="//@parameters.0" targetCompartment="//@compartments.0"/>
  <deathSinks name="Natural_Death_SC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.0"/>
  <deathSinks name="Natural_Death_SA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.1"/>
  <deathSinks name="Natural_Death_UVC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.2"/>
  <deathSinks name="Natural_Death_UVA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.3"/>
  <deathSinks name="Natural_Death_MVC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.4"/>
  <deathSinks name="Natural_Death_VA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.5"/>
  <deathSinks name="Natural_Death_EC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.6"/>
  <deathSinks name="Natural_Death_EA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.7"/>
  <deathSinks name="Natural_Death_IC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.8"/>
  <deathSinks name="Natural_Death_IA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.9"/>
  <deathSinks name="Natural_Death_ImC" rateParameter="//@parameters.6" sourceCompartment="//@compartments.10"/>
  <deathSinks name="Natural_Death_ImA" rateParameter="//@parameters.6" sourceCompartment="//@compartments.11"/>
  <deathSinks name="Disease_Death_IC" rateParameter="//@parameters.14" sourceCompartment="//@compartments.8"/>
  <deathSinks name="Disease_Death_IA" rateParameter="//@parameters.14" sourceCompartment="//@compartments.9"/>
</compartmental:CompartmentalModel>