# List the source directories
source.. = src/

# Specify the output directory for compiled classes
output.. = bin/

# List the resources to include in the build:
# - META-INF/ (contains MANIFEST.MF)
# - seir.ecore (the Ecore model file)
# - model/ (any additional model files)
# - . (the root directory, if needed)
bin.includes = META-INF/,\
               seir.ecore,\
               model/,\
               .