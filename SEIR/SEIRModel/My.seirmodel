<?xml version="1.0" encoding="UTF-8"?>
<seir:SEIRModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:seir="http://example.com/seirmodel">
  <compartments xsi:type="seir:Susceptible" name="S" population="1000">
    <outgoingFlows rate="0.002" target="//@compartments.2"/>
    <outgoingFlows rate="0.001" target="//@compartments.1"/>
  </compartments>
  <compartments xsi:type="seir:ExposedNonIsolated" name="E_N" population="10">
    <outgoingFlows rate="0.4" target="//@compartments.3"/>
    <outgoingFlows rate="0.6" target="//@compartments.4"/>
  </compartments>
  <compartments xsi:type="seir:ExposedIsolated" name="E_I" population="5">
    <outgoingFlows rate="0.5" target="//@compartments.3"/>
    <outgoingFlows target="//@compartments.4"/>
  </compartments>
  <compartments xsi:type="seir:InfectiousSymptomatic" name="I_S" population="2">
    <outgoingFlows rate="0.2" target="//@compartments.5"/>
  </compartments>
  <compartments xsi:type="seir:InfectiousAsymptomatic" name="I_A" population="3">
    <outgoingFlows rate="0.25"/>
  </compartments>
  <compartments xsi:type="seir:Recovered" name="R"/>
</seir:SEIRModel>
