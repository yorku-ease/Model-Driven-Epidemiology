<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="seirmodel" nsURI="http://example.com/seirmodel" nsPrefix="seir">
  <eClassifiers xsi:type="ecore:EClass" name="Compartment" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" ordered="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="population" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="outgoingFlows" upperBound="-1"
        eType="#//Flow" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Flow">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="#//Compartment"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Susceptible" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Treated" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="SEIRModel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="compartments" upperBound="-1"
        eType="#//Compartment" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AIDS" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Hospitalized" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Deaths" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="UntreatedInfectious" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Vaccinated" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="NoAccess" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="IsolatedAfterTestingPositive" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Exposed" eSuperTypes="#//Compartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="PostAcute" eSuperTypes="#//Compartment"/>
</ecore:EPackage>
