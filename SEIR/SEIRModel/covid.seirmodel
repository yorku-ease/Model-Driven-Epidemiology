<?xml version="1.0" encoding="UTF-8"?>
<seir:SEIRModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:seir="http://example.com/seirmodel" totalPopulation="14800000" globalBirthRate="0" globalDeathRate="0">
  
  <!-- Age Groups based on COVID-19 epidemiological patterns -->
  <groups name="AgeGroup" description="Age-based population stratification with realistic COVID-19 characteristics">
    <values>0-17</values>     <!-- Children/Adolescents: Lower susceptibility, milder symptoms -->
    <values>18-64</values>    <!-- Adults: Standard susceptibility, moderate severity -->  
    <values>65+</values>      <!-- Elderly: Higher susceptibility, severe outcomes -->
  </groups>
  
  <!-- Age-based Product for Stratification -->
  <products name="AgeStratification" description="Age-based compartment stratification" groups="//@groups.0"/>
  
  <!-- Susceptible Population (Age-Stratified with realistic contact patterns) -->
  <compartments PrimaryName="Susceptible" population="14700000" product="//@products.0">
    <!-- Exposure flows with age-specific contact rates and susceptibility -->
    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.00001" 
                   contactCompartment="//@compartments.3" 
                   description="Exposure (community transmission)" 
                   target="//@compartments.1">
      <!-- Children: Lower contact rate, reduced susceptibility -->
      <stratumSpecificRates stratum="0-17" rate="0.000006" multiplier="0.7"/>
      <!-- Adults: Higher contact rate, standard susceptibility -->  
      <stratumSpecificRates stratum="18-64" rate="0.000015" multiplier="1.0"/>
      <!-- Elderly: Moderate contact rate, higher susceptibility -->
      <stratumSpecificRates stratum="65+" rate="0.000008" multiplier="1.3"/>
    </outgoingFlows>
    
    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.000002" 
                   contactCompartment="//@compartments.3" 
                   description="Exposure with quarantine measures" 
                   target="//@compartments.2">
      <!-- Age-specific quarantine exposure rates -->
      <stratumSpecificRates stratum="0-17" rate="0.000001" multiplier="0.7"/>
      <stratumSpecificRates stratum="18-64" rate="0.000003" multiplier="1.0"/>
      <stratumSpecificRates stratum="65+" rate="0.0000015" multiplier="1.3"/>
    </outgoingFlows>
  </compartments>
  
  <!-- Exposed (Incubating, not quarantined) with age-specific progression -->
  <compartments PrimaryName="Exposed" population="5000" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.4" 
                   description="Progression to presymptomatic infectious" 
                   target="//@compartments.3">
      <!-- Age-specific progression rates based on immune response -->
      <stratumSpecificRates stratum="0-17" rate="0.5"/>    <!-- Faster progression (stronger immune response) -->
      <stratumSpecificRates stratum="18-64" rate="0.4"/>   <!-- Standard progression -->
      <stratumSpecificRates stratum="65+" rate="0.3"/>     <!-- Slower progression (weakened immune response) -->
    </outgoingFlows>
  </compartments>
  
  <!-- Exposed (Quarantined) with age-specific progression -->
  <compartments PrimaryName="Exposed" SecondaryName="quarantined" population="1000" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.4" 
                   description="Progression to presymptomatic isolated" 
                   target="//@compartments.4">
      <!-- Same age-specific progression rates -->
      <stratumSpecificRates stratum="0-17" rate="0.5"/>
      <stratumSpecificRates stratum="18-64" rate="0.4"/>
      <stratumSpecificRates stratum="65+" rate="0.3"/>
    </outgoingFlows>
  </compartments>
  
  <!-- Infectious (Presymptomatic) with age-specific severity -->
  <compartments PrimaryName="Infectious" SecondaryName="presymptomatic" population="3000" product="//@products.0">
    <!-- Age-specific severity rates -->
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.85" 
                   description="Mild to moderate symptoms" 
                   target="//@compartments.5">
      <!-- Children: Very high rate of mild symptoms -->
      <stratumSpecificRates stratum="0-17" rate="0.95"/>
      <!-- Adults: Standard rate -->
      <stratumSpecificRates stratum="18-64" rate="0.85"/>
      <!-- Elderly: Lower rate of mild symptoms -->
      <stratumSpecificRates stratum="65+" rate="0.65"/>
    </outgoingFlows>
    
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.15" 
                   description="Severe symptoms" 
                   target="//@compartments.6">
      <!-- Children: Very low severe rate -->
      <stratumSpecificRates stratum="0-17" rate="0.05"/>
      <!-- Adults: Standard severe rate -->
      <stratumSpecificRates stratum="18-64" rate="0.15"/>
      <!-- Elderly: Much higher severe rate -->
      <stratumSpecificRates stratum="65+" rate="0.35"/>
    </outgoingFlows>
  </compartments>
  
  <!-- Infectious (Presymptomatic, Isolated) -->
  <compartments PrimaryName="Infectious" SecondaryName="presymptomatic, isolated" population="1000" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.85" 
                   description="Mild to moderate isolated" 
                   target="//@compartments.7">
      <stratumSpecificRates stratum="0-17" rate="0.95"/>
      <stratumSpecificRates stratum="18-64" rate="0.85"/>
      <stratumSpecificRates stratum="65+" rate="0.65"/>
    </outgoingFlows>
    
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.15" 
                   description="Severe isolated" 
                   target="//@compartments.8">
      <stratumSpecificRates stratum="0-17" rate="0.05"/>
      <stratumSpecificRates stratum="18-64" rate="0.15"/>
      <stratumSpecificRates stratum="65+" rate="0.35"/>
    </outgoingFlows>
  </compartments>
  
  <!-- Infectious (Mild to Moderate) -->
  <compartments PrimaryName="Infectious" SecondaryName="mild to moderate" population="8000">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.5" description="Detection and isolation" target="//@compartments.9"/>
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.167" description="Recovery" target="//@compartments.10"/>
  </compartments>
  
  <!-- Infectious (Severe) -->
  <compartments PrimaryName="Infectious" SecondaryName="severe" population="2000">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.167" description="Hospital admission" target="//@compartments.11"/>
  </compartments>
  
  <!-- Infectious (Mild to Moderate, Isolated) -->
  <compartments PrimaryName="Infectious" SecondaryName="mild to moderate, isolated" population="4000">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.167" description="Recovery" target="//@compartments.10"/>
  </compartments>
  
  <!-- Infectious (Severe, Isolated) -->
  <compartments PrimaryName="Infectious" SecondaryName="severe, isolated" population="800">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.167" description="Hospital admission" target="//@compartments.11"/>
  </compartments>
  
  <!-- Isolated (Detected cases) -->
  <compartments PrimaryName="Isolated" population="6000">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.167" description="Recovery" target="//@compartments.10"/>
  </compartments>
  
  <!-- Recovered (Age-Stratified) -->
  <compartments PrimaryName="Recovered" population="50000" product="//@products.0"/>
  
  <!-- Admitted to Hospital with age-specific outcomes -->
  <compartments PrimaryName="Admitted to hospital" population="1500" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.74" 
                   description="Recovery from hospital" 
                   target="//@compartments.10">
      <!-- Age-specific hospital recovery rates -->
      <stratumSpecificRates stratum="0-17" rate="0.90"/>   <!-- Children recover faster -->
      <stratumSpecificRates stratum="18-64" rate="0.80"/>  <!-- Standard recovery -->
      <stratumSpecificRates stratum="65+" rate="0.60"/>    <!-- Slower elderly recovery -->
    </outgoingFlows>
    
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.26" 
                   description="ICU admission" 
                   target="//@compartments.12">
      <!-- Age-specific ICU admission rates -->
      <stratumSpecificRates stratum="0-17" rate="0.10"/>   <!-- Very low ICU rate for children -->
      <stratumSpecificRates stratum="18-64" rate="0.20"/>  <!-- Moderate ICU rate -->
      <stratumSpecificRates stratum="65+" rate="0.40"/>    <!-- High ICU rate for elderly -->
    </outgoingFlows>
  </compartments>
  
  <!-- ICU with age-specific mortality -->
  <compartments PrimaryName="ICU" population="400" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.6" 
                   description="Recovery to post-ICU" 
                   target="//@compartments.13">
      <!-- Age-specific ICU recovery rates -->
      <stratumSpecificRates stratum="0-17" rate="0.85"/>   <!-- High recovery rate for children -->
      <stratumSpecificRates stratum="18-64" rate="0.70"/>  <!-- Standard recovery -->
      <stratumSpecificRates stratum="65+" rate="0.45"/>    <!-- Lower recovery for elderly -->
    </outgoingFlows>
    
    <outgoingFlows xsi:type="seir:RateFlow" 
                   rate="0.4" 
                   description="Death from COVID" 
                   target="//@compartments.14">
      <!-- Age-specific mortality rates -->
      <stratumSpecificRates stratum="0-17" rate="0.15"/>   <!-- Very low mortality for children -->
      <stratumSpecificRates stratum="18-64" rate="0.30"/>  <!-- Moderate mortality -->
      <stratumSpecificRates stratum="65+" rate="0.55"/>    <!-- High mortality for elderly -->
    </outgoingFlows>
  </compartments>
  
  <!-- Admitted to Hospital (Post-ICU) -->
  <compartments PrimaryName="Admitted to hospital" SecondaryName="post-ICU" population="200">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.048" description="Recovery post-ICU" target="//@compartments.10"/>
  </compartments>
  
  <!-- COVID Deaths (Age-Stratified) -->
  <compartments PrimaryName="COVID Deaths" population="100" product="//@products.0"/>
  
  <!-- Birth Sources with age-specific targeting -->
  <birthSources name="Population Birth" rate="3.0E-5" targetCompartment="//@compartments.0"/>
  
  <!-- Age-specific Natural Death Rates (realistic mortality by age) -->
  <deathSinks name="Child Natural Death" rate="0.0000005" sourceCompartment="//@compartments.0"/>
  <deathSinks name="Adult Natural Death" rate="0.00002" sourceCompartment="//@compartments.0"/>
  <deathSinks name="Elder Natural Death" rate="0.0002" sourceCompartment="//@compartments.0"/>
  
</seir:SEIRModel>