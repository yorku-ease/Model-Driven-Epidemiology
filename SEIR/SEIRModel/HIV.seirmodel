<?xml version="1.0" encoding="UTF-8"?>
<seir:SEIRModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:seir="http://example.com/seirmodel" totalPopulation="362796" globalBirthRate="0" globalDeathRate="0">
  
  <groups name="SexualPreference" description="Population stratification based on sexual preference and gender">
    <values>HomosexualMen</values>
    <values>Women</values>
    <values>HeterosexualMen</values>
  </groups>
  
  <products name="GenderStratification" description="Stratification by sexual preference/gender" groups="//@groups.0"/>
  
  <birthSources name="Recruitment Homosexual Men" rate="12.7872" targetCompartment="//@compartments.0" targetStratum="HomosexualMen" fixedRate="true"/>
  <birthSources name="Recruitment Women" rate="173.16" targetCompartment="//@compartments.0" targetStratum="Women" fixedRate="true"/>
  <birthSources name="Recruitment Heterosexual Men" rate="147.0528" targetCompartment="//@compartments.0" targetStratum="HeterosexualMen" fixedRate="true"/>
  
  <compartments PrimaryName="Susceptible" population="362544" product="//@products.0">
    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="3.08" 
                   contactCompartment="//@compartments.1" 
                   description="Exclusive Homosexual Contact (λh)" 
                   target="//@compartments.1">
      <stratumSpecificRates stratum="HomosexualMen" rate="3.08"/>
    </outgoingFlows>

    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.036" 
                   contactCompartment="//@compartments.1" 
                   description="Bisexual Contact (λhw)" 
                   target="//@compartments.1">
      <stratumSpecificRates stratum="Women" rate="0.036"/>
    </outgoingFlows>

    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.25" 
                   contactCompartment="//@compartments.1" 
                   description="Bisexual Contact (λhm)" 
                   target="//@compartments.1">
      <stratumSpecificRates stratum="HeterosexualMen" rate="0.25"/>
    </outgoingFlows>

    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.08" 
                   contactCompartment="//@compartments.1" 
                   description="Heterosexual Contact (λw-m)" 
                   target="//@compartments.1">
      <stratumSpecificRates stratum="HeterosexualMen" rate="0.08"/>
    </outgoingFlows>

    <outgoingFlows xsi:type="seir:ContactFlow" 
                   contactRate="0.08" 
                   contactCompartment="//@compartments.1" 
                   description="Heterosexual Contact (λm-w)" 
                   target="//@compartments.1">
      <stratumSpecificRates stratum="Women" rate="0.08"/>
    </outgoingFlows>
  </compartments>
  
  <compartments PrimaryName="Untreated Infected" population="114" product="//@products.0">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.29997" description="p * α (Transition to ART)" target="//@compartments.2"/>

    <outgoingFlows xsi:type="seir:RateFlow" rate="0.03333" description="(1-p) * α (Transition to AIDS)" target="//@compartments.3"/>
  </compartments>
  
  <compartments PrimaryName="Treated with ART" population="107">
    <outgoingFlows xsi:type="seir:RateFlow" rate="0.018" description="δ (Treatment Failure)" target="//@compartments.3"/>
  </compartments>
  
  <compartments PrimaryName="People living with AIDS" population="47"/>
  
  <deathSinks name="Death Due to AIDS" rate="0.3333" sourceCompartment="//@compartments.3"/>
  
  <deathSinks name="Natural Death" rate="0.0129" sourceCompartment="//@compartments.0"/>
  <deathSinks name="Natural Death" rate="0.0129" sourceCompartment="//@compartments.1"/>
  <deathSinks name="Natural Death" rate="0.0129" sourceCompartment="//@compartments.2"/>
  <deathSinks name="Natural Death" rate="0.0129" sourceCompartment="//@compartments.3"/>
</seir:SEIRModel>