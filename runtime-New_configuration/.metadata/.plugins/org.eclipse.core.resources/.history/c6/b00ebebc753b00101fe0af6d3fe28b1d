<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" name="SEIRModel" version="12.0.0.2017041100">
  <ownedViewpoints name="MyViewpoint">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="Diagram" initialisation="true" domainClass="seirmodel.SEIRModel" enablePopupBars="true">
      <metamodel href="../../SEIRModel/seir.ecore#/"/>
      <layout xsi:type="description_1:CompositeLayout"/>
      <defaultLayer name="Diagram">
        <nodeMappings name="Compartment" semanticCandidatesExpression="compartments" domainClass="Compartment"/>
        <edgeMappings name="Flow" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']" targetFinderExpression="aql:self.target" sourceFinderExpression="aql:self.source" domainClass="Flow" useDomainElement="true">
          <style sizeComputationExpression="2" centeredSourceMappings="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@defaultLayer/@nodeMappings[name='Compartment']">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </defaultLayer>
      <additionalLayers name="Default" activeByDefault="true">
        <nodeMappings name="CompartmentNode" semanticCandidatesExpression="aql:self.compartments" domainClass="seirmodel.Compartment">
          <style xsi:type="style:SquareDescription" borderSizeComputationExpression="4" labelSize="10" labelExpression="aql:self.PrimaryName + ' ' + self.SecondaryName" labelPosition="node" resizeKind="NSEW" width="12" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="FlowEdge" semanticCandidatesExpression="aql:self.compartments.outgoingFlows" sourceMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetMapping="//@ownedViewpoints[name='MyViewpoint']/@ownedRepresentations[name='Diagram']/@additionalLayers[name='Default']/@nodeMappings[name='CompartmentNode']" targetFinderExpression="aql:self.target" sourceFinderExpression="aql:self.eContainer()" domainClass="seirmodel.Flow" useDomainElement="true">
          <style sourceArrow="OutputArrow" foldingStyle="SOURCE" endsCentering="Target">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription labelSize="12" labelExpression="aql:self.rate">
              <labelFormat>italic</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </additionalLayers>
      <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="SEIRModel.design.Services"/>
  </ownedViewpoints>
</description:Group>
