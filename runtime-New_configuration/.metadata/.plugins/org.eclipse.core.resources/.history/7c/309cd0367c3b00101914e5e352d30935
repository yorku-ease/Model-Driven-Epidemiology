    public String randomColorFromPrimaryName(String key) {
        int hash = Math.abs(key.hashCode());
        int r = (hash & 0xFF0000) >> 16;
        int g = (hash & 0x00FF00) >> 8;
        int b = (hash & 0x0000FF);
        // Brighten background
        r = (r + 255) / 2;
        g = (g + 255) / 2;
        b = (b + 255) / 2;
        return "rgb(" + r + "," + g + "," + b + ")";
    }

    public String borderColorFromPrimaryName(String key) {
        int hash = Math.abs(key.hashCode());
        int r = (hash & 0xFF0000) >> 16;
        int g = (hash & 0x00FF00) >> 8;
        int b = (hash & 0x0000FF);
        // Darker shade for border
        r = (int)(r * 0.6);
        g = (int)(g * 0.6);
        b = (int)(b * 0.6);
        return "rgb(" + r + "," + g + "," + b + ")";
    }

